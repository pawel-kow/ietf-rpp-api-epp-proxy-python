{
  "markers": [
    "smoke"
  ],
  "test_id": "test8-the_request_and_the_response_preset_differ",
  "description": "The request is read under the preset of its Content-Type (base) and answered under the preset its Accept prefers (the one of the server), both offered (core 14.3).",
  "when": {
    "env.preset_signalling": "media-type"
  },
  "comment": "Skipped on epp-docker: the EPP config signals the preset by the RPP-Preset header; preset_signalling_header/ covers the header method.",
  "setup": [
    {
      "comment": "Creates contact PB8 with authInfo, with Content-Type application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\", Accept application/rpp+json; preset=\"de.denic.rpp.preset.rri\"; preset-version=\"1.0\", application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"; q=0.5 (the request differs by backend); expects 201 01000. The contact the steps below name. Only where the default preset is rri (rri-mtest).",
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"de.denic.rpp.preset.rri\"; preset-version=\"1.0\", application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"; q=0.5",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\""
        },
        "body_json": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "contact",
                "id": "{handle:a:PB8}",
                "contactInfo": {
                  "@type": "Card",
                  "version": "2.0",
                  "kind": "individual",
                  "name": {
                    "full": "Erika Mustermann"
                  },
                  "addresses": {
                    "addr": {
                      "components": [
                        {
                          "kind": "name",
                          "value": "Musterweg 12"
                        },
                        {
                          "kind": "locality",
                          "value": "Frankfurt am Main"
                        },
                        {
                          "kind": "postcode",
                          "value": "60596"
                        }
                      ],
                      "countryCode": "DE"
                    }
                  },
                  "emails": {
                    "email": {
                      "address": "erika@example.com"
                    }
                  },
                  "phones": {
                    "voice": {
                      "number": "tel:+49.6912345678",
                      "features": {
                        "voice": true
                      }
                    }
                  }
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            },
            {
              "then": {
                "@type": "contact",
                "id": "{handle:a:PB8}",
                "contactInfo": {
                  "@type": "Card",
                  "version": "2.0",
                  "kind": "individual",
                  "name": {
                    "full": "Erika Mustermann"
                  },
                  "addresses": {
                    "addr": {
                      "components": [
                        {
                          "kind": "name",
                          "value": "Musterweg 12"
                        },
                        {
                          "kind": "locality",
                          "value": "Frankfurt am Main"
                        },
                        {
                          "kind": "postcode",
                          "value": "60596"
                        }
                      ],
                      "countryCode": "DE"
                    }
                  },
                  "emails": {
                    "email": {
                      "address": "erika@example.com"
                    }
                  },
                  "phones": {
                    "voice": {
                      "number": "tel:+49.6912345678",
                      "features": {
                        "voice": true
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Preset": null,
          "Vary": "Accept",
          "Content-Type": "application/rpp+json; preset=\"de.denic.rpp.preset.rri\"; preset-version=\"1.0\""
        },
        "body": {
          "@type": "contact",
          "id": "{handle:a:PB8}"
        }
      },
      "when": {
        "profile.default_preset": "rri"
      }
    }
  ],
