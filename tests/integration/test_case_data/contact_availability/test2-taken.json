        },
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/contacts/FO-{random_id_10}-02/availability",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
