{
  "when": {"profile.contact_phone_required": false},
  "test_id": "test6-repeated_cltrid",
  "steps": [
    {
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:-a6}/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "repcontact-{random_id_10}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "contactAvailability",
          "available": true
        },
        "content_type": "application/rpp+json"
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:-a6}/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "repcontact-{random_id_10}"
        }
      },
      "response": {
        "status": 500,
        "headers": {
          "RPP-Code": "02400"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
