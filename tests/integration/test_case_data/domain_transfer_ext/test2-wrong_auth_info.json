{
  "test_id": "test2-wrong_auth_info",
  "description": "An AuthInfo that does not match is refused, and the domain stays where it was.",
  "setup": [
    {
      "comment": "Creates request contact RG09 with uriTemplate; expects 201 01000. The General Request contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RG09}"
      }
    },
    {
      "comment": "Creates request contact RA09 with uriTemplate; expects 201 01000. The Abuse contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RA09}"
      }
    },
    {
      "comment": "Creates request contact RG09 of registrar b with uriTemplate as registrar b; expects 201 01000. The General Request contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:RG09}"
      }
    },
    {
      "comment": "Creates request contact RA09 of registrar b with uriTemplate as registrar b; expects 201 01000. The Abuse contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:RA09}"
      }
    },
    {
      "comment": "Creates contact XT2; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:XT2}"
      }
    },
    {
      "comment": "Creates domain x2 with registrant XT2, generalRequest, abuse, dns records a, authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "x2-{random_name}.{tld}",
        "abuse": {
          "@type": "requestContact",
          "id": "{handle:a:RA09}"
        },
        "generalRequest": {
          "@type": "requestContact",
          "id": "{handle:a:RG09}"
        },
        "registrant_id": "{handle:a:XT2}"
      }
    },
    {
      "comment": "Creates contact XT2 of registrar b as registrar b; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:XT2}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of domain x2 with registrant, generalRequest, abuse, dns as registrar b; expects 401 02202. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/x2-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=WHl6MjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "registrant": {
            "@type": "contact",
            "id": "{handle:b:XT2}"
          },
          "generalRequest": {
            "@type": "requestContact",
            "id": "{handle:b:RG09}"
          },
          "abuse": {
            "@type": "requestContact",
            "id": "{handle:b:RA09}"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 401,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02202"
        }
      }
    },
    {
      "comment": "Reads domain x2; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/x2-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "provMetadata": {
            "spClientId": "{regacc:a}"
          }
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain x2; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "x2-{random_name}.{tld}"
      }
    }
  ]
}
