{
  "test_id": "test6-foreign_contacts",
  "description": "The contacts must belong to the gainer: the loser's holder is refused (63200020603).",
  "setup": [
    {
      "comment": "Creates request contact RG13 with uriTemplate; expects 201 01000. The General Request contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RG13}"
      }
    },
    {
      "comment": "Creates request contact RA13 with uriTemplate; expects 201 01000. The Abuse contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RA13}"
      }
    },
    {
      "comment": "Creates request contact RG13 of registrar b with uriTemplate as registrar b; expects 201 01000. The General Request contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:RG13}"
      }
    },
    {
      "comment": "Creates request contact RA13 of registrar b with uriTemplate as registrar b; expects 201 01000. The Abuse contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:RA13}"
      }
    },
    {
      "comment": "Creates contact XT6; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:XT6}"
      }
    },
    {
      "comment": "Creates domain x6 with registrant XT6, generalRequest, abuse, dns records a, authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "x6-{random_name}.{tld}",
        "abuse": {
          "@type": "requestContact",
          "id": "{handle:a:RA13}"
        },
        "generalRequest": {
          "@type": "requestContact",
          "id": "{handle:a:RG13}"
        },
        "registrant_id": "{handle:a:XT6}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of domain x6 with registrant, generalRequest, abuse, dns as registrar b; expects 403 02201. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/x6-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=QWJjMjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:XT6}"
          },
          "generalRequest": {
            "@type": "requestContact",
            "id": "{handle:b:RG13}"
          },
          "abuse": {
            "@type": "requestContact",
            "id": "{handle:b:RA13}"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 403,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02201"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain x6; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "x6-{random_name}.{tld}"
      }
    }
  ]
}
