{
  "test_id": "test5-own_domain",
  "description": "The sponsor cannot transfer its own domain (63380063209).",
  "setup": [
    {
      "comment": "Creates request contact RG12 with uriTemplate; expects 201 01000. The General Request contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RG12}"
      }
    },
    {
      "comment": "Creates request contact RA12 with uriTemplate; expects 201 01000. The Abuse contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RA12}"
      }
    },
    {
      "comment": "Creates contact XT5; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:XT5}"
      }
    },
    {
      "comment": "Creates domain x5 with registrant XT5, generalRequest, abuse, dns records a, authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "x5-{random_name}.{tld}",
        "abuse": {
          "@type": "requestContact",
          "id": "{handle:a:RA12}"
        },
        "generalRequest": {
          "@type": "requestContact",
          "id": "{handle:a:RG12}"
        },
        "registrant_id": "{handle:a:XT5}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of domain x5 with registrant, generalRequest, abuse, dns; expects 409 02002. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/x5-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=QWJjMjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:XT5}"
          },
          "generalRequest": {
            "@type": "requestContact",
            "id": "{handle:a:RG12}"
          },
          "abuse": {
            "@type": "requestContact",
            "id": "{handle:a:RA12}"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02002"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain x5; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "x5-{random_name}.{tld}"
      }
    }
  ]
}
