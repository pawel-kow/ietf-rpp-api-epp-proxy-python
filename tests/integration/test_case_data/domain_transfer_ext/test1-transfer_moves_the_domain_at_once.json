{
  "markers": [
    "smoke"
  ],
  "test_id": "test1-transfer_moves_the_domain_at_once",
  "description": "The gainer states its holder, REQUEST contacts and DNS data with the AuthInfo: the domain is its own at once, with no process to query (.spec/spec-rri-extension.md).",
  "exclusive": [
    "message_queue"
  ],
  "setup": [
    {
      "comment": "Creates request contact RG08 with uriTemplate; expects 201 01000. The General Request contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RG08}"
      }
    },
    {
      "comment": "Creates request contact RA08 with uriTemplate; expects 201 01000. The Abuse contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RA08}"
      }
    },
    {
      "comment": "Creates request contact RG08 of registrar b with uriTemplate as registrar b; expects 201 01000. The General Request contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:RG08}"
      }
    },
    {
      "comment": "Creates request contact RA08 of registrar b with uriTemplate as registrar b; expects 201 01000. The Abuse contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:RA08}"
      }
    },
    {
      "comment": "Creates contact XT1; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:XT1}"
      }
    },
    {
      "comment": "Creates domain x1 with registrant XT1, generalRequest, abuse, dns records a, authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "x1-{random_name}.{tld}",
        "abuse": {
          "@type": "requestContact",
          "id": "{handle:a:RA08}"
        },
        "generalRequest": {
          "@type": "requestContact",
          "id": "{handle:a:RG08}"
        },
        "registrant_id": "{handle:a:XT1}"
      }
    },
    {
      "comment": "Creates contact XT1 of registrar b as registrar b; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:XT1}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of domain x1 with transferDir, registrant, generalRequest, abuse, dns as registrar b; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/x1-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=QWJjMjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "pull",
          "registrant": {
            "@type": "contact",
            "id": "{handle:b:XT1}"
          },
          "generalRequest": {
            "@type": "requestContact",
            "id": "{handle:b:RG08}"
          },
          "abuse": {
            "@type": "requestContact",
            "id": "{handle:b:RA08}"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "domainTransferProcess",
          "transferDir": "pull",
          "trStatus": "serverApproved",
          "reqClientId": "{regacc:b}",
          "actClientId": "{regacc:b}"
        },
        "fields": {
          "requestDate": {
            "type": "not_null"
          },
          "actionDate": {
            "type": "not_null"
          }
        }
      }
    },
    {
      "comment": "Reads domain x1 as registrar b; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/x1-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "domainName",
          "name": "x1-{random_name}.{tld}",
          "registrant": {
            "id": "{handle:b:XT1}"
          },
          "provMetadata": {
            "spClientId": "{regacc:b}"
          }
        }
      }
    },
    {
      "comment": "Queries the transfer of domain x1 as registrar b; expects 501 02101. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/domainNames/x1-{random_name}.{tld}/processes/transferProcesses/latest",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02101"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain x1 as registrar b; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "x1-{random_name}.{tld}",
        "registrar": "b"
      }
    }
  ]
}
