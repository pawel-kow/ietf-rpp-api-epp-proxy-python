{
  "description": "A request contact is the RegAcc's own: another one cannot read or change it.",
  "setup": [
    {
      "comment": "Creates request contact RQ7 with uriTemplate; expects 201 01000. The request contact the steps below work on.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RQ7}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces request contact RQ7 by a full update with uriTemplate as registrar b; expects 403 02201. The error answer this case checks.",
      "request": {
        "method": "PUT",
        "url": "/requestContacts/{handle:a:RQ7}",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "requestContact",
          "uriTemplate": "mailto:abuse@example.com"
        }
      },
      "response": {
        "status": 403,
        "headers": {
          "RPP-Code": "02201"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
