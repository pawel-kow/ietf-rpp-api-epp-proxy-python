{
  "description": "RRI cannot delete a contact: the registry deletes unused ones itself.",
  "setup": [
    {
      "comment": "Creates request contact RQ3 with uriTemplate; expects 201 01000. The request contact the steps below work on.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RQ3}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes request contact RQ3; expects 501 02101. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/requestContacts/{handle:a:RQ3}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02101"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
