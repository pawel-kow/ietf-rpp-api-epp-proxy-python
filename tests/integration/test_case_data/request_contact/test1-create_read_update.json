{
  "markers": [
    "smoke"
  ],
  "description": "A request contact is created, read, replaced with PUT and changed with PATCH (docs/rri/rri-extension.md).",
  "setup": [
    {
      "comment": "Creates request contact RQ1 with uriTemplate; expects 201 01000. The request contact the steps below work on.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RQ1}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Reads request contact RQ1; expects 200. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/requestContacts/{handle:a:RQ1}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "requestContact",
          "id": "{handle:a:RQ1}",
          "uriTemplate": "https://example.com/contact?domain={Alabel}",
          "provMetadata": {
            "spClientId": "{regacc:a}"
          }
        }
      }
    },
    {
      "comment": "Replaces request contact RQ1 by a full update with uriTemplate; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/requestContacts/{handle:a:RQ1}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "requestContact",
          "uriTemplate": "mailto:abuse@example.com"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "id": "{handle:a:RQ1}",
          "uriTemplate": "mailto:abuse@example.com"
        }
      }
    },
    {
      "comment": "Patches request contact RQ1: replace /uriTemplate; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/requestContacts/{handle:a:RQ1}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/uriTemplate",
            "value": "https://example.com/abuse/{Ulabel}"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "id": "{handle:a:RQ1}",
          "uriTemplate": "https://example.com/abuse/{Ulabel}"
        }
      }
    },
    {
      "comment": "Checks whether request contact RQ1 is available; expects 404. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/requestContacts/{handle:a:RQ1}/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "body": {
          "@type": "requestContactAvailability",
          "available": false
        }
      }
    }
  ]
}
