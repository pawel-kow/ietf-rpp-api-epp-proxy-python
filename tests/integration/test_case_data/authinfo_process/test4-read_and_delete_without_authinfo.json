{
  "test_id": "test4-read_and_delete_without_authinfo",
  "description": "A domain without authorisation information has no such process.",
  "setup": [
    {
      "comment": "Creates contact AI4; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:AI4}"
      }
    },
    {
      "comment": "Creates domain ai4 with registrant AI4, dns records a and no authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ai4-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:AI4}"
        },
        "authInfo": {
          "select": [
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Reads authInfoProcess of domain ai4; expects 404 02303. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/domainNames/ai4-{random_name}.{tld}/processes/authInfoProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02303"
        }
      }
    },
    {
      "comment": "Deletes authInfoProcess of domain ai4; expects 404 02303. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/ai4-{random_name}.{tld}/processes/authInfoProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02303"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain ai4; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "ai4-{random_name}.{tld}"
      }
    }
  ]
}
