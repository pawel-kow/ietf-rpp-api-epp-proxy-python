{
  "test_id": "test5-only_the_sponsor_sets_reads_and_removes",
  "description": "A client that does not sponsor the domain can neither set, read nor remove its authorisation information.",
  "setup": [
    {
      "comment": "Creates contact AI5; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:AI5}"
      }
    },
    {
      "comment": "Creates domain ai5 with registrant AI5, dns records a and no authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ai5-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:AI5}"
        },
        "authInfo": {
          "select": [
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates authInfoProcess of domain ai5 with authInfo as registrar b; expects 403 02201. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ai5-{random_name}.{tld}/processes/authInfoProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "authInfoProcess",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc23456"
          },
          "expiryDate": "{date:+1d}"
        }
      },
      "response": {
        "status": 403,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02201"
        }
      }
    },
    {
      "comment": "Creates authInfoProcess of domain ai5 with authInfo; expects 200 01000. The authorisation information the steps below meet.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ai5-{random_name}.{tld}/processes/authInfoProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "authInfoProcess",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc23456"
          },
          "expiryDate": "{date:+1d}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "authInfoProcess",
          "expiryDate": "{date:+1d}"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Reads authInfoProcess of domain ai5 as registrar b; expects 403 02201. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/domainNames/ai5-{random_name}.{tld}/processes/authInfoProcesses/latest",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 403,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02201"
        }
      }
    },
    {
      "comment": "Deletes authInfoProcess of domain ai5 as registrar b; expects 403 02201. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/ai5-{random_name}.{tld}/processes/authInfoProcesses/latest",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 403,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02201"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain ai5; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "ai5-{random_name}.{tld}"
      }
    }
  ]
}
