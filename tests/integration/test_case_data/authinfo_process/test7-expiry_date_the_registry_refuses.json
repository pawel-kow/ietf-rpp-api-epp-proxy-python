{
  "test_id": "test7-expiry_date_the_registry_refuses",
  "description": "An expiry date beyond the registry's limit is refused, and nothing is set.",
  "setup": [
    {
      "comment": "Creates contact AI7; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:AI7}"
      }
    },
    {
      "comment": "Creates domain ai7 with registrant AI7, dns records a and no authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ai7-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:AI7}"
        },
        "authInfo": {
          "select": [
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates authInfoProcess of domain ai7 with authInfo and an expiryDate 90 days ahead; expects 400 02004. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ai7-{random_name}.{tld}/processes/authInfoProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "authInfoProcess",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc23456"
          },
          "expiryDate": "{date:+90d}"
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02004"
        }
      }
    },
    {
      "comment": "Reads authInfoProcess of domain ai7; expects 404 02303. Reads back to prove nothing was set.",
      "request": {
        "method": "GET",
        "url": "/domainNames/ai7-{random_name}.{tld}/processes/authInfoProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02303"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain ai7; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "ai7-{random_name}.{tld}"
      }
    }
  ]
}
