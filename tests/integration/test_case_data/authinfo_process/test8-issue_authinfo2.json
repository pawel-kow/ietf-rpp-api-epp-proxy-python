{
  "when": {
    "profile.domainName.processes.authInfoIssueProcess.operations": {
      "contains": "create"
    }
  },
  "test_id": "test8-issue_authinfo2",
  "description": "Any client asks the registry to issue authorisation information, once, and it is never returned.",
  "setup": [
    {
      "comment": "Creates contact AI8; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:AI8}"
      }
    },
    {
      "comment": "Creates domain ai8 with registrant AI8, dns records a and no authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ai8-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:AI8}"
        },
        "authInfo": {
          "select": [
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates authInfoIssueProcess of domain ai8 as registrar b; expects 200 01000 with no authorisation information. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ai8-{random_name}.{tld}/processes/authInfoIssueProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "authInfoIssueProcess"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "authInfoIssueProcess"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Creates authInfoIssueProcess of domain ai8 again; expects 409 02302. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ai8-{random_name}.{tld}/processes/authInfoIssueProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "authInfoIssueProcess"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02302"
        }
      }
    },
    {
      "comment": "Reads authInfoIssueProcess of domain ai8; expects 501 02101. The Read operation is not supported.",
      "request": {
        "method": "GET",
        "url": "/domainNames/ai8-{random_name}.{tld}/processes/authInfoIssueProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02101"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain ai8; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "ai8-{random_name}.{tld}"
      }
    }
  ]
}
