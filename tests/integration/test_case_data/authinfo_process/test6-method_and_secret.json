{
  "test_id": "test6-method_and_secret",
  "description": "Only the method authinfo is supported, and the secret has the registry's characters and length.",
  "setup": [
    {
      "comment": "Creates contact AI6; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:AI6}"
      }
    },
    {
      "comment": "Creates domain ai6 with registrant AI6, dns records a and no authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ai6-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:AI6}"
        },
        "authInfo": {
          "select": [
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates authInfoProcess of domain ai6 with another method; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ai6-{random_name}.{tld}/processes/authInfoProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "authInfoProcess",
          "authInfo": {
            "@type": "authInfo",
            "method": "other",
            "authdata": "Abc23456"
          }
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02102"
        }
      }
    },
    {
      "comment": "Creates authInfoProcess of domain ai6 with a secret of 7 characters; expects 422 02306. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ai6-{random_name}.{tld}/processes/authInfoProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "authInfoProcess",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345"
          }
        }
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02306"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain ai6; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "ai6-{random_name}.{tld}"
      }
    }
  ]
}
