{
  "markers": [
    "smoke"
  ],
  "test_id": "test5-discovery_lists_the_extension_and_its_objects",
  "when": {
    "profile.default_preset": "planets",
    "profile.presets": {
      "not": {
        "contains": "planets-atmosphere"
      }
    }
  },
  "comment": "Skipped where the server offers more than the planets preset (sqlite-demo-extended, -bound and -inherit): demo_discovery/ shows each of those.",
  "steps": [
    {
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "discovery",
          "objects": [
            "message",
            "planet",
            "satellite"
          ],
          "extensions": [
            {
              "@type": "extension",
              "id": "org.example.rpp.extension.planets",
              "name": "RPP Planets",
              "version": "1.0",
              "url": "https://github.com/pawel-kow/ietf-rpp-api-epp-proxy-python/blob/main/.spec/planets-extension.schema.json"
            }
          ],
          "presets": [
            {
              "@type": "preset",
              "id": "urn:ietf:params:rpp:preset:base",
              "version": "1.0",
              "defaultPreset": false,
              "extensions": [],
              "profiles": [],
              "boundProfiles": []
            },
            {
              "@type": "preset",
              "id": "org.example.rpp.preset.planets",
              "name": "Planets preset",
              "version": "1.0",
              "defaultPreset": true,
              "extensions": [
                {
                  "@type": "extension",
                  "id": "org.example.rpp.extension.planets",
                  "name": "RPP Planets",
                  "version": "1.0"
                }
              ],
              "profiles": [],
              "boundProfiles": []
            }
          ]
        }
      }
    }
  ]
}
