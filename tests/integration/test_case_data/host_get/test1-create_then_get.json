{
  "markers": [
    "smoke"
  ],
  "test_id": "test1-create_then_get",
  "setup": [
    {
      "comment": "Creates domain t1 with authInfo; expects 201 01000. The domain the steps below name.",
      "include": "create_domain",
      "with": {
        "name": "t1-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates host ns1.t1 with dns records ns, a; expects 201 01000. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.t1-{random_name}.{tld}",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.t1-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.t1-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Reads host ns1.t1; expects 200 01000. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/hosts/ns1.t1-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "host",
          "hostName": "ns1.t1-{random_name}.{tld}",
          "status": [
            {
              "@type": "hostStatus",
              "label": "ok"
            }
          ],
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.t1-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.t1-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              }
            ]
          }
        },
        "headers": {
          "RPP-Code": "01000"
        },
        "fields": {
          "provMetadata.repositoryId": {
            "type": "not_null"
          }
        }
      }
    }
  ]
}
