{
  "test_id": "test4-read_prov_metadata",
  "description": "A read shows the provisioning metadata.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "hg4.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hg4.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/hosts/hg4.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host"
        },
        "fields": {
          "provMetadata.crDate": {
            "type": "not_null"
          },
          "provMetadata.spClientId": {
            "type": "not_null"
          }
        }
      }
    }
  ]
}
