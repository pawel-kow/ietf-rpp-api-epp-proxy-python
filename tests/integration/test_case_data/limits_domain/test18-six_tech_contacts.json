{
  "test_id": "test18-six_tech_contacts",
  "when": {
    "profile.domainName.contacts.labels": {
      "contains": "tech"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no admin, tech or billing contacts.",
  "description": "Six tech contacts at create.",
  "setup": [
    {
      "comment": "Creates contact Qa1 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qa1}"
      }
    },
    {
      "comment": "Creates contact Qb1 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qb1}"
      }
    },
    {
      "comment": "Creates contact Qc1 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qc1}"
      }
    },
    {
      "comment": "Creates contact Qd1 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qd1}"
      }
    },
    {
      "comment": "Creates contact Qe1 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qe1}"
      }
    },
    {
      "comment": "Creates contact Qf1 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qf1}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t18 with authInfo, registrant Qa1 (by backend), dns records a (by backend), contacts tech, tech, tech, tech, tech, tech; expects one of 400 02001 or 400 02004 or 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t18-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:Qa1}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          },
          "contacts": [
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qa1}"
              }
            },
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qb1}"
              }
            },
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qc1}"
              }
            },
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qd1}"
              }
            },
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qe1}"
              }
            },
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qf1}"
              }
            }
          ]
        }
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02001"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02004"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02005"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02306"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
