{
  "test_id": "test56-same_nameserver_twice",
  "when": {
    "profile.objects": {
      "contains": "host"
    },
    "profile.domainName.registrant.min_count": 0
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain); RRI requires a holder, so a domain cannot be without a registrant.",
  "description": "The same nameserver twice: the drafts leave it open, the server refuses it as an object that exists.",
  "setup": [
    {
      "comment": "Creates host ns1.n56 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns1.n56-{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t56 with authInfo, dns records a (by backend), 2 nameservers; expects 409 02302. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t56-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "ns1.n56-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns1.n56-{random_name}.net"
            }
          ]
        }
      },
      "response": {
        "status": 409,
        "headers": {
          "RPP-Code": "02302"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
