{
  "test_id": "test53-five_dnskeys",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "dnskey"
    },
    "profile.objects": {
      "not": {
        "contains": "host"
      }
    }
  },
  "comment": "Skipped on epp-docker: the case needs name servers as ns records of the domain, which a backend with host objects turns into hostAttr; the EPP test server refuses a hostAttr without addresses (pawel-kow/epp#33).",
  "description": "Five DNSKEY records next to two ns records, the most MTEST takes.",
  "setup": [
    {
      "comment": "Creates contact V53 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:V53}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t53 with authInfo, registrant V53 (by backend), dns records 2 ns, 5 dnskey; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t53-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:V53}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.n53-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.n53-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "dnskey",
                "rdata": {
                  "flags": "257",
                  "protocol": "3",
                  "algorithm": "8",
                  "publicKey": ""
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "dnskey",
                "rdata": {
                  "flags": "257",
                  "protocol": "3",
                  "algorithm": "8",
                  "publicKey": ""
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "dnskey",
                "rdata": {
                  "flags": "257",
                  "protocol": "3",
                  "algorithm": "8",
                  "publicKey": ""
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "dnskey",
                "rdata": {
                  "flags": "257",
                  "protocol": "3",
                  "algorithm": "8",
                  "publicKey": ""
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "dnskey",
                "rdata": {
                  "flags": "257",
                  "protocol": "3",
                  "algorithm": "8",
                  "publicKey": ""
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t53; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t53-{random_name}.{tld}"
      }
    }
  ]
}
