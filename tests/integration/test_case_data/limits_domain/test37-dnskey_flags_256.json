{
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "dnskey"
    },
    "env.domainName.dns.dnskey_supported": true,
    "env.bugs.host_attr_without_address_refused": false
  },
  "comment": "Skipped on epp-docker: the EPP test server takes DS data only, no DNSKEY (RFC 5910), and the ns records of the case would be hostAttr without addresses, which it refuses (pawel-kow/epp#33).",
  "test_id": "test37-dnskey_flags_256",
  "description": "A DNSKEY with flags 256 (ZSK), which RRI takes. RRI takes a DNSKEY only with name servers, not next to an a record.",
  "setup": [
    {
      "comment": "Creates contact X37 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X37}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t37 with authInfo, registrant X37 (by backend), dns records 2 ns, dnskey; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t37-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:X37}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.n37-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.n37-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "dnskey",
                "rdata": {
                  "flags": "256",
                  "protocol": "3",
                  "algorithm": "8",
                  "publicKey": ""
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t37; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t37-{random_name}.{tld}"
      }
    }
  ]
}
