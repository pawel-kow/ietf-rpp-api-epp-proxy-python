{
  "test_id": "test43-authinfo_without_digit",
  "when": {
    "env.domainName.authInfo.upper_and_digit_required": true
  },
  "comment": "Skipped on rri-mtest: an RRI AuthInfo needs no upper case letter or digit.",
  "description": "The EPP test server needs a digit in an authInfo.",
  "setup": [
    {
      "comment": "Creates contact X43 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X43}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t43 with authInfo, registrant X43 (by backend), dns records a (by backend); expects one of 400 02001 or 400 02004 or 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t43-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abcdefgh"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:X43}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02001"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02004"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02005"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02306"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
