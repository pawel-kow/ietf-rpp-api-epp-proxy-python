{
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "dnskey"
    },
    "env.domainName.dns.dnskey_supported": true,
    "env.bugs.host_attr_without_address_refused": false
  },
  "comment": "Skipped on epp-docker: the EPP test server takes DS data only, no DNSKEY (RFC 5910), and the ns records of the case would be hostAttr without addresses, which it refuses (pawel-kow/epp#33).",
  "test_id": "test38-dnskey_algorithm_9",
  "description": "Algorithm 9 is not in the list RRI takes.",
  "setup": [
    {
      "comment": "Creates contact X38 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X38}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t38 with authInfo, registrant X38 (by backend), dns records 2 ns, dnskey; expects one of 400 02001 or 400 02004 or 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t38-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:X38}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.n38-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.n38-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "dnskey",
                "rdata": {
                  "flags": "257",
                  "protocol": "3",
                  "algorithm": "9",
                  "publicKey": ""
                }
              }
            ]
          }
        }
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02001"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02004"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02005"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02306"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
