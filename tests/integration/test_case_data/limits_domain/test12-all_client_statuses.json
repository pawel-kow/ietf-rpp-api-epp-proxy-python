{
  "test_id": "test12-all_client_statuses",
  "when": {
    "profile.domainName.status.client_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no client statuses of a domain.",
  "description": "A domain holds every client status at once (data-objects §9.3).",
  "setup": [
    {
      "comment": "Creates contact X12 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X12}"
      }
    },
    {
      "comment": "Creates domain t12 with authInfo, registrant X12 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t12-{random_name}.{tld}",
        "registrant_id": "{handle:a:X12}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t12: add /status clientDeleteProhibited; add /status clientHold; add /status clientRenewProhibited; add /status clientTransferProhibited; 1 more; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t12-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "domainStatus",
              "label": "clientDeleteProhibited"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "domainStatus",
              "label": "clientHold"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "domainStatus",
              "label": "clientRenewProhibited"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "domainStatus",
              "label": "clientTransferProhibited"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "domainStatus",
              "label": "clientUpdateProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {}
      }
    },
    {
      "comment": "Reads domain t12; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/t12-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": [
            {
              "label": "clientDeleteProhibited"
            },
            {
              "label": "clientHold"
            },
            {
              "label": "clientRenewProhibited"
            },
            {
              "label": "clientTransferProhibited"
            },
            {
              "label": "clientUpdateProhibited"
            }
          ]
        }
      }
    }
  ]
}
