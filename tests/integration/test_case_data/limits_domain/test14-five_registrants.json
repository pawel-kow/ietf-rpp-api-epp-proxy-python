{
  "test_id": "test14-five_registrants",
  "when": {
    "profile.domainName.registrant.max_count": 5
  },
  "comment": "Skipped on epp-docker: EPP holds one registrant; several holders are RRI's.",
  "description": "Five holders, the most RRI takes.",
  "setup": [
    {
      "comment": "Creates contact Wg0 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Wg0}"
      }
    },
    {
      "comment": "Creates contact Wh0 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Wh0}"
      }
    },
    {
      "comment": "Creates contact Wi0 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Wi0}"
      }
    },
    {
      "comment": "Creates contact Wj0 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Wj0}"
      }
    },
    {
      "comment": "Creates contact Wk0 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Wk0}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t14 with authInfo, registrant Wg0 (by backend), dns records a (by backend), contacts registrant, registrant, registrant, registrant; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t14-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:Wg0}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          },
          "contacts": [
            {
              "label": "registrant",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Wh0}"
              }
            },
            {
              "label": "registrant",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Wi0}"
              }
            },
            {
              "label": "registrant",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Wj0}"
              }
            },
            {
              "label": "registrant",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Wk0}"
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t14; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t14-{random_name}.{tld}"
      }
    }
  ]
}
