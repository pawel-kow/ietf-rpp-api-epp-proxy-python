{
  "test_id": "test35-digest_type_4",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "ds"
    }
  },
  "comment": "Skipped on rri-mtest: RRI takes no DS records (DENIC computes the DS from the DNSKEY).",
  "description": "SHA-384 (digest type 4, RFC 6605): a server may support it; this one refuses it by policy, as its digest column holds 64 characters.",
  "setup": [
    {
      "comment": "Creates contact X35 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X35}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t35 with authInfo, registrant X35 (by backend), dns records ds; expects 422 02306. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t35-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:X35}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ds",
                "rdata": {
                  "keyTag": "1234",
                  "algorithm": "8",
                  "digestType": "4",
                  "digest": "49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD0123456789ABCDEF0123456789ABCDEF"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02306"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
