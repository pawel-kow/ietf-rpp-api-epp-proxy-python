{
  "test_id": "test31-aaaa_without_a",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "aaaa"
    }
  },
  "comment": "Skipped on epp-docker: EPP has no address records of the domain itself, only ns, ds and dnskey.",
  "description": "An aaaa record without an a record: RRI takes it (MTEST, 2026-11-12).",
  "setup": [
    {
      "comment": "Creates contact X31 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X31}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t31 with authInfo, registrant X31 (by backend), dns records aaaa; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t31-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:X31}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t31; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t31-{random_name}.{tld}"
      }
    }
  ]
}
