{
  "test_id": "test46-period_0",
  "when": {
    "profile.registration_periods": true
  },
  "description": "A period of 0 is under the 1 of data-objects §9.1.",
  "steps": [
    {
      "when": {
        "profile.registrant_required": true
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:X46}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact_auth_info": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t46-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.registrant_required": true
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:X46}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domain_dns_required": true
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          },
          "processes": {
            "@type": "processes",
            "createProcess": [
              {
                "@type": "domainCreateProcess",
                "period": {
                  "@type": "period",
                  "value": 0,
                  "unit": "y"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02001"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
