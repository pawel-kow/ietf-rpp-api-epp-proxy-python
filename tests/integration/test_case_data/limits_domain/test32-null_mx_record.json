{
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "mx"
    }
  },
  "comment": "Skipped on epp-docker: EPP has no MX records of the domain.",
  "test_id": "test32-null_mx_record",
  "description": "A null MX (RFC 7505) next to an a record.",
  "setup": [
    {
      "comment": "Creates contact X32 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X32}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t32 with authInfo, registrant X32 (by backend), dns records a, mx; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t32-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:X32}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "mx",
                "rdata": {
                  "preference": "0",
                  "exchange": "."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t32; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t32-{random_name}.{tld}"
      }
    }
  ]
}
