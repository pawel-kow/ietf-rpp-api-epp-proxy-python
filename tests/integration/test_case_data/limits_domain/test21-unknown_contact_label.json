{
  "test_id": "test21-unknown_contact_label",
  "description": "A label the backend has no role for is 501 (spec-issues.md, Contact labels).",
  "setup": [
    {
      "comment": "Creates contact X21 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X21}"
      }
    },
    {
      "comment": "Creates domain t21 with authInfo, registrant X21 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t21-{random_name}.{tld}",
        "registrant_id": "{handle:a:X21}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t21: add /contacts reseller; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t21-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "reseller",
              "object": {
                "@type": "contact",
                "id": "{handle:a:X21}"
              }
            }
          }
        ]
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02102"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t21; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t21-{random_name}.{tld}"
      }
    }
  ]
}
