{
  "test_id": "test55-same_tech_contact_twice",
  "when": {
    "profile.domainName.contacts.labels": {
      "contains": "tech"
    },
    "profile.domainName.registrant.min_count": 0
  },
  "comment": "Skipped on rri-mtest: RRI has no admin, tech or billing contacts; RRI requires a holder, so a domain cannot be without a registrant.",
  "skip": "pawel-kow/epp#32",
  "description": "The same contact twice in one role: the drafts leave it open; refused as the same server refuses a nameserver twice (limits_domain/test56).",
  "setup": [
    {
      "comment": "Creates contact V55 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:V55}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t55 with authInfo, dns records a (by backend), contacts tech, tech; expects 409 02302. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t55-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          },
          "contacts": [
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:V55}"
              }
            },
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:V55}"
              }
            }
          ]
        }
      },
      "response": {
        "status": 409,
        "headers": {
          "RPP-Code": "02302"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
