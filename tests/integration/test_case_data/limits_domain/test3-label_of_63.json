{
  "when": {
    "env.bugs.long_label_cut": false
  },
  "comment": "Skipped on epp-docker: the EPP test server stores a label of 61 to 63 characters cut and sends no reply (pawel-kow/epp#30).",
  "test_id": "test3-label_of_63",
  "description": "A label of 63 characters, within the 63 octets of DNS (RFC 1035 §2.3.4), is registered and read back whole.",
  "setup": [
    {
      "comment": "Creates contact X3 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X3}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t3 (a label of 63) with authInfo, registrant X3 (by backend), dns records a (by backend); expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "{pad:63:t3-{random_name}}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:X3}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Reads domain t3 (a label of 63); expects 200. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/domainNames/{pad:63:t3-{random_name}}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "name": "{pad:63:t3-{random_name}}.{tld}"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t3 (a label of 63); expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "{pad:63:t3-{random_name}}.{tld}"
      }
    }
  ]
}
