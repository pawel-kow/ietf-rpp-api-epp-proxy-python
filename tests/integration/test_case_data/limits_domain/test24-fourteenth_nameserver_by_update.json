{
  "test_id": "test24-fourteenth_nameserver_by_update",
  "skip": "pawel-kow/epp#29",
  "when": {
    "profile.objects": {
      "contains": "host"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain).",
  "description": "A fourteenth nameserver added to a domain with thirteen: the limit holds for the domain, not the command.",
  "setup": [
    {
      "comment": "Creates contact X24 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X24}"
      }
    },
    {
      "comment": "Creates host ns1.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns1.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns2.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns2.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns3.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns3.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns4.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns4.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns5.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns5.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns6.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns6.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns7.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns7.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns8.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns8.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns9.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns9.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns10.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns10.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns11.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns11.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns12.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns12.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns13.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns13.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns14.n24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns14.n24-{random_name}.net"
      }
    },
    {
      "comment": "Creates domain t24 with authInfo, registrant X24 (by backend), dns records a (by backend), 13 nameservers; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t24-{random_name}.{tld}",
        "nameservers": [
          {
            "@type": "host",
            "hostName": "ns1.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns2.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns3.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns4.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns5.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns6.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns7.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns8.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns9.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns10.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns11.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns12.n24-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns13.n24-{random_name}.net"
          }
        ],
        "registrant_id": "{handle:a:X24}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t24: add /nameservers; expects one of 400 02001 or 400 02004 or 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t24-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns14.n24-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02001"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02004"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02005"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02306"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
