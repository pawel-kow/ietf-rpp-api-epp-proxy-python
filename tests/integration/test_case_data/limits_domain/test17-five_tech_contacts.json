{
  "test_id": "test17-five_tech_contacts",
  "when": {
    "profile.domainName.contacts.labels": {
      "contains": "tech"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no admin, tech or billing contacts.",
  "description": "Five tech contacts, the most the EPP test server takes per role.",
  "setup": [
    {
      "comment": "Creates contact Qa0 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qa0}"
      }
    },
    {
      "comment": "Creates contact Qb0 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qb0}"
      }
    },
    {
      "comment": "Creates contact Qc0 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qc0}"
      }
    },
    {
      "comment": "Creates contact Qd0 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qd0}"
      }
    },
    {
      "comment": "Creates contact Qe0 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Qe0}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t17 with authInfo, registrant Qa0 (by backend), dns records a (by backend), contacts tech, tech, tech, tech, tech; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t17-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:Qa0}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          },
          "contacts": [
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qa0}"
              }
            },
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qb0}"
              }
            },
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qc0}"
              }
            },
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qd0}"
              }
            },
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Qe0}"
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName"
        }
      }
    }
  ]
}
