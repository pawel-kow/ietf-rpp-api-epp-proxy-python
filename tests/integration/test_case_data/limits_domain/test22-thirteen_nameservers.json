{
  "test_id": "test22-thirteen_nameservers",
  "description": "Thirteen name servers, the most both servers take: host objects where the backend has them (the EPP test server), ns records where it has none (RRI).",
  "setup": [
    {
      "comment": "Creates contact X22 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X22}"
      }
    },
    {
      "comment": "Creates host ns1.n22 with dns records ns; expects 201. A nameserver of the domain below. Only where the backend has host objects (epp-docker).",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "include": "create_host",
      "with": {
        "name": "ns1.n22-{random_name}.net"
      }
    },
