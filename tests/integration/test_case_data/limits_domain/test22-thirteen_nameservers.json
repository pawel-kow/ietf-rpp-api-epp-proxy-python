                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t22; expects 200. MTEST keeps what a case creates, so the case deletes it. Only where the backend has no host objects (rri-mtest).",
      "when": {
        "profile.objects": {
          "not": {
            "contains": "host"
          }
        }
      },
      "include": "delete_domain",
      "with": {
        "name": "t22-{random_name}.{tld}"
      }
