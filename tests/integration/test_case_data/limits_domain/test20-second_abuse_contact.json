{
  "test_id": "test20-second_abuse_contact",
  "when": {
    "profile.domainName.abuse.max_count": {
      "min": 1
    }
  },
  "comment": "Skipped on epp-docker: EPP has no General Request or Abuse contact of a domain.",
  "description": "RRI holds one abuse contact, which the member `abuse` holds: a list of two is refused.",
  "setup": [
    {
      "comment": "Creates request contact RG26 with uriTemplate; expects 201 01000. The Abuse contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RG26}"
      }
    },
    {
      "comment": "Creates request contact RA26 with uriTemplate; expects 201 01000. The Abuse contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RA26}"
      }
    },
    {
      "comment": "Creates contact X20 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:X20}"
      }
    },
    {
      "comment": "Creates domain t20 with authInfo, registrant X20 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t20-{random_name}.{tld}",
        "registrant_id": "{handle:a:X20}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t20: add /abuse; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t20-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/abuse",
            "value": {
              "@type": "requestContact",
              "id": "{handle:a:RA26}"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {}
      }
    },
    {
      "comment": "Patches domain t20: add /abuse; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t20-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/abuse",
            "value": [
              {
                "@type": "requestContact",
                "id": "{handle:a:RA26}"
              },
              {
                "@type": "requestContact",
                "id": "{handle:a:RG26}"
              }
            ]
          }
        ]
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02001"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t20; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t20-{random_name}.{tld}"
      }
    }
  ]
}
