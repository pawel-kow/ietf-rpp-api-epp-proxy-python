{
  "test_id": "test58-same_ds_twice",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "ds"
    }
  },
  "comment": "Skipped on rri-mtest: RRI takes no DS records (DENIC computes the DS from the DNSKEY).",
  "description": "The same DS record twice: the drafts leave it open, the server refuses it by policy.",
  "setup": [
    {
      "comment": "Creates contact V58 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:V58}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t58 with authInfo, registrant V58 (by backend), dns records 2 ds; expects 422 02306. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t58-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:V58}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ds",
                "rdata": {
                  "keyTag": "58",
                  "algorithm": "8",
                  "digestType": "2",
                  "digest": "585846E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ds",
                "rdata": {
                  "keyTag": "58",
                  "algorithm": "8",
                  "digestType": "2",
                  "digest": "585846E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02306"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
