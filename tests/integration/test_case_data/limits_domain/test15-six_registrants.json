{
  "test_id": "test15-six_registrants",
  "skip": "#140",
  "when": {
    "profile.domainName.registrant.max_count": 5
  },
  "comment": "Skipped on epp-docker: EPP holds one registrant; several holders are RRI's.",
  "description": "Six holders, one over the most the backend takes: a limit of the server, so 4xx and not 501.",
  "setup": [
    {
      "comment": "Creates contact Wg1 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Wg1}"
      }
    },
    {
      "comment": "Creates contact Wh1 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Wh1}"
      }
    },
    {
      "comment": "Creates contact Wi1 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Wi1}"
      }
    },
    {
      "comment": "Creates contact Wj1 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Wj1}"
      }
    },
    {
      "comment": "Creates contact Wk1 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Wk1}"
      }
    },
    {
      "comment": "Creates contact Wl1 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Wl1}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t15 with authInfo, registrant Wg1 (by backend), dns records a (by backend), contacts registrant, registrant, registrant, registrant, registrant; expects one of 400 02001 or 400 02004 or 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t15-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:Wg1}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          },
          "contacts": [
            {
              "label": "registrant",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Wh1}"
              }
            },
            {
              "label": "registrant",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Wi1}"
              }
            },
            {
              "label": "registrant",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Wj1}"
              }
            },
            {
              "label": "registrant",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Wk1}"
              }
            },
            {
              "label": "registrant",
              "object": {
                "@type": "contact",
                "id": "{handle:a:Wl1}"
              }
            }
          ]
        }
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02001"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02004"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02005"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02306"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
