{
  "when": [
    {
      "profile.contact.name.removable": false
    },
    {
      "env.contact.name.min_count": {
        "min": 1
      }
    }
  ],
  "test_id": "test5-update",
  "description": "The request is the example of json 8.2.4 (kind and name are omitted, and so are the organizations). The draft's response keeps `name` and `organizations`. This server takes a full update as the wanted state (core §16.8), so the omitted name is cleared, which EPP cannot do: 501, see spec-issues.md (Full update of a contact).",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:-U1}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "org",
            "name": {
              "select": [
                {
                  "when": {
                    "profile.contact.org.person_name_supported": true
                  },
                  "then": {
                    "full": "John Doe"
                  }
                },
                {
                  "then": {
                    "full": "Example Inc."
                  }
                }
              ]
            },
            "organizations": {
              "org": {
                "name": "Example Inc."
              }
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Reston"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact.region.supported": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "VA"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "20190"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+1.7035555555"
              }
            },
            "emails": {
              "email": {
                "address": "jdoe@example.example"
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:-U1}"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "/contacts/{handle:a:-U1}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "456 New Street, Suite 200"
                  },
                  {
                    "kind": "locality",
                    "value": "Reston"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact.region.supported": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "VA"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "20190"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+1.7035555556"
              }
            },
            "emails": {
              "email": {
                "address": "jdoe-new@example.example"
              }
            }
          }
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.contact.name.removable": false
            },
            "then": {
              "status": 501,
              "headers": {
                "RPP-Code": "02102"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          },
          {
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02306"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
