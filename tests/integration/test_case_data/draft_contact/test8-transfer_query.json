{
  "when": {
    "profile.domainName.processes.transfer.operations": {
      "contains": "request"
    },
    "profile.contact.processes.transfer.operations": {
      "contains": "query"
    }
  },
  "test_id": "test8-transfer_query",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:D8}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "US"
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "2feeBAR9"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:D8}"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/contacts/{handle:a:D8}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json",
          "RPP-Authorization": "authinfo value=MmZlZUJBUjk="
        },
        "body_json": {
          "@type": "transferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "transferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "baz",
          "actClientId": "foo"
        },
        "headers": {
          "RPP-Code": "01001"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:D8}/processes/transferProcesses/latest",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "transferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "baz",
          "actClientId": "foo"
        },
        "headers": {
          "RPP-Code": "01000"
        },
        "fields": {
          "reqClientId": {
            "type": "not_empty_string"
          },
          "requestDate": {
            "type": "datetime_format_utc_and_delta",
            "reference": "{test_start}",
            "min_delta": -60,
            "max_delta": 120
          },
          "actionDate": {
            "type": "not_null"
          }
        }
      }
    }
  ]
}
