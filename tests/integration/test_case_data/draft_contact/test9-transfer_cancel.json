{
  "when": {
    "profile.domainName.processes.transfer.operations": {
      "contains": "request"
    },
    "profile.contact.processes.transfer.operations": {
      "contains": "cancel"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no contact transfer.",
  "test_id": "test9-transfer_cancel",
  "exclusive": [
    "message_queue"
  ],
  "setup": [
    {
      "comment": "Creates contact D9 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:D9}",
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "2feeBAR9"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of contact D9 with transferDir as registrar b; expects 201 01001. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts/{handle:a:D9}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=MmZlZUJBUjk="
        },
        "body_json": {
          "@type": "transferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "transferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "baz",
          "actClientId": "foo"
        },
        "headers": {
          "RPP-Code": "01001"
        }
      }
    },
    {
      "comment": "Cancels the pending transfer of contact D9 as registrar b; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/contacts/{handle:a:D9}/processes/transferProcesses/latest",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "transferProcess",
          "trStatus": "clientCancelled",
          "transferDir": "pull"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
