{
  "test_id": "test9-transfer_cancel",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "FO-{random_id_10}D9",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  }
                ],
                "countryCode": "US"
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            }
          },
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "2fooBAR"
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "FO-{random_id_10}D9"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/contacts/FO-{random_id_10}D9/processes/transferProcesses",
        "headers": {
          "Authorization": "Basic YmF6OnF1eA==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json",
          "RPP-Authorization": "authinfo value=MmZvb0JBUg=="
        },
        "body_json": {
          "@type": "transferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "transferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "baz",
          "actClientId": "foo"
        },
        "headers": {
          "RPP-Code": "01001"
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "url": "/contacts/FO-{random_id_10}D9/processes/transferProcesses/latest",
        "headers": {
          "Authorization": "Basic YmF6OnF1eA==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "transferProcess",
          "trStatus": "clientCancelled",
          "transferDir": "pull"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
