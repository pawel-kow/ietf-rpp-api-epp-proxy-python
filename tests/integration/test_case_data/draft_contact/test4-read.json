{
  "test_id": "test4-read",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:J04}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Example Dr., Suite 100"
                  },
                  {
                    "kind": "locality",
                    "value": "Dulles"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact_region": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "VA"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "20166-6503"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+1.7035555555"
              },
              "fax": {
                "select": [
                  {
                    "when": {
                      "profile.contact_fax": true
                    },
                    "then": {
                      "features": {
                        "fax": true
                      },
                      "number": "tel:+1.7035555556"
                    }
                  },
                  {
                    "omit": true
                  }
                ]
              }
            },
            "emails": {
              "email": {
                "address": "jdoe@example.example"
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact_auth_info": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "2feeBAR9"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {}
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:J04}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:J04}",
          "status": [
            {
              "@type": "contactStatus",
              "label": "ok"
            }
          ],
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Example Dr., Suite 100"
                  },
                  {
                    "kind": "locality",
                    "value": "Dulles"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact_region": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "VA"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "20166-6503"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+1.7035555555"
              },
              "fax": {
                "select": [
                  {
                    "when": {
                      "profile.contact_fax": true
                    },
                    "then": {
                      "features": {
                        "fax": true
                      },
                      "number": "tel:+1.7035555556"
                    }
                  },
                  {
                    "omit": true
                  }
                ]
              }
            },
            "emails": {
              "email": {
                "address": "jdoe@example.example"
              }
            }
          }
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          },
          "provMetadata.crClientId": {
            "select": [
              {
                "when": {
                  "profile.metadata": {
                    "contains": "contact.crClientId"
                  }
                },
                "then": {
                  "type": "not_null"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "provMetadata.crDate": {
            "select": [
              {
                "when": {
                  "profile.metadata": {
                    "contains": "contact.crDate"
                  }
                },
                "then": {
                  "type": "datetime_format_utc_and_delta",
                  "reference": "{test_start}",
                  "min_delta": -1,
                  "max_delta": 60
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      }
    }
  ]
}
