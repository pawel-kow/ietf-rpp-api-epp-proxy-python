{
  "when": {
    "profile.domainName.processes.transfer.operations": {
      "contains": "request"
    },
    "profile.contact.processes.transfer.operations": {
      "contains": "reject"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no contact transfer.",
  "test_id": "test11-transfer_reject",
  "exclusive": [
    "message_queue"
  ],
  "setup": [
    {
      "comment": "Creates contact D11 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:D11}",
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "2feeBAR9"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of contact D11 with transferDir as registrar b; expects 201 01001. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts/{handle:a:D11}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=MmZlZUJBUjk="
        },
        "body_json": {
          "@type": "transferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "transferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "baz",
          "actClientId": "foo"
        },
        "headers": {
          "RPP-Code": "01001"
        }
      }
    },
    {
      "comment": "Rejects the pending transfer of contact D11; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts/{handle:a:D11}/processes/transferProcesses/latest/transferReject",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "transferProcess",
          "reason": "Client rejected the transfer request."
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02102"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Cancels the transfer requested above as registrar b, the requester; expects 200 01000. A transfer left pending is approved by the server minutes later, which queues messages after the case released the queue mutex.",
      "include": "cancel_transfer",
      "with": {
        "collection": "contacts",
        "id": "{handle:a:D11}"
      }
    }
  ]
}
