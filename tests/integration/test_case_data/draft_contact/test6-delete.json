{
  "when": {
    "profile.contact.processes.delete.supported": true
  },
  "test_id": "test6-delete",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:J06}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Example Dr., Suite 100"
                  },
                  {
                    "kind": "locality",
                    "value": "Dulles"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact.region.supported": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "VA"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "20166-6503"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+1.7035555555"
              },
              "fax": {
                "select": [
                  {
                    "when": {
                      "profile.contact.fax.supported": true
                    },
                    "then": {
                      "features": {
                        "fax": true
                      },
                      "number": "tel:+1.7035555556"
                    }
                  },
                  {
                    "omit": true
                  }
                ]
              }
            },
            "emails": {
              "email": {
                "address": "jdoe@example.example"
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "2feeBAR9"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {}
      }
    },
    {
      "request": {
        "method": "DELETE",
        "url": "/contacts/{handle:a:J06}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    }
  ]
}
