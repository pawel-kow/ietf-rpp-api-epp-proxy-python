{
  "when": {
    "profile.domainName.processes.transfer.operations": {
      "contains": "request"
    },
    "profile.contact.processes.transfer.operations": {
      "contains": "request"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no contact transfer.",
  "test_id": "test7-transfer_request",
  "exclusive": [
    "message_queue"
  ],
  "setup": [
    {
      "comment": "Creates contact D7 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:D7}",
        "authInfo": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "authInfo",
                "method": "authinfo",
                "authdata": "2feeBAR9"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of contact D7 with transferDir as registrar b; expects 201 01001. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts/{handle:a:D7}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=MmZlZUJBUjk="
        },
        "body_json": {
          "@type": "transferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "transferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "baz",
          "actClientId": "foo"
        },
        "headers": {
          "RPP-Code": "01001",
          "Location": {
            "type": "not_empty_string"
          }
        },
        "fields": {
          "reqClientId": {
            "type": "not_empty_string"
          },
          "requestDate": {
            "type": "datetime_format_utc_and_delta",
            "reference": "{test_start}",
            "min_delta": -60,
            "max_delta": 120
          },
          "actionDate": {
            "type": "not_null"
          }
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Cancels the transfer requested above as registrar b, the requester; expects 200 01000. A transfer left pending is approved by the server minutes later, which queues messages after the case released the queue mutex.",
      "include": "cancel_transfer",
      "with": {
        "collection": "contacts",
        "id": "{handle:a:D7}"
      }
    }
  ]
}
