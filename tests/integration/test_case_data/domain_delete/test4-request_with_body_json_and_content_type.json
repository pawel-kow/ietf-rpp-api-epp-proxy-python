{
  "test_id": "test4-request_with_body_json_and_content_type",
  "steps": [
    {
      "request": {
        "method": "DELETE",
        "url": "/domainNames/test4-{random_name}.{tld}",
        "body_json": {
          "@type": "domainName",
          "name": "NOT-FREE.EXAMPLE",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "RPP-Cltrid": "test4-{random_name}-clTRID",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json"
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "test4-{random_name}-clTRID"
        }
      }
    }
  ]
}
