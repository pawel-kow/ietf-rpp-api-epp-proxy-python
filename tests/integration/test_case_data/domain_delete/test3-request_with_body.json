{
  "test_id": "test3-request_with_body",
  "setup": [
    {
      "comment": "Creates contact HD3; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HD3}"
      }
    },
    {
      "comment": "Creates domain test3 with authInfo, registrant HD3 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "test3-{random_name}.{tld}",
        "registrant_id": "{handle:a:HD3}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes domain test3, with a fixed RPP-Cltrid, a raw body that is no valid JSON; expects 400. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/test3-{random_name}.{tld}",
        "body_raw": "test",
        "headers": {
          "RPP-Cltrid": "test3-{random_name}-clTRID",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}"
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "test3-{random_name}-clTRID"
        }
      }
    }
  ]
}
