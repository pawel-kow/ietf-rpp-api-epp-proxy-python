{
  "when": {
    "profile.domainName.processes.releaseProcess.operations": {
      "contains": "create"
    }
  },
  "markers": [
    "smoke"
  ],
  "test_id": "test5-release_of_a_failed_domain",
  "description": "A domain whose name servers failed the registry's check is in the status of a failed check, which the registry does not release (53000080012): 409 02304, not 500. The domain stays the client's.",
  "setup": [
    {
      "comment": "Creates contact RP5; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:RP5}"
      }
    },
    {
      "comment": "Creates domain rp5 of registrar a with registrant RP5 and name servers that do not serve it; expects 201 with the status of a failed check. The domain the release below is refused for.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "rp5-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:RP5}"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.rp5-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.rp5-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.failed_dns_status}"
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates releaseProcess of domain rp5; expects 409 02304. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/rp5-{random_name}.{tld}/processes/releaseProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "releaseProcess"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02304"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain rp5; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "rp5-{random_name}.{tld}"
      }
    }
  ]
}
