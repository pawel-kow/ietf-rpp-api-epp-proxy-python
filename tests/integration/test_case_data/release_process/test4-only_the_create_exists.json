{
  "when": {
    "profile.domainName.processes.releaseProcess.operations": {
      "contains": "create"
    }
  },
  "markers": [
    "smoke"
  ],
  "test_id": "test4-only_the_create_exists",
  "description": "The Release Process Object has a Create only: a list, a Read (at latest and by id) and a Delete answer 501 02101, and nothing is released.",
  "setup": [
    {
      "comment": "Creates contact RP4; expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:RP4}"
      }
    },
    {
      "comment": "Creates domain rp4 of registrar a with registrant RP4; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "rp4-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:RP4}"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Reads the release processes of domain rp4; expects 501 02101.",
      "request": {
        "method": "GET",
        "url": "/domainNames/rp4-{random_name}.{tld}/processes/releaseProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02101"
        }
      }
    },
    {
      "comment": "Reads releaseProcess latest of domain rp4; expects 501 02101. The Read operation is not supported.",
      "request": {
        "method": "GET",
        "url": "/domainNames/rp4-{random_name}.{tld}/processes/releaseProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02101"
        }
      }
    },
    {
      "comment": "Reads releaseProcess p1 of domain rp4; expects 501 02101.",
      "request": {
        "method": "GET",
        "url": "/domainNames/rp4-{random_name}.{tld}/processes/releaseProcesses/p1",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02101"
        }
      }
    },
    {
      "comment": "Deletes releaseProcess latest of domain rp4; expects 501 02101.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/rp4-{random_name}.{tld}/processes/releaseProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02101"
        }
      }
    },
    {
      "comment": "Deletes releaseProcess p1 of domain rp4; expects 501 02101.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/rp4-{random_name}.{tld}/processes/releaseProcesses/p1",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02101"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain rp4; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "rp4-{random_name}.{tld}"
      }
    }
  ]
}
