{
  "test_id": "test8-address_256",
  "description": "256 is no IPv4 octet (RFC 791).",
  "setup": [
    {
      "comment": "Creates contact Y8 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Y8}"
      }
    },
    {
      "comment": "Creates domain h8 with authInfo, registrant Y8 (by backend), dns records a (by backend); expects 201. The domain the steps below name.",
      "include": "create_domain",
      "with": {
        "name": "h8-{random_name}.{tld}",
        "registrant_id": "{handle:a:Y8}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates host ns1.h8 with dns records ns, a; expects one of 400 02001 or 400 02005. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.h8-{random_name}.{tld}",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.h8-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h8-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "256.0.0.1"
                }
              }
            ]
          }
        }
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02001"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02005"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
