{
  "test_id": "test11-both_client_statuses",
  "description": "A host holds both client statuses at once (data-objects §9.4).",
  "setup": [
    {
      "comment": "Creates host h11.….net with dns records ns; expects 201. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "h11.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host h11.….net: add /status clientDeleteProhibited; add /status clientUpdateProhibited; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/h11.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientUpdateProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {}
      }
    },
    {
      "comment": "Reads host h11.….net; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/hosts/h11.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": [
            {
              "label": "clientDeleteProhibited"
            },
            {
              "label": "clientUpdateProhibited"
            }
          ]
        }
      }
    }
  ]
}
