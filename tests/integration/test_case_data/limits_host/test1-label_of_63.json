{
  "test_id": "test1-label_of_63",
  "description": "A label of 63 characters (RFC 1035 §2.3.4).",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "{pad:63:h1-{random_name}}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "{pad:63:h1-{random_name}}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/hosts/{pad:63:h1-{random_name}}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "hostName": "{pad:63:h1-{random_name}}.net"
        }
      }
    }
  ]
}
