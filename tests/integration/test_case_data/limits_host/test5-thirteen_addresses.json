                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.12"
                }
              },
              {
                "@type": "dnsRecord",
