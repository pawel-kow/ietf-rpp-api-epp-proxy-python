{
  "test_id": "test5-thirteen_addresses",
  "description": "Thirteen addresses, the most the EPP test server takes.",
  "setup": [
    {
      "comment": "Creates contact Y5 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Y5}"
      }
    },
    {
      "comment": "Creates domain h5 with authInfo, registrant Y5 (by backend), dns records a (by backend); expects 201. The domain the steps below name.",
      "include": "create_domain",
      "with": {
        "name": "h5-{random_name}.{tld}",
        "registrant_id": "{handle:a:Y5}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates host ns1.h5 with dns records ns, 13 a; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.h5-{random_name}.{tld}",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.h5-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.2"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.3"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.4"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.5"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.6"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.7"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.8"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.9"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.11"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.12"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.13"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Reads host ns1.h5; expects 200. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/hosts/ns1.h5-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
