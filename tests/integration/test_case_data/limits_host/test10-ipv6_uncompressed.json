{
  "test_id": "test10-ipv6_uncompressed",
  "skip": "#137",
  "description": "An uncompressed IPv6 address is read back in the form of RFC 5952.",
  "setup": [
    {
      "comment": "Creates contact Y10 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Y10}"
      }
    },
    {
      "comment": "Creates domain h10 with authInfo, registrant Y10 (by backend), dns records a (by backend); expects 201. The domain the steps below name.",
      "include": "create_domain",
      "with": {
        "name": "h10-{random_name}.{tld}",
        "registrant_id": "{handle:a:Y10}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates host ns1.h10 with dns records ns, aaaa; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.h10-{random_name}.{tld}",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.h10-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.h10-{random_name}.{tld}.",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:0db8:0000:0000:0000:0000:0000:0001"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Reads host ns1.h10; expects 200. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/hosts/ns1.h10-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "dns": {
            "records": [
              {
                "type": "ns"
              },
              {
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
