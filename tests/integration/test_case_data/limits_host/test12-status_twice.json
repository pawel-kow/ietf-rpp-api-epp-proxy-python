{
  "test_id": "test12-status_twice",
  "description": "The same client status added twice in one PATCH: the proxy sends both, and the server refuses the second as one that exists.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "h12.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "h12.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/hosts/h12.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02306"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
