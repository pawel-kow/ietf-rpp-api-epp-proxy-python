{
  "test_id": "test12-status_twice",
  "description": "The same client status added twice in one PATCH: the proxy sends both, and the server refuses the second as one that exists.",
  "setup": [
    {
      "comment": "Creates host h12.….net with dns records ns; expects 201. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "h12.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host h12.….net: add /status clientDeleteProhibited; add /status clientDeleteProhibited; expects 422 02306. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/h12.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02306"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
