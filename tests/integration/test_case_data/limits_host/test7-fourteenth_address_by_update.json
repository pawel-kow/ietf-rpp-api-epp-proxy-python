{
  "test_id": "test7-fourteenth_address_by_update",
  "skip": "pawel-kow/epp#29",
  "description": "A fourteenth address added to a host with thirteen: the limit holds for the host, not the command.",
  "setup": [
    {
      "comment": "Creates contact Y7 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Y7}"
      }
    },
    {
      "comment": "Creates domain h7 with authInfo, registrant Y7 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "h7-{random_name}.{tld}",
        "registrant_id": "{handle:a:Y7}"
      }
    },
    {
      "comment": "Creates host ns1.h7 with dns records ns, 13 a; expects 201. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "ns1.h7-{random_name}.{tld}",
        "dns": {
          "@type": "dnsData",
          "records": [
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ns",
              "rdata": {
                "nsdname": "ns1.h7-{random_name}.{tld}."
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.1"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.2"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.3"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.4"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.5"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.6"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.7"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.8"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.9"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.10"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.11"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.12"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.13"
              }
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host ns1.h7: add /dns/records; expects one of 400 02001 or 400 02004 or 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/ns1.h7-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "ns1.h7-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.14"
              }
            }
          }
        ]
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02001"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02004"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02005"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02306"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
