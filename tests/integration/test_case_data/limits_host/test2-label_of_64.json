{
  "test_id": "test2-label_of_64",
  "description": "A label of 64 characters is over the 63 of DNS.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "{pad:64:h2-{random_name}}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "{pad:64:h2-{random_name}}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02001"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02005"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
