{
  "test_id": "test1-expiry_date_read_when_omitted",
  "setup": [
    {
      "comment": "Creates domain rn1 with authInfo; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "rn1-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Renews domain rn1 with renewalPeriod; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/rn1-{random_name}.{tld}/processes/renewProcesses",
        "body_json": {
          "@type": "renewProcess",
          "renewalPeriod": {
            "@type": "period",
            "value": 2,
            "unit": "y"
          }
        },
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        },
        "body": {
          "@type": "renewProcess"
        },
        "fields": {
          "expiryDate": {
            "type": "datetime_format_utc_and_delta",
            "reference": "{test_start}",
            "min_delta": 94607940,
            "max_delta": 94694460
          }
        }
      }
    }
  ]
}
