{
  "test_id": "test2-type_only_is_accepted",
  "setup": [
    {
      "comment": "Creates domain rn2 with authInfo; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "rn2-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Renews domain rn2; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/rn2-{random_name}.{tld}/processes/renewProcesses",
        "body_json": {
          "@type": "renewProcess"
        },
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        },
        "body": {
          "@type": "renewProcess"
        },
        "fields": {
          "expiryDate": {
            "type": "datetime_format_utc_and_delta",
            "reference": "{test_start}",
            "min_delta": 31535940,
            "max_delta": 315360000
          }
        }
      }
    }
  ]
}
