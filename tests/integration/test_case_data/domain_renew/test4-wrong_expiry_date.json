{
  "test_id": "test4-wrong_expiry_date",
  "setup": [
    {
      "comment": "Creates domain rn4 with authInfo; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "rn4-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Renews domain rn4 with expiryDate, renewalPeriod; expects 422 02306. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/rn4-{random_name}.{tld}/processes/renewProcesses",
        "body_json": {
          "@type": "renewProcess",
          "expiryDate": "2001-01-01T22:00:00.0Z",
          "renewalPeriod": {
            "@type": "period",
            "value": 1,
            "unit": "y"
          }
        },
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        }
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02306",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
