{
  "test_id": "test10-correct_expiry_date_given",
  "setup": [
    {
      "comment": "Creates domain rn10 with authInfo; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "rn10-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Reads domain rn10; expects 200. Reads what the steps above created. Keeps expiry for later steps.",
      "request": {
        "method": "GET",
        "url": "/domainNames/rn10-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        },
        "fields": {
          "expiryDate": {
            "type": "not_null"
          }
        }
      },
      "capture": {
        "expiry": "expiryDate"
      }
    },
    {
      "comment": "Renews domain rn10 with expiryDate, renewalPeriod; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/rn10-{random_name}.{tld}/processes/renewProcesses",
        "body_json": {
          "@type": "renewProcess",
          "expiryDate": "{capture:expiry}",
          "renewalPeriod": {
            "@type": "period",
            "value": 2,
            "unit": "y"
          }
        },
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        },
        "body": {
          "@type": "renewProcess",
          "expiryDate": "{capture:expiry+2y}"
        }
      }
    }
  ]
}
