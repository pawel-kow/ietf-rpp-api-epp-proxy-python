{
  "markers": [
    "smoke"
  ],
  "test_id": "test1-delete",
  "setup": [
    {
      "comment": "Creates host t1.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t1.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes host t1.….net; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/hosts/t1.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Reads host t1.….net; expects 404 02303. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/hosts/t1.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "headers": {
          "RPP-Code": "02303"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
