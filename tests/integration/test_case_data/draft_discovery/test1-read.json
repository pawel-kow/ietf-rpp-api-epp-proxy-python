{
  "markers": [
    "smoke"
  ],
  "test_id": "test1-read",
  "steps": [
    {
      "comment": "Reads the discovery document without credentials; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "discovery",
          "versions": [
            {
              "@type": "discoveryVersion",
              "version": "1.0",
              "baseUrl": "https://localhost:8000"
            }
          ],
          "environment": {
            "@type": "discoveryEnvironment",
            "name": "{env:environment_name}",
            "status": "test"
          },
          "tlds": [
            "{tld}"
          ],
          "presets": [
            {
              "@type": "preset",
              "id": "urn:ietf:params:rpp:preset:base",
              "name": "Base preset",
              "description": "RPP without extensions and without profiles.",
              "version": "1.0",
              "rppVersion": "1.0",
              "url": "https://datatracker.ietf.org/doc/draft-ietf-rpp-data-objects/",
              "extensions": [],
              "profiles": [],
              "boundProfiles": [],
              "defaultPreset": false
            },
            {
              "@type": "preset",
              "id": "urn:ietf:params:rpp:preset:epp-compatible",
              "name": "EPP compatible preset",
              "description": "RPP without extensions, constrained by the EPP Compatibility Profile.",
              "version": "1.0",
              "rppVersion": "1.0",
              "url": "https://datatracker.ietf.org/doc/draft-ietf-rpp-data-objects/",
              "basePresets": [
                {
                  "@type": "preset",
                  "id": "urn:ietf:params:rpp:preset:base",
                  "version": "1.0"
                }
              ],
              "extensions": [],
              "profiles": [
                {
                  "@type": "profile",
                  "id": "urn:ietf:params:rpp:profile:epp-compatibility",
                  "version": "1.0"
                }
              ],
              "boundProfiles": [],
              "defaultPreset": true
            }
          ],
          "profiles": [
            {
              "@type": "profile",
              "id": "urn:ietf:params:rpp:profile:epp-compatibility",
              "version": "1.0"
            }
          ],
          "objects": [
            "domainName",
            "host",
            "contact",
            "message"
          ]
        },
        "fields": {
          "datetime": {
            "type": "not_empty_string"
          }
        }
      },
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      }
    },
