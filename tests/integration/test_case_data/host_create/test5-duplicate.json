{
  "test_id": "test5-duplicate",
  "setup": [
    {
      "comment": "Creates host t5.….net with dns records ns; expects 201 01000. The host the steps below name.",
      "include": "create_host",
      "with": {
        "name": "t5.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates host t5.….net with dns records ns; expects 409 02302. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t5.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t5.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 409,
        "headers": {
          "RPP-Code": "02302"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
