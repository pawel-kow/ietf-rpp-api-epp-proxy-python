{
  "when": {
    "profile.domainName.period.supported": true,
    "profile.domainName.processes.transfer.operations": {
      "contains": "request"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no registration period (a domain runs until it is deleted).",
  "test_id": "test11-transfer_request",
  "exclusive": [
    "message_queue"
  ],
  "setup": [
    {
      "comment": "Creates contact HR11; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HR11}"
      }
    },
    {
      "comment": "Creates domain ex11 with authInfo, registrant HR11 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ex11-{random_name}.{tld}",
        "registrant_id": "{handle:a:HR11}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of domain ex11 with transferDir, transferPeriod as registrar b; expects 201 01001. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ex11-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=QWJjMjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "pull",
          "transferPeriod": {
            "@type": "period",
            "value": 1,
            "unit": "y"
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainTransferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "baz",
          "actClientId": "foo"
        },
        "headers": {
          "RPP-Code": "01001",
          "Location": {
            "type": "not_empty_string"
          }
        },
        "fields": {
          "reqClientId": {
            "type": "not_empty_string"
          },
          "requestDate": {
            "type": "datetime_format_utc_and_delta",
            "reference": "{test_start}",
            "min_delta": -60,
            "max_delta": 120
          },
          "actionDate": {
            "type": "not_null"
          },
          "expiryDate": {
            "select": [
              {
                "when": {
                  "profile.domainName.period.supported": true
                },
                "then": {
                  "type": "not_null"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Cancels the transfer requested above as registrar b, the requester; expects 200 01000. A transfer left pending is approved by the server minutes later, which queues messages after the case released the queue mutex.",
      "include": "cancel_transfer",
      "with": {
        "collection": "domainNames",
        "id": "ex11-{random_name}.{tld}"
      }
    }
  ]
}
