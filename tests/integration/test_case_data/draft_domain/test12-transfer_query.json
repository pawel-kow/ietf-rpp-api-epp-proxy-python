{
  "when": {
    "profile.domainName.processes.transfer.operations": {
      "contains": "query"
    }
  },
  "comment": "Skipped on rri-mtest: RRI's transfer (CHPROV) is immediate, without a pending transfer to query, approve, cancel or reject.",
  "test_id": "test12-transfer_query",
  "exclusive": [
    "message_queue"
  ],
  "setup": [
    {
      "comment": "Creates contact HR12; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HR12}"
      }
    },
    {
      "comment": "Creates domain ex12 with authInfo, registrant HR12 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ex12-{random_name}.{tld}",
        "registrant_id": "{handle:a:HR12}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of domain ex12 with transferDir as registrar b; expects 201 01001. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ex12-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=QWJjMjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainTransferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "baz",
          "actClientId": "foo"
        },
        "headers": {
          "RPP-Code": "01001"
        }
      }
    },
    {
      "comment": "Queries the transfer of domain ex12; expects 200 01000. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/ex12-{random_name}.{tld}/processes/transferProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainTransferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "baz",
          "actClientId": "foo"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Cancels the transfer requested above as registrar b, the requester; expects 200 01000. A transfer left pending is approved by the server minutes later, which queues messages after the case released the queue mutex.",
      "include": "cancel_transfer",
      "with": {
        "collection": "domainNames",
        "id": "ex12-{random_name}.{tld}"
      }
    }
  ]
}
