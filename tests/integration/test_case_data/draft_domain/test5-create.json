                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "20166-6503"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+1.7035555555"
              },
              "fax": {
                "select": [
                  {
                    "when": {
                      "profile.contact.fax.supported": true
                    },
                    "then": {
                      "features": {
                        "fax": true
                      },
                      "number": "tel:+1.7035555556"
                    }
                  },
                  {
                    "omit": true
                  }
                ]
              }
            },
            "emails": {
