          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Example Dr., Suite 100"
                  },
                  {
                    "kind": "locality",
                    "value": "Dulles"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact.region.supported": true
                        },
