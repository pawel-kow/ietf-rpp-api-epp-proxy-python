    {
      "request": {
        "method": "POST",
        "url": {
          "select": [
            {
              "when": {
                "profile.domainName.authInfo.read_supported": true
              },
              "then": "/domainNames?includeElements=authInfo"
            },
            {
              "then": "/domainNames"
            }
          ]
        },
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "domainName",
          "name": "ex5-{random_name}.{tld}",
          "nameservers": [
            {
              "@type": "host",
              "hostName": "ns1.d5-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns2.d5-{random_name}.net"
            }
          ],
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:J5}"
          },
          "contacts": {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "admin"
                  }
                },
                "then": [
                  {
                    "label": "admin",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:S5}"
                    }
                  },
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:S5}"
                    }
                  }
                ]
              },
              {
                "then": [
                  {
                    "label": "generalRequest",
                    "object": {
                      "@type": "contact",
                      "id": "{gen_req:a}"
                    }
                  },
                  {
                    "label": "abuse",
                    "object": {
                      "@type": "contact",
                      "id": "{abuse:a}"
                    }
                  }
                ]
              }
            ]
          },
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "2feeBAR9"
          },
          "processes": {
            "@type": "processes",
            "createProcess": [
              {
                "@type": "domainCreateProcess",
                "period": {
                  "@type": "period",
                  "value": 2,
                  "unit": "y"
                }
              }
            ]
          }
        }
