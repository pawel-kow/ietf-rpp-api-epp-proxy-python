{
  "when": {
    "wait.domainName.processes.create.add_grace_period": true,
    "profile.domainName.processes.restore.report_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI's RESTORE is one step, without a restore report.",
  "test_id": "test18-restore_report",
  "setup": [
    {
      "comment": "Creates contact HR18; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HR18}"
      }
    },
    {
      "comment": "Creates domain ex18 with authInfo, registrant HR18 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ex18-{random_name}.{tld}",
        "registrant_id": "{handle:a:HR18}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes domain ex18; expects 200. The operation this case checks. Waits first for domainName.processes.create.add_grace_period.",
      "wait": "domainName.processes.create.add_grace_period",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/ex18-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    },
    {
      "comment": "Requests a restore of domain ex18; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ex18-{random_name}.{tld}/processes/restoreProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "restoreProcess",
          "restoreStatus": "pendingRestore"
        }
      }
    },
    {
      "comment": "Sends a restore report for domain ex18; expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/ex18-{random_name}.{tld}/processes/restoreProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess",
          "restoreReport": {
            "@type": "restoreReport",
            "preData": "Domain ex.example was registered on 2024-01-15 with registrant JD-1234.",
            "postData": "Domain ex.example is being restored with the same registration data.",
            "deleteTime": "2025-01-10T12:00:00.0Z",
            "restoreTime": "2025-01-20T15:30:00.0Z",
            "restoreReason": "Domain deleted in error by client operator.",
            "statements": [
              "The information in this report is true to the best of my knowledge.",
              "I have a valid reason for restoring this domain name."
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "restoreProcess",
          "restoreStatus": "restored"
        }
      }
    }
  ]
}
