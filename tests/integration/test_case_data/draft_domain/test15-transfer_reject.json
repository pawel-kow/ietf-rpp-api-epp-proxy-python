{
  "when": {"profile.domain_transfer_operations": {"contains": "reject"}},
  "test_id": "test15-transfer_reject",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "ex15-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/domainNames/ex15-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json",
          "RPP-Authorization": "authinfo value=UGFzc3dvcmQxIUA="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainTransferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "baz",
          "actClientId": "foo"
        },
        "headers": {
          "RPP-Code": "01001"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/domainNames/ex15-{random_name}.{tld}/processes/transferProcesses/latest/transferReject",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "reason": "Client rejected the transfer request."
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02102"
        }
      }
    }
  ]
}
