{
  "when": {
    "wait.domainName.processes.create.add_grace_period": true
  },
  "test_id": "test16-restore_request",
  "setup": [
    {
      "comment": "Creates contact HR16; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HR16}"
      }
    },
    {
      "comment": "Creates domain ex16 with authInfo, registrant HR16 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ex16-{random_name}.{tld}",
        "registrant_id": "{handle:a:HR16}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes domain ex16; expects 200. The operation this case checks. Waits first for domainName.processes.create.add_grace_period.",
      "wait": "domainName.processes.create.add_grace_period",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/ex16-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    },
    {
      "comment": "Requests a restore of domain ex16; expects 200. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ex16-{random_name}.{tld}/processes/restoreProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "restoreProcess",
          "restoreStatus": {
            "select": [
              {
                "when": {
                  "profile.domainName.processes.restore.report_supported": true
                },
                "then": "pendingRestore"
              },
              {
                "then": "restored"
              }
            ]
          }
        }
      }
    }
  ]
}
