{
  "when": {
    "wait.domainName.processes.create.add_grace_period": true
  },
  "test_id": "test19-restore_query",
  "setup": [
    {
      "comment": "Creates contact HR19; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HR19}"
      }
    },
    {
      "comment": "Creates domain ex19 with authInfo, registrant HR19 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ex19-{random_name}.{tld}",
        "registrant_id": "{handle:a:HR19}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes domain ex19; expects 200. The operation this case checks. Waits first for domainName.processes.create.add_grace_period.",
      "wait": "domainName.processes.create.add_grace_period",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/ex19-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    },
    {
      "comment": "Requests a restore of domain ex19; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ex19-{random_name}.{tld}/processes/restoreProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "restoreProcess",
          "restoreStatus": {
            "select": [
              {
                "when": {
                  "profile.domainName.processes.restore.report_supported": true
                },
                "then": "pendingRestore"
              },
              {
                "then": "restored"
              }
            ]
          }
        }
      }
    },
    {
      "comment": "Reads the restore process of domain ex19; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/ex19-{random_name}.{tld}/processes/restoreProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.domainName.processes.restore.report_supported": true
            },
            "then": {
              "status": 200,
              "content_type": "application/rpp+json",
              "body": {
                "@type": "restoreProcess",
                "restoreStatus": "pendingRestore"
              }
            }
          },
          {
            "then": {
              "status": 404,
              "content_type": "application/problem+json",
              "headers": {
                "RPP-Code": "02303"
              },
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
