{
  "when": {
    "profile.domainName.period.supported": true,
    "profile.domainName.processes.renew.supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no registration period (a domain runs until it is deleted); RRI has no renew.",
  "test_id": "test10-renew",
  "setup": [
    {
      "comment": "Creates contact HR10; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HR10}"
      }
    },
    {
      "comment": "Creates domain ex10 with authInfo, registrant HR10 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ex10-{random_name}.{tld}",
        "registrant_id": "{handle:a:HR10}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Renews domain ex10 with renewalPeriod; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ex10-{random_name}.{tld}/processes/renewProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "renewProcess",
          "renewalPeriod": {
            "@type": "period",
            "value": 5,
            "unit": "y"
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "renewProcess"
        },
        "fields": {
          "expiryDate": {
            "select": [
              {
                "when": {
                  "profile.domainName.period.supported": true
                },
                "then": {
                  "type": "datetime_format_utc_and_delta",
                  "reference": "{test_start}",
                  "min_delta": 189215940,
                  "max_delta": 189388860
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "RPP-Code": "01000",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        }
      }
    }
  ]
}
