{
  "test_id": "test10-renew",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "ex10-{random_name}.example",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/domainNames/ex10-{random_name}.example/processes/renewProcesses",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "renewProcess",
          "renewalPeriod": {
            "@type": "period",
            "value": 5,
            "unit": "y"
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "renewProcess"
        },
        "fields": {
          "expiryDate": {
            "type": "datetime_format_utc_and_delta",
            "reference": "{test_start}",
            "min_delta": 189215940,
            "max_delta": 189388860
          }
        },
        "headers": {
          "RPP-Code": "01000",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        }
      }
    }
  ]
}
