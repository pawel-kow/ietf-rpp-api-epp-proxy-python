        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:dt2}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "US"
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
