{
  "when": {
    "profile.domainName.authInfo.read_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI does not show a domain's authInfo (it holds only its hash), so the case cannot read it back.",
  "test_id": "test8-update",
  "setup": [
    {
      "comment": "Creates contact dt1 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:dt1}"
      }
    },
    {
      "comment": "Creates contact dt2 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:dt2}"
      }
    },
    {
      "comment": "Creates domain ex8 with registrant dt1, authInfo, dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ex8-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:dt1}"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain ex8 by a full update with registrant dt2, authInfo, dns records a (by backend) (includeElements=authInfo); expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": {
          "select": [
            {
              "when": {
                "profile.domainName.authInfo.read_supported": true
              },
              "then": "/domainNames/ex8-{random_name}.{tld}?includeElements=authInfo"
            },
            {
              "then": "/domainNames/ex8-{random_name}.{tld}"
            }
          ]
        },
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:dt2}"
          },
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "2BARfee9"
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:dt2}"
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.domainName.authInfo.read_supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "2BARfee9"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      }
    }
  ]
}
