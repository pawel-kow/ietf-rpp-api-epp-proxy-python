{
  "test_id": "test2-zone_records",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "aaaa"
    }
  },
  "comment": "Skipped on epp-docker: EPP has no address records of the domain itself, only ns, ds and dnskey.",
  "description": "Address records the registry serves itself are added by PATCH and read back.",
  "setup": [
    {
      "comment": "Creates contact L2 with authInfo (the request differs by backend); expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:L2}"
      }
    },
    {
      "comment": "Creates domain t2 with registrant L2, dns records a, authInfo (the request differs by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t2-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:L2}"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t2: add /dns/records; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t2-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "www",
              "type": "aaaa",
              "rdata": {
                "address": "2001:db8::1"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "www.t2-{random_name}.{tld}.",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ]
          }
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t2; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t2-{random_name}.{tld}"
      }
    }
  ]
}
