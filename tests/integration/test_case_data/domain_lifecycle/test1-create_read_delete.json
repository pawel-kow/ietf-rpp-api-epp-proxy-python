{
  "markers": [
    "smoke"
  ],
  "test_id": "test1-create_read_delete",
  "description": "A domain with what each backend requires is created, read and deleted.",
  "setup": [
    {
      "comment": "Creates contact L1 with authInfo (the request differs by backend); expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:L1}"
      }
    },
    {
      "comment": "Creates domain t1 with registrant L1, dns records a, authInfo (the request differs by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t1-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:L1}"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Reads domain t1; expects 200. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/domainNames/t1-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:L1}"
          }
        }
      }
    },
    {
      "comment": "Deletes domain t1; expects 200. The operation this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/t1-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    },
    {
      "comment": "Reads domain t1; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/t1-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "env.domainName.processes.delete.readable_after": true
            },
            "then": {
              "status": 200,
              "body": {
                "@type": "domainName",
                "status": [
                  {
                    "@type": "domainStatus",
                    "label": "pendingDelete"
                  }
                ],
                "provMetadata": {
                  "spClientId": "unknown"
                }
              }
            }
          },
          {
            "then": {
              "status": 404,
              "headers": {
                "RPP-Code": "02303"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
