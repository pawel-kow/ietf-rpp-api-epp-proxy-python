{
  "test_id": "test7-contact_update",
  "description": "A contact with a phone is created, changed by PATCH and read back.",
  "setup": [
    {
      "comment": "Creates contact L7 with authInfo (the request differs by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:L7}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact L7: replace /contactInfo/emails/email/address; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:L7}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contactInfo/emails/email/address",
            "value": "new@example.com"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "contactInfo": {
            "emails": {
              "email": {
                "address": "new@example.com"
              }
            }
          }
        }
      }
    },
    {
      "comment": "Reads contact L7; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:L7}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "contactInfo": {
            "emails": {
              "email": {
                "address": "new@example.com"
              }
            },
            "name": {
              "full": "Erika Mustermann"
            }
          },
          "status": [
            {
              "label": "ok"
            }
          ]
        }
      }
    },
    {
      "comment": "Checks whether contact L7 is available; expects 404. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:L7}/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "body": {
          "available": false
        }
      }
    }
  ]
}
