{
  "markers": [
    "smoke"
  ],
  "test_id": "test4-auth_info",
  "description": "A new authInfo is accepted by PATCH.",
  "setup": [
    {
      "comment": "Creates contact L4 with authInfo (the request differs by backend); expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:L4}"
      }
    },
    {
      "comment": "Creates domain t4 with registrant L4, dns records a, authInfo (the request differs by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t4-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:L4}"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t4: replace /authInfo; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t4-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/authInfo",
            "value": {
              "@type": "authInfo",
              "method": "authinfo",
              "authdata": "Abc2345678"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Reads domain t4 (includeElements=authInfo); expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/t4-{random_name}.{tld}?includeElements=authInfo",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.domainName.authInfo.read_supported": true
            },
            "then": {
              "status": 200,
              "body": {
                "authInfo": {
                  "authdata": "Abc2345678"
                }
              }
            }
          },
          {
            "then": {
              "status": 501,
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              },
              "headers": {
                "RPP-Code": "02102"
              }
            }
          }
        ]
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t4; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t4-{random_name}.{tld}"
      }
    }
  ]
}
