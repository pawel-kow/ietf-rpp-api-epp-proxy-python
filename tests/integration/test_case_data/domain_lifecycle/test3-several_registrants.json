{
  "test_id": "test3-several_registrants",
  "when": {
    "profile.domainName.registrant.max_count": {
      "min": 2
    }
  },
  "comment": "Skipped on epp-docker: EPP holds one registrant; several holders are RRI's.",
  "description": "Registrants after the first are contacts labelled registrant.",
  "setup": [
    {
      "comment": "Creates contact L3 with authInfo (the request differs by backend); expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:L3}"
      }
    },
    {
      "comment": "Creates contact L3B with authInfo (the request differs by backend); expects 201 01000. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:L3B}"
      }
    },
    {
      "comment": "Creates domain t3 with registrant L3, dns records a, authInfo (the request differs by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t3-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:L3}"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t3: add /contacts registrant; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t3-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "registrant",
              "object": {
                "@type": "contact",
                "id": "{handle:a:L3B}"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "registrant": {
            "id": "{handle:a:L3}"
          },
          "contacts": [
            {
              "label": "registrant",
              "object": {
                "@type": "contact",
                "id": "{handle:a:L3B}"
              }
            }
          ]
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t3; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t3-{random_name}.{tld}"
      }
    }
  ]
}
