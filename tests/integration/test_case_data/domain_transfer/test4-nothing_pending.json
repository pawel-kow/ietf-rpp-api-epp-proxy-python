{
  "test_id": "test4-nothing_pending",
  "setup": [
    {
      "comment": "Creates domain t4 with authInfo; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t4-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Queries the transfer of domain t4; expects 409 02301. An error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/domainNames/t4-{random_name}.{tld}/processes/transferProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02301"
        }
      }
    },
    {
      "comment": "Approves the pending transfer of domain t4; expects 409 02301. An error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/t4-{random_name}.{tld}/processes/transferProcesses/latest/transferApprove",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02301"
        }
      }
    },
    {
      "comment": "Rejects the pending transfer of domain t4; expects 409 02301. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/t4-{random_name}.{tld}/processes/transferProcesses/latest/transferReject",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02301"
        }
      }
    }
  ]
}
