{
  "test_id": "test10-push_not_supported",
  "setup": [
    {
      "comment": "Creates domain t10 with authInfo; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t10-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of domain t10 with transferDir, gainingClientId; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/t10-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "push",
          "gainingClientId": "baz"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02102"
        }
      }
    }
  ]
}
