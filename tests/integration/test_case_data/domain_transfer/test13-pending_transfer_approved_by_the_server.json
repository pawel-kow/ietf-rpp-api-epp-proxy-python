{
  "when": {
    "wait.domainName.processes.transfer.pending_period": true
  },
  "comment": "Skipped on rri-mtest: it waits for domainName.processes.transfer.pending_period, and the server has no such transition.",
  "test_id": "test13-pending_transfer_approved_by_the_server",
  "description": "A transfer nobody approves or rejects is approved by the server when its pending period ends, and the domain is the gaining registrar's.",
  "exclusive": [
    "message_queue"
  ],
  "setup": [
    {
      "comment": "Creates domain t13 with authInfo; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t13-{random_name}.{tld}",
        "authInfo": {
          "@type": "authInfo",
          "method": "authinfo",
          "authdata": "Password1!@"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of domain t13 with transferDir as registrar b; expects 201 01001. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/t13-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=UGFzc3dvcmQxIUA="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainTransferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "{regacc:b}",
          "actClientId": "{regacc:a}"
        },
        "headers": {
          "RPP-Code": "01001"
        }
      }
    },
    {
      "comment": "Reads domain t13 as registrar b; expects 200. Reads back to prove the change above. Waits first for domainName.processes.transfer.pending_period.",
      "wait": "domainName.processes.transfer.pending_period",
      "request": {
        "method": "GET",
        "url": "/domainNames/t13-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "provMetadata": {
            "spClientId": "{regacc:b}"
          }
        }
      }
    }
  ]
}
