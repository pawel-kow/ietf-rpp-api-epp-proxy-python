{
  "test_id": "test6-sponsor_requests",
  "setup": [
    {
      "comment": "Creates domain t6 with authInfo; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t6-{random_name}.{tld}",
        "authInfo": {
          "@type": "authInfo",
          "method": "authinfo",
          "authdata": "Password1!@"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of domain t6 with transferDir; expects 409 02106. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/t6-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=UGFzc3dvcmQxIUA="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02106"
        }
      }
    }
  ]
}
