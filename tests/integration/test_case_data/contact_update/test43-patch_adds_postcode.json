{
  "test_id": "test43-patch_adds_postcode",
  "when": {
    "env.contact.postcode.min_count": 0
  },
  "comment": "Skipped on rri-mtest: MTEST requires a postcode in an address.",
  "description": "A PATCH adds a postcode to an address without one.",
  "setup": [
    {
      "comment": "Creates contact P43 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P43}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "Erika Mustermann"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "Musterweg 12"
                },
                {
                  "kind": "locality",
                  "value": "Frankfurt am Main"
                }
              ],
              "countryCode": "DE"
            }
          },
          "emails": {
            "email": {
              "address": "erika@example.com"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.6912345678",
              "features": {
                "voice": true
              }
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P43: add /contactInfo/addresses/addr/components; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P43}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contactInfo/addresses/addr/components",
            "value": {
              "kind": "postcode",
              "value": "60596"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P43}",
          "contactInfo": {
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
