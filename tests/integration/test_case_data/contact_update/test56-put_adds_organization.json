{
  "test_id": "test56-put_adds_organization",
  "when": {
    "profile.contact.org.person_name_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI holds no person name on an organisation contact.",
  "description": "A PUT adds an organization.",
  "setup": [
    {
      "comment": "Creates contact P56 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P56}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces contact P56 by a full update; expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/contacts/{handle:a:P56}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "org",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            },
            "organizations": {
              "org": {
                "name": "ACME Inc."
              }
            }
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P56}",
          "contactInfo": {
            "organizations": {
              "org": {
                "name": "ACME Inc."
              }
            }
          }
        }
      }
    },
    {
      "comment": "Reads contact P56; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:P56}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P56}",
          "contactInfo": {
            "kind": "org",
            "organizations": {
              "org": {
                "name": "ACME Inc."
              }
            }
          }
        }
      }
    }
  ]
}
