{
  "test_id": "test48-put_removes_extension",
  "description": "A PUT with the number without its extension removes the extension.",
  "setup": [
    {
      "comment": "Creates contact P48 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P48}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "Erika Mustermann"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "Musterweg 12"
                },
                {
                  "kind": "locality",
                  "value": "Frankfurt am Main"
                },
                {
                  "kind": "postcode",
                  "value": "60596"
                }
              ],
              "countryCode": "DE"
            }
          },
          "emails": {
            "email": {
              "address": "erika@example.com"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.6912345678;ext=42",
              "features": {
                "voice": true
              }
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces contact P48 by a full update; expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/contacts/{handle:a:P48}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P48}",
          "contactInfo": {
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678"
              }
            }
          }
        }
      }
    }
  ]
}
