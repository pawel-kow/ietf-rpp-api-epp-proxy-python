              }
            }
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:01A}",
          "contactInfo": {
            "emails": {
              "email": {
                "address": "new@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.999"
              }
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Bonn"
                  },
                  {
                    "kind": "region",
                    "value": "NW"
                  },
