{
  "test_id": "test17-patch_email",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:17A}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact.region.supported": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "PA"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "12345"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.123123123"
              },
              "fax": {
                "select": [
                  {
                    "when": {
                      "profile.contact.fax.supported": true
                    },
                    "then": {
                      "number": "tel:+49.456456456",
                      "features": {
                        "fax": true
                      }
                    }
                  },
                  {
                    "omit": true
                  }
                ]
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:17A}"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:17A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contactInfo/emails/email/address",
            "value": "p@example.com"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:17A}",
          "contactInfo": {
            "emails": {
              "email": {
                "address": "p@example.com"
              }
            },
            "name": {
              "full": "John Doe"
            }
          }
        }
      }
    }
  ]
}
