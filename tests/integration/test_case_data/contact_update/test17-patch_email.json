{
  "markers": [
    "smoke"
  ],
  "test_id": "test17-patch_email",
  "setup": [
    {
      "comment": "Creates contact 17A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_full_contact",
      "with": {
        "id": "{handle:a:17A}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact 17A: replace /contactInfo/emails/email/address; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:17A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contactInfo/emails/email/address",
            "value": "p@example.com"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:17A}",
          "contactInfo": {
            "emails": {
              "email": {
                "address": "p@example.com"
              }
            },
            "name": {
              "full": "John Doe"
            }
          }
        }
      }
    }
  ]
}
