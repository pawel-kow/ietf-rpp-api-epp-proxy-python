{
  "when": {
    "profile.contact.authInfo.supported": true
  },
  "comment": "Skipped on rri-mtest: an RRI contact has no authInfo.",
  "test_id": "test23-patch_replace_auth_info",
  "setup": [
    {
      "comment": "Creates contact 23A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_full_contact",
      "with": {
        "id": "{handle:a:23A}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact 23A: replace /authInfo (includeElements=authInfo); expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:23A}?includeElements=authInfo",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/authInfo",
            "value": {
              "@type": "authInfo",
              "method": "authinfo",
              "authdata": "NewPass2+*x"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:23A}",
          "authInfo": {
            "authdata": "NewPass2+*x"
          }
        }
      }
    }
  ]
}
