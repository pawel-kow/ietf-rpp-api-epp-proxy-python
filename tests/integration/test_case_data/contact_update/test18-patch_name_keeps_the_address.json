{
  "test_id": "test18-patch_name_keeps_the_address",
  "setup": [
    {
      "comment": "Creates contact 18A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_full_contact",
      "with": {
        "id": "{handle:a:18A}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact 18A: replace /contactInfo/name/full; expects 422 02306. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:18A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contactInfo/name/full",
            "value": "Jane Doe"
          }
        ]
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.contact.name.changeable": false
            },
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02306"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          },
          {
            "then": {
              "status": 200,
              "headers": {
                "RPP-Code": "01000"
              },
              "content_type": "application/rpp+json",
              "body": {
                "@type": "contact",
                "id": "{handle:a:18A}",
                "contactInfo": {
                  "name": {
                    "full": "Jane Doe"
                  },
                  "addresses": {
                    "addr": {
                      "components": [
                        {
                          "kind": "name",
                          "value": "123 Main St"
                        },
                        {
                          "kind": "locality",
                          "value": "Anytown"
                        },
                        {
                          "select": [
                            {
                              "when": {
                                "profile.contact.region.supported": true
                              },
                              "then": {
                                "kind": "region",
                                "value": "PA"
                              }
                            },
                            {
                              "omit": true
                            }
                          ]
                        },
                        {
                          "kind": "postcode",
                          "value": "12345"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
