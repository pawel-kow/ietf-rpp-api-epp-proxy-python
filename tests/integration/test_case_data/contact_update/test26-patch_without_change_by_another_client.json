{
  "test_id": "test26-patch_without_change_by_another_client",
  "setup": [
    {
      "comment": "Creates contact 26A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_full_contact",
      "with": {
        "id": "{handle:a:26A}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact 26A: replace /contactInfo/emails/email/address as registrar b; expects 403 02201. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:26A}",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contactInfo/emails/email/address",
            "value": "foo@example.com"
          }
        ]
      },
      "response": {
        "status": 403,
        "headers": {
          "RPP-Code": "02201"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
