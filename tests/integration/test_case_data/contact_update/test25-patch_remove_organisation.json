{
  "when": {
    "profile.contact.org.person_name_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI holds no person name on an organisation contact.",
  "test_id": "test25-patch_remove_organisation",
  "setup": [
    {
      "comment": "Creates contact 25A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:25A}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "org",
          "name": {
            "select": [
              {
                "when": {
                  "profile.contact.org.person_name_supported": true
                },
                "then": {
                  "full": "John Doe"
                }
              },
              {
                "then": {
                  "full": "ACME Inc."
                }
              }
            ]
          },
          "organizations": {
            "org": {
              "name": "ACME Inc."
            }
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "123 Main St"
                },
                {
                  "kind": "locality",
                  "value": "Anytown"
                },
                {
                  "select": [
                    {
                      "when": {
                        "profile.contact.region.supported": true
                      },
                      "then": {
                        "kind": "region",
                        "value": "PA"
                      }
                    },
                    {
                      "omit": true
                    }
                  ]
                },
                {
                  "kind": "postcode",
                  "value": "12345"
                }
              ],
              "countryCode": "US"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.123123123"
            },
            "fax": {
              "select": [
                {
                  "when": {
                    "profile.contact.fax.supported": true
                  },
                  "then": {
                    "number": "tel:+49.456456456",
                    "features": {
                      "fax": true
                    }
                  }
                },
                {
                  "omit": true
                }
              ]
            }
          },
          "emails": {
            "email": {
              "address": "foo@example.com"
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact 25A: remove /contactInfo/organizations/org; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:25A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contactInfo/organizations/org"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:25A}",
          "contactInfo": {
            "kind": "individual",
            "name": {
              "full": "John Doe"
            }
          }
        }
      }
    },
    {
      "comment": "Patches contact 25A: remove /contactInfo/organizations/org; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:25A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contactInfo/organizations/org"
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
