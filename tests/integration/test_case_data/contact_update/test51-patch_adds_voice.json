{
  "test_id": "test51-patch_adds_voice",
  "when": {
    "profile.contact.phone.min_count": 0
  },
  "comment": "Skipped on rri-mtest: RRI requires a phone number.",
  "description": "A PATCH adds a voice number to a contact without one.",
  "setup": [
    {
      "comment": "Creates contact P51 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P51}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "Erika Mustermann"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "Musterweg 12"
                },
                {
                  "kind": "locality",
                  "value": "Frankfurt am Main"
                },
                {
                  "kind": "postcode",
                  "value": "60596"
                }
              ],
              "countryCode": "DE"
            }
          },
          "emails": {
            "email": {
              "address": "erika@example.com"
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P51: add /contactInfo/phones; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P51}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contactInfo/phones",
            "value": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P51}",
          "contactInfo": {
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678"
              }
            }
          }
        }
      }
    }
  ]
}
