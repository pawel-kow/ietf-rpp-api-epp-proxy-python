{
  "test_id": "test57-patch_changes_organization",
  "when": {
    "profile.contact.org.person_name_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI holds no person name on an organisation contact.",
  "description": "A PATCH changes the name of the organization.",
  "setup": [
    {
      "comment": "Creates contact P57 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P57}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "org",
          "name": {
            "full": "Erika Mustermann"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "Musterweg 12"
                },
                {
                  "kind": "locality",
                  "value": "Frankfurt am Main"
                },
                {
                  "kind": "postcode",
                  "value": "60596"
                }
              ],
              "countryCode": "DE"
            }
          },
          "emails": {
            "email": {
              "address": "erika@example.com"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.6912345678",
              "features": {
                "voice": true
              }
            }
          },
          "organizations": {
            "org": {
              "name": "ACME Inc."
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P57: replace /contactInfo/organizations/org/name; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P57}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contactInfo/organizations/org/name",
            "value": "Other Inc."
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P57}",
          "contactInfo": {
            "organizations": {
              "org": {
                "name": "Other Inc."
              }
            }
          }
        }
      }
    }
  ]
}
