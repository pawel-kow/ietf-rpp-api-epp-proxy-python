{
  "test_id": "test30-patch_disclose",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "FO-{random_id_10}30A",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "kind": "region",
                    "value": "PA"
                  },
                  {
                    "kind": "postcode",
                    "value": "12345"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.123123123"
              },
              "fax": {
                "number": "tel:+49.456456456",
                "features": {
                  "fax": true
                }
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            }
          },
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "FO-{random_id_10}30A"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/contacts/FO-{random_id_10}30A",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/disclose",
            "value": {
              "@type": "disclose"
            }
          }
        ]
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
