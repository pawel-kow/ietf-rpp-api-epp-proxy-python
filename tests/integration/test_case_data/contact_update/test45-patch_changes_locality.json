{
  "markers": [
    "smoke"
  ],
  "test_id": "test45-patch_changes_locality",
  "description": "A PATCH replaces the locality component.",
  "setup": [
    {
      "comment": "Creates contact P45 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P45}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P45: replace /contactInfo/addresses/addr/components with a match; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P45}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contactInfo/addresses/addr/components",
            "match": {
              "kind": "locality"
            },
            "value": {
              "kind": "locality",
              "value": "Offenbach"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P45}",
          "contactInfo": {
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Offenbach"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "comment": "Reads contact P45; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:P45}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P45}",
          "contactInfo": {
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Offenbach"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
