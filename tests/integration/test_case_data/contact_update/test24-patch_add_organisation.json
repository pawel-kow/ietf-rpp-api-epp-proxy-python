{
  "markers": [
    "smoke"
  ],
  "test_id": "test24-patch_add_organisation",
  "setup": [
    {
      "comment": "Creates contact 24A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_full_contact",
      "with": {
        "id": "{handle:a:24A}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact 24A: add /contactInfo/organizations; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:24A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contactInfo/organizations",
            "value": {
              "org": {
                "name": "ACME Inc."
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:24A}",
          "contactInfo": {
            "kind": {
              "select": [
                {
                  "when": {
                    "profile.contact.kind.supported": true
                  },
                  "then": "individual"
                },
                {
                  "then": "org"
                }
              ]
            },
            "organizations": {
              "org": {
                "name": "ACME Inc."
              }
            }
          }
        }
      }
    }
  ]
}
