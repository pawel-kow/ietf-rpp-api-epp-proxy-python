{
  "test_id": "test59-patch_read_only_member",
  "description": "A read-only member in a PATCH is refused (json §4.4).",
  "setup": [
    {
      "comment": "Creates contact P59 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P59}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P59: replace /provMetadata; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P59}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/provMetadata",
            "value": {
              "crDate": "2020-01-01T00:00:00Z"
            }
          }
        ]
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
