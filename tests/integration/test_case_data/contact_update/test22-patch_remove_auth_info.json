{
  "when": {
    "profile.contact.authInfo.supported": true
  },
  "comment": "Skipped on rri-mtest: an RRI contact has no authInfo.",
  "test_id": "test22-patch_remove_auth_info",
  "setup": [
    {
      "comment": "Creates contact 22A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_full_contact",
      "with": {
        "id": "{handle:a:22A}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact 22A: remove /authInfo; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:22A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/authInfo"
          }
        ]
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
