{
  "when": {
    "profile.contact.localization.supported": true
  },
  "comment": "Skipped on rri-mtest: RRI holds no localized form of a contact.",
  "test_id": "test34-patch_adding_a_localization_the_registry_ignores",
  "setup": [
    {
      "comment": "Creates contact 34A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:34A}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "John Doe"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "123 Main St"
                },
                {
                  "kind": "locality",
                  "value": "Anytown"
                },
                {
                  "kind": "region",
                  "value": "PA"
                },
                {
                  "kind": "postcode",
                  "value": "12345"
                }
              ],
              "countryCode": "US"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.123123123"
            },
            "fax": {
              "number": "tel:+49.456456456",
              "features": {
                "fax": true
              }
            }
          },
          "emails": {
            "email": {
              "address": "foo@example.com"
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact 34A: add /contactInfo/localizations; expects 500 02400. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:34A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contactInfo/localizations",
            "value": {
              "und": {
                "name": {
                  "full": "Jörg Müller"
                }
              }
            }
          }
        ]
      },
      "response": {
        "status": 500,
        "headers": {
          "RPP-Code": "02400"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
