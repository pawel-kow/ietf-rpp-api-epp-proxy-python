{
  "when": {
    "profile.contact.localization.supported": true
  },
  "comment": "Skipped on rri-mtest: RRI holds no localized form of a contact.",
  "test_id": "test8-put_changes_the_localization",
  "setup": [
    {
      "comment": "Creates contact 08A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:08A}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "John Doe"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "123 Main St"
                },
                {
                  "kind": "locality",
                  "value": "Anytown"
                },
                {
                  "kind": "region",
                  "value": "PA"
                },
                {
                  "kind": "postcode",
                  "value": "12345"
                }
              ],
              "countryCode": "US"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.123123123"
            },
            "fax": {
              "number": "tel:+49.456456456",
              "features": {
                "fax": true
              }
            }
          },
          "emails": {
            "email": {
              "address": "foo@example.com"
            }
          },
          "localizations": {
            "und": {
              "name": {
                "full": "Jörg Müller"
              }
            }
          }
        }
      }
    },
    {
      "comment": "Creates contact 08B with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:08B}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "John Doe"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "123 Main St"
                },
                {
                  "kind": "locality",
                  "value": "Anytown"
                },
                {
                  "kind": "region",
                  "value": "PA"
                },
                {
                  "kind": "postcode",
                  "value": "12345"
                }
              ],
              "countryCode": "US"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.123123123"
            },
            "fax": {
              "number": "tel:+49.456456456",
              "features": {
                "fax": true
