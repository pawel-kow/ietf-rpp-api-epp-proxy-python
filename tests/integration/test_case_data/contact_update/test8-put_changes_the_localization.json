              "addresses": {
                "addr": {
                  "components": [
                    {
                      "kind": "name",
                      "value": "123 Main St"
                    },
                    {
                      "kind": "locality",
                      "value": "Munich"
                    },
                    {
                      "kind": "region",
                      "value": "PA"
