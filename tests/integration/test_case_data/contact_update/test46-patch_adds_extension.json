{
  "test_id": "test46-patch_adds_extension",
  "description": "A PATCH sets a number with an extension.",
  "setup": [
    {
      "comment": "Creates contact P46 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P46}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P46: replace /contactInfo/phones/voice/number; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P46}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contactInfo/phones/voice/number",
            "value": "tel:+49.6912345678;ext=42"
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P46}",
          "contactInfo": {
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678;ext=42"
              }
            }
          }
        }
      }
    }
  ]
}
