{
  "when": {
    "profile.contact_localization": true
  },
  "test_id": "test32-patch_removes_the_localization",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:32A}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "kind": "region",
                    "value": "PA"
                  },
                  {
                    "kind": "postcode",
                    "value": "12345"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.123123123"
              },
              "fax": {
                "number": "tel:+49.456456456",
                "features": {
                  "fax": true
                }
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            },
            "localizations": {
              "und": {
                "name": {
                  "full": "Jörg Müller"
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact_auth_info": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:32A}"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:32A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contactInfo/localizations"
          }
        ]
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
