{
  "test_id": "test58-put_changes_name",
  "when": {
    "profile.contact.name.changeable": true
  },
  "comment": "Skipped on rri-mtest: RRI cannot change a contact's name.",
  "description": "A PUT changes the name.",
  "setup": [
    {
      "comment": "Creates contact P58 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P58}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces contact P58 by a full update; expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/contacts/{handle:a:P58}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Musterfrau"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P58}",
          "contactInfo": {
            "name": {
              "full": "Erika Musterfrau"
            }
          }
        }
      }
    },
    {
      "comment": "Reads contact P58; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:P58}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P58}",
          "contactInfo": {
            "name": {
              "full": "Erika Musterfrau"
            }
          }
        }
      }
    }
  ]
}
