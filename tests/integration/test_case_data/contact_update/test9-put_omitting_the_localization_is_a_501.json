{
  "when": {
    "profile.contact.localization.supported": true
  },
  "comment": "Skipped on rri-mtest: RRI holds no localized form of a contact.",
  "test_id": "test9-put_keeps_the_localization",
  "description": "A full update without the localization the contact has asks to remove it, which EPP cannot do: 501, see spec-issues.md (Full update of a contact).",
  "setup": [
    {
      "comment": "Creates contact 09A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:09A}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "John Doe"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "123 Main St"
                },
                {
                  "kind": "locality",
                  "value": "Anytown"
                },
                {
                  "kind": "region",
                  "value": "PA"
                },
                {
                  "kind": "postcode",
                  "value": "12345"
                }
              ],
              "countryCode": "US"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.123123123"
            },
            "fax": {
              "number": "tel:+49.456456456",
              "features": {
                "fax": true
              }
            }
          },
          "emails": {
            "email": {
              "address": "foo@example.com"
            }
          },
          "localizations": {
            "und": {
              "name": {
                "full": "Jörg Müller"
              }
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces contact 09A by a full update; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "PUT",
        "url": "/contacts/{handle:a:09A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Jane Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "kind": "region",
                    "value": "PA"
                  },
                  {
                    "kind": "postcode",
                    "value": "12345"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.123123123"
              },
              "fax": {
                "number": "tel:+49.456456456",
                "features": {
                  "fax": true
                }
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            }
          }
        }
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
