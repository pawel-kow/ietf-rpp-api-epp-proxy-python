{
  "when": {
    "profile.contact.kind.supported": true
  },
  "comment": "Skipped on epp-docker: an EPP contact has no kind (individual or organisation).",
  "test_id": "test35-individual_with_organisation_put_and_patch",
  "setup": [
    {
      "comment": "Creates contact 35A; expects 201 01000. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:35A}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "John Doe"
          },
          "organizations": {
            "org": {
              "name": "Example Inc."
            }
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "123 Example Dr., Suite 100"
                },
                {
                  "kind": "locality",
                  "value": "Dulles"
                },
                {
                  "kind": "postcode",
                  "value": "20166-6503"
                }
              ],
              "countryCode": "US"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+1.7035555555"
            }
          },
          "emails": {
            "email": {
              "address": "jdoe@example.example"
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces contact 35A by a full update; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/contacts/{handle:a:35A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "organizations": {
              "org": {
                "name": "Example GmbH"
              }
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Example Dr., Suite 100"
                  },
                  {
                    "kind": "locality",
                    "value": "Dulles"
                  },
                  {
                    "kind": "postcode",
                    "value": "20166-6503"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+1.7035555555"
              }
            },
            "emails": {
              "email": {
                "address": "jdoe@example.example"
              }
            }
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:35A}",
          "contactInfo": {
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "organizations": {
              "org": {
                "name": "Example GmbH"
              }
            }
          }
        }
      }
    },
    {
      "comment": "Patches contact 35A: replace /contactInfo/emails/email/address; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:35A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contactInfo/emails/email/address",
            "value": "jane@example.example"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:35A}",
          "contactInfo": {
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "organizations": {
              "org": {
                "name": "Example GmbH"
              }
            },
            "emails": {
              "email": {
                "address": "jane@example.example"
              }
            }
          }
        }
      }
    },
    {
      "comment": "Patches contact 35A: remove /contactInfo/organizations; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:35A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contactInfo/organizations"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:35A}",
          "contactInfo": {
            "kind": "individual",
            "name": {
              "full": "John Doe"
            }
          }
        }
      }
    },
    {
      "comment": "Reads contact 35A; expects 200 01000. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:35A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:35A}",
          "contactInfo": {
            "kind": "individual",
            "name": {
              "full": "John Doe"
            }
          }
        }
      }
    }
  ]
}
