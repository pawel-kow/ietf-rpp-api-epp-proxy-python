{
  "test_id": "test12-put_with_disclose",
  "setup": [
    {
      "comment": "Creates contact 12A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_full_contact",
      "with": {
        "id": "{handle:a:12A}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces contact 12A by a full update with disclose (the request differs by backend); expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "PUT",
        "url": "/contacts/{handle:a:12A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact.region.supported": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "PA"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "12345"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.123123123"
              },
              "fax": {
                "select": [
                  {
                    "when": {
                      "profile.contact.fax.supported": true
                    },
                    "then": {
                      "number": "tel:+49.456456456",
                      "features": {
                        "fax": true
                      }
                    }
                  },
                  {
                    "omit": true
                  }
                ]
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            }
          },
          "disclose": {
            "@type": "disclose"
          }
        }
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
