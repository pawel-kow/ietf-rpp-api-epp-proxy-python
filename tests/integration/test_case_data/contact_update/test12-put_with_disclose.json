{
  "test_id": "test12-put_with_disclose",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:12A}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact_region": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "PA"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "12345"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.123123123"
              },
              "fax": {
                "select": [
                  {
                    "when": {
                      "profile.contact_fax": true
                    },
                    "then": {
                      "number": "tel:+49.456456456",
                      "features": {
                        "fax": true
                      }
                    }
                  },
                  {
                    "omit": true
                  }
                ]
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact_auth_info": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:12A}"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "/contacts/{handle:a:12A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact_region": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "PA"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "12345"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.123123123"
              },
              "fax": {
                "select": [
                  {
                    "when": {
                      "profile.contact_fax": true
                    },
                    "then": {
                      "number": "tel:+49.456456456",
                      "features": {
                        "fax": true
                      }
                    }
                  },
                  {
                    "omit": true
                  }
                ]
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            }
          },
          "disclose": {
            "@type": "disclose"
          }
        }
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
