{
  "test_id": "test41-patch_adds_region",
  "when": {
    "profile.contact.region.supported": true
  },
  "comment": "Skipped on rri-mtest: an RRI address has no region.",
  "description": "A PATCH adds a region.",
  "setup": [
    {
      "comment": "Creates contact P41 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P41}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P41: add /contactInfo/addresses/addr/components; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P41}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contactInfo/addresses/addr/components",
            "value": {
              "kind": "region",
              "value": "Hessen"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P41}",
          "contactInfo": {
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "region",
                    "value": "Hessen"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
