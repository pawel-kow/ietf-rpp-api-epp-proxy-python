{
  "markers": [
    "smoke"
  ],
  "test_id": "test31-patch_adds_a_number",
  "setup": [
    {
      "comment": "Creates contact 31A with authInfo (by backend); expects 201 01000. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:31A}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "John Doe"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "123 Main St"
                },
                {
                  "kind": "locality",
                  "value": "Anytown"
                },
                {
                  "select": [
                    {
                      "when": {
                        "profile.contact.region.supported": true
                      },
                      "then": {
                        "kind": "region",
                        "value": "PA"
                      }
                    },
                    {
                      "omit": true
                    }
                  ]
                },
                {
                  "kind": "postcode",
                  "value": "12345"
                }
              ],
              "countryCode": "US"
            }
          },
          "emails": {
            "email": {
              "address": "foo@example.com"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.6912345678",
              "features": {
                "voice": true
              }
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact 31A: add /contactInfo/phones; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:31A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contactInfo/phones",
            "value": {
              "voice": {
                "number": "tel:+49.555555555"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:31A}",
          "contactInfo": {
            "phones": {
              "voice": {
                "number": "tel:+49.555555555"
              }
            }
          }
        }
      }
    }
  ]
}
