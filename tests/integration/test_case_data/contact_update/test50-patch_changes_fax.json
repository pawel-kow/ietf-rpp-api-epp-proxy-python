{
  "test_id": "test50-patch_changes_fax",
  "when": {
    "profile.contact.fax.supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no fax number.",
  "description": "A PATCH changes the fax number.",
  "setup": [
    {
      "comment": "Creates contact P50 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P50}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "Erika Mustermann"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "Musterweg 12"
                },
                {
                  "kind": "locality",
                  "value": "Frankfurt am Main"
                },
                {
                  "kind": "postcode",
                  "value": "60596"
                }
              ],
              "countryCode": "DE"
            }
          },
          "emails": {
            "email": {
              "address": "erika@example.com"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.6912345678",
              "features": {
                "voice": true
              }
            },
            "fax": {
              "number": "tel:+49.6987654321",
              "features": {
                "fax": true
              }
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P50: replace /contactInfo/phones/fax/number; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P50}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contactInfo/phones/fax/number",
            "value": "tel:+49.6911111111"
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P50}",
          "contactInfo": {
            "phones": {
              "fax": {
                "number": "tel:+49.6911111111"
              }
            }
          }
        }
      }
    }
  ]
}
