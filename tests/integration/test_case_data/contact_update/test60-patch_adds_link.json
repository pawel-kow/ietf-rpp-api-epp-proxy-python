{
  "test_id": "test60-patch_adds_link",
  "description": "EPP has no links (spec-issues): the proxy refuses them.",
  "setup": [
    {
      "comment": "Creates contact P60 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P60}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P60: add /contactInfo/links; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P60}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contactInfo/links",
            "value": {
              "url": {
                "@type": "Link",
                "uri": "https://example.com"
              }
            }
          }
        ]
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
