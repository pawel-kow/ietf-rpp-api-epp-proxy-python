{
  "when": [
    {
      "profile.contact.email.removable": false
    },
    {
      "env.contact.email.min_count": {
        "min": 1
      }
    }
  ],
  "test_id": "test21-patch_remove_email",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:21A}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "123 Main St"
                  },
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "select": [
                      {
                        "when": {
                          "profile.contact.region.supported": true
                        },
                        "then": {
                          "kind": "region",
                          "value": "PA"
                        }
                      },
                      {
                        "omit": true
                      }
                    ]
                  },
                  {
                    "kind": "postcode",
                    "value": "12345"
                  }
                ],
                "countryCode": "US"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.123123123"
              },
              "fax": {
                "select": [
                  {
                    "when": {
                      "profile.contact.fax.supported": true
                    },
                    "then": {
                      "number": "tel:+49.456456456",
                      "features": {
                        "fax": true
                      }
                    }
                  },
                  {
                    "omit": true
                  }
                ]
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:21A}"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:21A}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contactInfo/emails/email"
          }
        ]
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.contact.email.removable": false
            },
            "then": {
              "status": 501,
              "headers": {
                "RPP-Code": "02102"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          },
          {
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02306"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
