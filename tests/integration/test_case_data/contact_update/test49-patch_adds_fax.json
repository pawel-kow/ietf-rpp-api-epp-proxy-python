{
  "test_id": "test49-patch_adds_fax",
  "when": {
    "profile.contact.fax.supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no fax number.",
  "description": "A PATCH adds a fax number.",
  "setup": [
    {
      "comment": "Creates contact P49 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P49}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P49: add /contactInfo/phones/fax; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P49}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contactInfo/phones/fax",
            "value": {
              "number": "tel:+49.6987654321",
              "features": {
                "fax": true
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:P49}",
          "contactInfo": {
            "phones": {
              "fax": {
                "number": "tel:+49.6987654321"
              }
            }
          }
        }
      }
    }
  ]
}
