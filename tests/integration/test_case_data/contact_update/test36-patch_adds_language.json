{
  "test_id": "test36-patch_adds_language",
  "description": "The proxy takes language and stores none (spec-issues, Localization language).",
  "setup": [
    {
      "comment": "Creates contact P36 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P36}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P36: add /contactInfo/language; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P36}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contactInfo/language",
            "value": "de"
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact"
        }
      }
    }
  ]
}
