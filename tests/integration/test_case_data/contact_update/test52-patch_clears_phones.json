{
  "test_id": "test52-patch_clears_phones",
  "when": {
    "profile.contact.phone.min_count": 0,
    "profile.contact.fax.supported": true
  },
  "comment": "Skipped on rri-mtest: RRI requires a phone number; RRI has no fax number.",
  "description": "A PATCH removes every phone.",
  "setup": [
    {
      "comment": "Creates contact P52 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:P52}",
        "contactInfo": {
          "@type": "Card",
          "version": "2.0",
          "kind": "individual",
          "name": {
            "full": "Erika Mustermann"
          },
          "addresses": {
            "addr": {
              "components": [
                {
                  "kind": "name",
                  "value": "Musterweg 12"
                },
                {
                  "kind": "locality",
                  "value": "Frankfurt am Main"
                },
                {
                  "kind": "postcode",
                  "value": "60596"
                }
              ],
              "countryCode": "DE"
            }
          },
          "emails": {
            "email": {
              "address": "erika@example.com"
            }
          },
          "phones": {
            "voice": {
              "number": "tel:+49.6912345678",
              "features": {
                "voice": true
              }
            },
            "fax": {
              "number": "tel:+49.6987654321",
              "features": {
                "fax": true
              }
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact P52: remove /contactInfo/phones; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P52}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contactInfo/phones"
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "comment": "Patches contact P52: remove /contactInfo/phones/voice; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:P52}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contactInfo/phones/voice"
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
