{
  "when": {
    "profile.contact_localization": true
  },
  "test_id": "test20-non_ascii_localization",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:-20}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  }
                ],
                "countryCode": "US"
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            },
            "localizations": {
              "de": {
                "name": {
                  "full": "Jörg Müller"
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact_auth_info": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "contactInfo": {
            "localizations": {
              "und": {
                "name": {
                  "full": "Jörg Müller"
                }
              }
            }
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:-20}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "contactInfo": {
            "localizations": {
              "und": {
                "name": {
                  "full": "Jörg Müller"
                }
              }
            }
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
