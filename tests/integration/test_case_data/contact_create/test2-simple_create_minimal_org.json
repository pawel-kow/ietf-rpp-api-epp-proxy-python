{
  "test_id": "test2-simple_create_minimal_org",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": {
          "select": [
            {
              "when": {
                "profile.contact_auth_info": true
              },
              "then": "/contacts?includeElements=authInfo"
            },
            {
              "then": "/contacts"
            }
          ]
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:-02}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "org",
            "name": {
              "select": [
                {
                  "when": {
                    "profile.contact_org_person_name": true
                  },
                  "then": {
                    "full": "John Doe"
                  }
                },
                {
                  "then": {
                    "full": "ACME Inc."
                  }
                }
              ]
            },
            "organizations": {
              "org": {
                "name": "ACME Inc."
              }
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "US"
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact_auth_info": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:-02}",
          "status": [
            {
              "@type": "contactStatus",
              "label": "ok"
            }
          ],
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "org",
            "name": {
              "select": [
                {
                  "when": {
                    "profile.contact_org_person_name": true
                  },
                  "then": {
                    "full": "John Doe"
                  }
                },
                {
                  "then": {
                    "full": "ACME Inc."
                  }
                }
              ]
            },
            "organizations": {
              "org": {
                "name": "ACME Inc."
              }
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "US"
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678"
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact_auth_info": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          },
          "provMetadata.crDate": {
            "select": [
              {
                "when": {
                  "profile.metadata": {
                    "contains": "contact.crDate"
                  }
                },
                "then": {
                  "type": "datetime_format_utc_and_delta",
                  "reference": "{test_start}",
                  "min_delta": -1,
                  "max_delta": 60
                }
              },
              {
                "omit": true
              }
            ]
          },
          "provMetadata.crClientId": {
            "select": [
              {
                "when": {
                  "profile.metadata": {
                    "contains": "contact.crClientId"
                  }
                },
                "then": {
                  "type": "not_null"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "RPP-Cltrid": {
            "type": "not_empty_string"
          },
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
