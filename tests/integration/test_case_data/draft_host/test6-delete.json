{
  "test_id": "test6-delete",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "domainName",
          "name": "d6-{random_name}.example",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.d6-{random_name}.example"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "url": "/hosts/ns1.d6-{random_name}.example",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
