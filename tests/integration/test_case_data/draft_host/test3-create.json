{
  "test_id": "test3-create",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "domainName",
          "name": "d3-{random_name}.example",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.d3-{random_name}.example",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.d3-{random_name}.example."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.d3-{random_name}.example.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.d3-{random_name}.example.",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "host",
          "hostName": "ns1.d3-{random_name}.example",
          "status": [
            {
              "@type": "hostStatus",
              "label": "ok"
            }
          ],
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.d3-{random_name}.example."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.d3-{random_name}.example.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.d3-{random_name}.example.",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ]
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
