{
  "test_id": "test1-availability",
  "steps": [
    {
      "request": {
        "method": "GET",
        "url": "/hosts/ns1.d1-{random_name}.{tld}/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "hostAvailability",
          "available": true
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
