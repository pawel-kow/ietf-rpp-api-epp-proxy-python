{
  "test_id": "test5-update",
  "skip": "#49",
  "setup": [
    {
      "comment": "Creates domain d5 with authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "d5-{random_name}.{tld}"
      }
    },
    {
      "comment": "Creates host ns1.d5 with dns records ns, a; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "ns1.d5-{random_name}.{tld}",
        "dns": {
          "@type": "dnsData",
          "records": [
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ns",
              "rdata": {
                "nsdname": "ns1.d5-{random_name}.{tld}."
              }
            },
            {
              "@type": "dnsRecord",
              "name": "ns1.d5-{random_name}.{tld}.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.1"
              }
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces host ns1.d5 by a full update with dns records ns, a; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/hosts/ns1.d5-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.d5-{random_name}.{tld}",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.d5-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.d5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "198.51.100.1"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "host",
          "hostName": "ns1.d5-{random_name}.{tld}",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.d5-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.d5-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "198.51.100.1"
                }
              }
            ]
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
