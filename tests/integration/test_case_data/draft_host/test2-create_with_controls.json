{
  "test_id": "test2-create_with_controls",
  "setup": [
    {
      "comment": "Creates domain d2 with authInfo; expects 201 01000. The domain the steps below name.",
      "include": "create_domain",
      "with": {
        "name": "d2-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates host ns1.d2 with dns records ns, a, aaaa, dns controls; expects 501 02103. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.d2-{random_name}.{tld}",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.d2-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.d2-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.d2-{random_name}.{tld}.",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ],
            "controls": {
              "@type": "dnsControls",
              "ttl": {
                "a": 3600,
                "aaaa": 3600
              }
            }
          }
        }
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02103"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
