{
  "test_id": "test17-create_with_dnskey",
  "setup": [
    {
      "comment": "Creates contact HC17; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HC17}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t17 with authInfo, dns records dnskey, registrant HC17 (by backend); expects 422 02306. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "t17-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "dnskey",
                "rdata": {
                  "flags": "257",
                  "protocol": "3",
                  "algorithm": "8",
                  "publicKey": "AQPJ////4Q=="
                }
              }
            ]
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HC17}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02306"
        }
      }
    }
  ],
  "description": "A DNSKEY at create of a domain that takes DS records: a server supports one secDNS interface (RFC 5910 §4), and this one refuses the key data interface (env.secdns_key_data_interface)."
}
