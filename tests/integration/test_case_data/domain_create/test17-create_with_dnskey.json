{
  "when": {
    "profile.domain_record_types": {
      "contains": "ds"
    },
    "env.delegation_checked": false
  },
  "test_id": "test17-create_with_dnskey",
  "steps": [
    {
      "when": {
        "profile.registrant_required": true
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:HC17}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "t17-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "dnskey",
                "rdata": {
                  "flags": "257",
                  "protocol": "3",
                  "algorithm": "8",
                  "publicKey": "AQPJ////4Q=="
                }
              }
            ]
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.registrant_required": true
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HC17}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "any_of": [
          {
            "status": 422,
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            },
            "headers": {
              "RPP-Code": "02306"
            }
          },
          {
            "status": 201,
            "content_type": "application/rpp+json",
            "body": {
              "@type": "domainName",
              "dns": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "dnskey",
                    "rdata": {
                      "flags": "257",
                      "protocol": "3",
                      "algorithm": "8",
                      "publicKey": "AQPJ////4Q=="
                    }
                  }
                ]
              }
            },
            "headers": {
              "RPP-Code": "01000"
            }
          },
          {
            "status": 201,
            "content_type": "application/rpp+json",
            "body": {
              "@type": "domainName",
              "dns": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "ds",
                    "rdata": {
                      "algorithm": "8"
                    }
                  }
                ]
              }
            },
            "headers": {
              "RPP-Code": "01000"
            }
          },
          {
            "status": 201,
            "content_type": "application/rpp+json",
            "body": {
              "@type": "domainName",
              "dns": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "dnskey",
                    "rdata": {
                      "flags": "257",
                      "protocol": "3",
                      "algorithm": "8",
                      "publicKey": "AQPJ////4Q=="
                    }
                  },
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "ds",
                    "rdata": {
                      "algorithm": "8"
                    }
                  }
                ]
              }
            },
            "headers": {
              "RPP-Code": "01000"
            }
          }
        ]
      }
    }
  ]
}
