{
  "test_id": "test40-mx_record",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "mx"
    }
  },
  "comment": "Skipped on epp-docker: EPP has no MX records of the domain.",
  "description": "An MX record the registry serves itself, read back. MTEST needs the exchange to resolve.",
  "setup": [
    {
      "comment": "Creates contact V40 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:V40}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain gc40 with authInfo, registrant V40 (by backend), dns records a, mx; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "gc40-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:V40}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "mx",
                "rdata": {
                  "preference": "10",
                  "exchange": "mx1.denic.de."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Reads domain gc40; expects 200. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/domainNames/gc40-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "mx",
                "rdata": {
                  "preference": "10",
                  "exchange": "mx1.denic.de."
                }
              }
            ]
          }
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gc40; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gc40-{random_name}.{tld}"
      }
    }
  ]
}
