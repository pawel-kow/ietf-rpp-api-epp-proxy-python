{
  "when": {
    "env.domainName.contacts.foreign_supported": false
  },
  "test_id": "test42-registrant_of_another_registrar",
  "description": "A registrant of another registrar: the drafts leave it to server policy, the server refuses it (env.foreign_contacts_refused).",
  "setup": [
    {
      "comment": "Creates contact B42 of registrar b with authInfo (by backend) as registrar b; expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:B42}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain gc42 with authInfo, registrant B42 of registrar b, dns records a (by backend); expects 403 02201. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "gc42-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "@type": "contact",
            "id": "{handle:b:B42}"
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 403,
        "headers": {
          "RPP-Code": "02201"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
