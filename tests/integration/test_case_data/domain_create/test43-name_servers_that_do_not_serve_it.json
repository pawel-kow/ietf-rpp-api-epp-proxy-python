{
  "test_id": "test43-name_servers_that_do_not_serve_it",
  "when": {
    "env.domainName.processes.create.failed_dns_status": {
      "not": null
    }
  },
  "comment": "Skipped on epp-docker: the EPP test server does not check the name servers of a new domain.",
  "description": "A create whose name servers do not serve the domain succeeds where the registry checks them after the create, and the domain reads with the status of a failed check (RRI `failed`, with a `due`). Only for a registry that checks; every other case gives DNS data that passes.",
  "setup": [
    {
      "comment": "Creates contact G43 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:G43}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain dc43 with authInfo, registrant G43 (by backend), dns records 2 ns; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "dc43-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:G43}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.n43-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.n43-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.failed_dns_status}"
            }
          ]
        }
      }
    },
    {
      "comment": "Reads domain dc43; expects 200. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/domainNames/dc43-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "domainName",
          "name": "dc43-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.failed_dns_status}"
            }
          ]
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain dc43; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "dc43-{random_name}.{tld}"
      }
    }
  ]
}
