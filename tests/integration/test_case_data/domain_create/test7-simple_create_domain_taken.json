{
  "test_id": "test7-simple_create_domain_taken",
  "setup": [
    {
      "comment": "Creates contact HC7; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HC7}"
      }
    },
    {
      "comment": "Creates domain c7 with authInfo, registrant HC7 (by backend), dns records a (by backend); expects 201. The domain the steps below name.",
      "include": "create_domain",
      "with": {
        "name": "c7-{random_name}.{tld}",
        "registrant_id": "{handle:a:HC7}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain c7 with authInfo, registrant HC7 (by backend), dns records a (by backend), with a fixed RPP-Cltrid; expects 409 02302. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "c7-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HC7}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "test7-{random_name}-clTRID",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "test7-{random_name}-clTRID",
          "RPP-Code": "02302"
        }
      }
    }
  ]
}
