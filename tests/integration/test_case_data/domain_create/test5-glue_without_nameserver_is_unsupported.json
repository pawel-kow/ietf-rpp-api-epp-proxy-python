{
  "test_id": "test5-glue_without_nameserver_is_unsupported",
  "setup": [
    {
      "comment": "Creates contact HC5; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HC5}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain test5 with authInfo, dns records A, registrant HC5 (by backend); expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "test5-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "ns1.test5-{random_name}.{tld}.",
                "type": "A",
                "rdata": {
                  "address": "192.168.1.1"
                }
              }
            ]
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HC5}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.domainName.dns.record_types": {
                "contains": "a"
              }
            },
            "then": {
              "status": 201,
              "body": {
                "@type": "domainName"
              }
            }
          },
          {
            "then": {
              "status": 501,
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              },
              "headers": {
                "RPP-Code": "02102"
              }
            }
          }
        ]
      }
    }
  ],
  "description": "An address record for a name below the domain that is no nameserver: a record the registry serves itself where it holds those, otherwise unsupported.",
  "teardown": [
    {
      "comment": "Deletes domain test5; expects 200. MTEST keeps what a case creates, so the case deletes it. Only where a domain holds a records (rri-mtest).",
      "when": {
        "profile.domainName.dns.record_types": {
          "contains": "a"
        }
      },
      "include": "delete_domain",
      "with": {
        "name": "test5-{random_name}.{tld}"
      }
    }
  ]
}
