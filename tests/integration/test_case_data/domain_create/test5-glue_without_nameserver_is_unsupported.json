{
  "test_id": "test5-glue_without_nameserver_is_unsupported",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "test5-{random_name}.example",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "ns1.test5-{random_name}.example.",
                "type": "A",
                "rdata": {
                  "address": "192.168.1.1"
                }
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02102"
        }
      }
    }
  ]
}
