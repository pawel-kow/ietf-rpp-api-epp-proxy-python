{
  "test_id": "test39-max_sig_lifetime",
  "description": "The proxy does not map maxSigLifetime of secDNS (dns.controls).",
  "setup": [
    {
      "comment": "Creates contact V39 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:V39}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain gc39 with authInfo, registrant V39 (by backend), dns records a, dns controls (by backend); expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "gc39-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:V39}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ],
                  "controls": {
                    "@type": "dnsControls",
                    "maxSigLifetime": {
                      "ds": 604800
                    }
                  }
                }
              },
              {
                "then": {
                  "@type": "dnsData",
                  "records": [],
                  "controls": {
                    "@type": "dnsControls",
                    "maxSigLifetime": {
                      "ds": 604800
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
