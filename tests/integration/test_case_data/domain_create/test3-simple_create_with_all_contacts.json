{
  "test_id": "test3-simple_create_with_all_contacts",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:ca1}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  },
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "US"
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:ca1}"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": {
          "select": [
            {
              "when": {
                "profile.domainName.authInfo.read_supported": true
              },
              "then": "/domainNames?includeElements=authInfo"
            },
            {
              "then": "/domainNames"
            }
          ]
        },
        "body_json": {
          "@type": "domainName",
          "name": "test3-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:ca1}"
          },
          "contacts": {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "admin"
                  }
                },
                "then": [
                  {
                    "label": "admin",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ca1}"
                    }
                  },
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ca1}"
                    }
                  },
                  {
                    "label": "billing",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ca1}"
                    }
                  }
                ]
              },
              {
                "then": [
                  {
                    "label": "generalRequest",
                    "object": {
                      "@type": "contact",
                      "id": "{gen_req:a}"
                    }
                  },
                  {
                    "label": "abuse",
                    "object": {
                      "@type": "contact",
                      "id": "{abuse:a}"
                    }
                  }
                ]
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "TEST3-{random_name}.{tld}",
          "status": {
            "select": [
              {
                "when": {
                  "env.domainName.processes.create.active_at_once": true
                },
                "then": [
                  {
                    "@type": "domainStatus",
                    "label": "ok"
                  }
                ]
              },
              {
                "omit": true
              }
            ]
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.domainName.authInfo.read_supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:ca1}"
          },
          "contacts": {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "admin"
                  }
                },
                "then": [
                  {
                    "label": "admin",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ca1}"
                    }
                  },
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ca1}"
                    }
                  },
                  {
                    "label": "billing",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ca1}"
                    }
                  }
                ]
              },
              {
                "then": [
                  {
                    "label": "generalRequest",
                    "object": {
                      "@type": "contact",
                      "id": "{gen_req:a}"
                    }
                  },
                  {
                    "label": "abuse",
                    "object": {
                      "@type": "contact",
                      "id": "{abuse:a}"
                    }
                  }
                ]
              }
            ]
          }
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          },
          "provMetadata.crDate": {
            "select": [
              {
                "when": {
                  "profile.domainName.metadata": {
                    "contains": "crDate"
                  }
                },
                "then": {
                  "type": "datetime_format_utc_and_delta",
                  "reference": "{test_start}",
                  "min_delta": -1,
                  "max_delta": 60
                }
              },
              {
                "omit": true
              }
            ]
          },
          "provMetadata.crClientId": {
            "select": [
              {
                "when": {
                  "profile.domainName.metadata": {
                    "contains": "crClientId"
                  }
                },
                "then": {
                  "type": "not_null"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "expiryDate": {
            "select": [
              {
                "when": {
                  "profile.domainName.period.supported": true
                },
                "then": {
                  "type": "datetime_format_utc_and_delta",
                  "reference": "{test_start}",
                  "min_delta": 31449600,
                  "max_delta": 31622400
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "RPP-Cltrid": {
            "type": "not_empty_string"
          },
          "RPP-Svtrid": {
            "type": "not_empty_string"
          }
        }
      }
    }
  ]
}
