                  }
                ],
                "countryCode": "US"
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            }
          },
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "FO-{random_id_10}ca1"
