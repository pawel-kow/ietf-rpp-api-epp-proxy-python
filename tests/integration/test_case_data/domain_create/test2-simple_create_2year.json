{
  "test_id": "test2-simple_create_2year",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames?includeElements=authInfo",
        "body_json": {
          "@type": "domainName",
          "name": "test2-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          },
          "processes": {
            "@type": "processes",
            "createProcess": [
              {
                "@type": "domainCreateProcess",
                "period": {
                  "@type": "period",
                  "value": 2,
                  "unit": "y"
                }
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "TEST2-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "ok"
            }
          ],
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          },
          "provMetadata.crDate": {
            "type": "datetime_format_utc_and_delta",
            "reference": "{test_start}",
            "min_delta": -1,
            "max_delta": 60
          },
          "provMetadata.crClientId": {
            "type": "not_null"
          },
          "expiryDate": {
            "type": "datetime_format_utc_and_delta",
            "reference": "{test_start}",
            "min_delta": 62899200,
            "max_delta": 63244800
          }
        },
        "headers": {
          "RPP-Cltrid": {
            "type": "not_empty_string"
          },
          "RPP-Svtrid": {
            "type": "not_empty_string"
          }
        }
      }
    }
  ]
}
