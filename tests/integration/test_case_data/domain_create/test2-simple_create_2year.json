{
  "when": {
    "profile.domainName.period.supported": true
  },
  "test_id": "test2-simple_create_2year",
  "steps": [
    {
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:HC2}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": {
          "select": [
            {
              "when": {
                "profile.domainName.authInfo.read_supported": true
              },
              "then": "/domainNames?includeElements=authInfo"
            },
            {
              "then": "/domainNames"
            }
          ]
        },
        "body_json": {
          "@type": "domainName",
          "name": "test2-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "processes": {
            "@type": "processes",
            "createProcess": [
              {
                "@type": "domainCreateProcess",
                "period": {
                  "@type": "period",
                  "value": 2,
                  "unit": "y"
                }
              }
            ]
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HC2}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "TEST2-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.success_status}"
            }
          ],
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.domainName.authInfo.read_supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          },
          "provMetadata.crDate": {
            "select": [
              {
                "when": {
                  "profile.domainName.metadata": {
                    "contains": "crDate"
                  }
                },
                "then": {
                  "type": "datetime_format_utc_and_delta",
                  "reference": "{test_start}",
                  "min_delta": -1,
                  "max_delta": 60
                }
              },
              {
                "omit": true
              }
            ]
          },
          "provMetadata.crClientId": {
            "select": [
              {
                "when": {
                  "profile.domainName.metadata": {
                    "contains": "crClientId"
                  }
                },
                "then": {
                  "type": "not_null"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "expiryDate": {
            "select": [
              {
                "when": {
                  "profile.domainName.period.supported": true
                },
                "then": {
                  "type": "datetime_format_utc_and_delta",
                  "reference": "{test_start}",
                  "min_delta": 62899200,
                  "max_delta": 63244800
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "RPP-Cltrid": {
            "type": "not_empty_string"
          },
          "RPP-Svtrid": {
            "type": "not_empty_string"
          }
        }
      }
    }
  ]
}
