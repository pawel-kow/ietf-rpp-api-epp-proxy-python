{
  "test_id": "test31-lgr_on_ascii_name",
  "setup": [
    {
      "comment": "Creates contact HC31; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HC31}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain test31 with authInfo, lgr, registrant HC31 (by backend), dns records a (by backend); expects 201 01000. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "test31-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "lgr": "latn-1.0",
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HC31}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "env.domainName.name.lgr.ascii_supported": true
            },
            "then": {
              "status": 201,
              "headers": {
                "RPP-Code": "01000"
              },
              "body": {
                "@type": "domainName",
                "name": "test31-{random_name}.{tld}"
              }
            }
          },
          {
            "when": {
              "profile.lgrs": {
                "contains": "latn-1.0"
              }
            },
            "then": {
              "status": 422,
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              },
              "headers": {
                "RPP-Code": "02306"
              }
            }
          },
          {
            "then": {
              "status": 400,
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              },
              "headers": {
                "RPP-Code": "02001"
              }
            }
          }
        ]
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain test31; expects 200. MTEST keeps what a case creates, so the case deletes it. Only where the server takes an lgr on an ASCII name (rri-mtest).",
      "when": {
        "env.domainName.name.lgr.ascii_supported": true
      },
      "include": "delete_domain",
      "with": {
        "name": "test31-{random_name}.{tld}"
      }
    }
  ]
}
