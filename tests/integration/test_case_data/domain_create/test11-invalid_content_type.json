{
  "test_id": "test11-invalid_content_type",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "test11-{random_name}.example",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "headers": {
          "Content-Type": "application/epp+xml",
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 415,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        }
      }
    }
  ]
}
