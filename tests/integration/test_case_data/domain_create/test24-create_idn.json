{
  "markers": [
    "smoke"
  ],
  "when": {
    "profile.lgrs": {
      "contains": "latn-1.0"
    }
  },
  "test_id": "test24-create_idn",
  "setup": [
    {
      "comment": "Creates contact HC24; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HC24}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain IDN bücher-t24 with authInfo, uName, lgr, registrant HC24 (by backend), dns records a (by backend); expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "{alabel:bücher-t24}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "uName": "{ulabel:bücher-t24}.{tld}",
          "lgr": "latn-1.0",
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HC24}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "{alabel:bücher-t24}.{tld}",
          "uName": "{ulabel:bücher-t24}.{tld}",
          "lgr": "latn-1.0"
        }
      }
    }
  ]
}
