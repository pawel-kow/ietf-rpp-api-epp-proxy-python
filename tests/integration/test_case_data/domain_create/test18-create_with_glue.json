{
  "when": {
    "profile.host_objects": true,
    "env.delegation_checked": false
  },
  "test_id": "test18-create_with_glue",
  "steps": [
    {
      "when": {
        "profile.registrant_required": true
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:HC18}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "t18-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.t18-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.t18-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              }
            ]
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.registrant_required": true
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HC18}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "any_of": [
          {
            "status": 201,
            "content_type": "application/rpp+json",
            "body": {
              "@type": "domainName",
              "dns": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "ns",
                    "rdata": {
                      "nsdname": "ns1.t18-{random_name}.{tld}."
                    }
                  },
                  {
                    "@type": "dnsRecord",
                    "name": "ns1.t18-{random_name}.{tld}.",
                    "type": "a",
                    "rdata": {
                      "address": "192.0.2.1"
                    }
                  }
                ]
              }
            },
            "headers": {
              "RPP-Code": "01000"
            }
          },
          {
            "status": 201,
            "content_type": "application/rpp+json",
            "body": {
              "@type": "domainName",
              "nameservers": [
                {
                  "@type": "host",
                  "hostName": "ns1.t18-{random_name}.{tld}"
                }
              ],
              "subordinateHosts": [
                {
                  "@type": "host",
                  "hostName": "ns1.t18-{random_name}.{tld}"
                }
              ]
            },
            "fields": {
              "provMetadata.repositoryId": {
                "select": [
                  {
                    "when": {
                      "profile.metadata": {
                        "contains": "domainName.repositoryId"
                      }
                    },
                    "then": {
                      "type": "not_null"
                    }
                  },
                  {
                    "omit": true
                  }
                ]
              }
            },
            "headers": {
              "RPP-Code": "01000"
            }
          }
        ]
      }
    }
  ]
}
