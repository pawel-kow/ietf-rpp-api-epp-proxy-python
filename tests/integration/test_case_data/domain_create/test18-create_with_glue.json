{
  "test_id": "test18-create_with_glue",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "t18-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.t18-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.t18-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "any_of": [
          {
            "status": 201,
            "content_type": "application/rpp+json",
            "body": {
              "@type": "domainName",
              "dns": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "ns",
                    "rdata": {
                      "nsdname": "ns1.t18-{random_name}.{tld}."
                    }
                  },
                  {
                    "@type": "dnsRecord",
                    "name": "ns1.t18-{random_name}.{tld}.",
                    "type": "a",
                    "rdata": {
                      "address": "192.0.2.1"
                    }
                  }
                ]
              }
            },
            "headers": {
              "RPP-Code": "01000"
            }
          },
          {
            "status": 201,
            "content_type": "application/rpp+json",
            "body": {
              "@type": "domainName",
              "nameservers": [
                {
                  "@type": "host",
                  "hostName": "ns1.t18-{random_name}.{tld}"
                }
              ],
              "subordinateHosts": [
                {
                  "@type": "host",
                  "hostName": "ns1.t18-{random_name}.{tld}"
                }
              ]
            },
            "fields": {
              "provMetadata.repositoryId": {
                "type": "not_null"
              }
            },
            "headers": {
              "RPP-Code": "01000"
            }
          }
        ]
      }
    }
  ]
}
