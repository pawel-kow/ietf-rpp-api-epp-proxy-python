{
  "when": {
    "profile.objects": {
      "contains": "host"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain).",
  "test_id": "test18-create_with_glue",
  "setup": [
    {
      "comment": "Creates contact HC18; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HC18}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain t18 with authInfo, dns records ns, a, registrant HC18 (by backend); expects one of 201 01000. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "t18-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.t18-{random_name}.{tld}."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "ns1.t18-{random_name}.{tld}.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              }
            ]
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HC18}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "any_of": [
          {
            "status": 201,
            "content_type": "application/rpp+json",
            "body": {
              "@type": "domainName",
              "dns": {
                "@type": "dnsData",
                "records": [
                  {
                    "@type": "dnsRecord",
                    "name": "@",
                    "type": "ns",
                    "rdata": {
                      "nsdname": "ns1.t18-{random_name}.{tld}."
                    }
                  },
                  {
                    "@type": "dnsRecord",
                    "name": "ns1.t18-{random_name}.{tld}.",
                    "type": "a",
                    "rdata": {
                      "address": "192.0.2.1"
                    }
                  }
                ]
              }
            },
            "headers": {
              "RPP-Code": "01000"
            }
          },
          {
            "status": 201,
            "content_type": "application/rpp+json",
            "body": {
              "@type": "domainName",
              "nameservers": [
                {
                  "@type": "host",
                  "hostName": "ns1.t18-{random_name}.{tld}"
                }
              ],
              "subordinateHosts": [
                {
                  "@type": "host",
                  "hostName": "ns1.t18-{random_name}.{tld}"
                }
              ]
            },
            "fields": {
              "provMetadata.repositoryId": {
                "select": [
                  {
                    "when": {
                      "profile.domainName.metadata": {
                        "contains": "repositoryId"
                      }
                    },
                    "then": {
                      "type": "not_null"
                    }
                  },
                  {
                    "omit": true
                  }
                ]
              }
            },
            "headers": {
              "RPP-Code": "01000"
            }
          }
        ]
      }
    }
  ]
}
