{
  "when": {
    "profile.objects": {
      "contains": "host"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain).",
  "test_id": "test23-subordinate_host_on_read",
  "setup": [
    {
      "comment": "Creates contact HC23; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HC23}"
      }
    },
    {
      "comment": "Creates domain t23 with authInfo, registrant HC23 (by backend), dns records a (by backend); expects 201 01000. The domain the steps below name.",
      "include": "create_domain",
      "with": {
        "name": "t23-{random_name}.{tld}",
        "registrant_id": "{handle:a:HC23}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates host ns1.t23 with dns records ns; expects 201 01000. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.t23-{random_name}.{tld}",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.t23-{random_name}.{tld}."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "host"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Reads domain t23; expects 200 01000. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/domainNames/t23-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "subordinateHosts": [
            {
              "@type": "host",
              "hostName": "ns1.t23-{random_name}.{tld}"
            }
          ]
        },
        "fields": {
          "provMetadata.repositoryId": {
            "select": [
              {
                "when": {
                  "profile.domainName.metadata": {
                    "contains": "repositoryId"
                  }
                },
                "then": {
                  "type": "not_null"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
