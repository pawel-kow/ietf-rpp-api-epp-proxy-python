{
  "test_id": "test35-contact_that_does_not_exist",
  "description": "A contact that does not exist is refused by the registry.",
  "setup": [
    {
      "comment": "Creates contact V35 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:V35}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain gc35 with authInfo, registrant V35 (by backend), dns records a (by backend), contacts tech (by backend), abuse (by backend); expects one of 404 02303 or 409 02305 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "gc35-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:V35}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          },
          "contacts": {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "tech"
                  }
                },
                "then": [
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:N35}"
                    }
                  }
                ]
              },
              {
                "omit": true
              }
            ]
          },
          "abuse": {
            "select": [
              {
                "when": {
                  "profile.domainName.abuse.max_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "requestContact",
                  "id": "{handle:a:N35}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "any_of": [
          {
            "status": 404,
            "headers": {
              "RPP-Code": "02303"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 409,
            "headers": {
              "RPP-Code": "02305"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "headers": {
              "RPP-Code": "02306"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
