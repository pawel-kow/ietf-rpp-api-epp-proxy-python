{
  "when": {
    "wait.domainName.processes.create.failed_dns_period": true,
    "env.domainName.processes.create.failed_dns_status": {
      "not": null
    }
  },
  "comment": "Skipped on epp-docker: it waits for domainName.processes.create.failed_dns_period, and the server has no such transition; the EPP test server does not check the name servers of a new domain. Skipped on rri-mtest: it waits for domainName.processes.create.failed_dns_period, which needs 95040 s, the run waits at most 600 s (RPP_TEST_MAX_WAIT).",
  "test_id": "test44-failed_domain_deleted_by_the_registry",
  "description": "A domain whose name servers fail the registry's check, and that nobody fixes, is deleted by the registry when its failed period ends, into its redemption period (rri-5.0-reference §5.2: a failed domain must be fixed or is deleted). Not run yet: it needs RPP_TEST_MAX_WAIT of a day or more.",
  "setup": [
    {
      "comment": "Creates contact G44 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:G44}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain dc44 with authInfo, registrant G44 (by backend), dns records 2 ns; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "dc44-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:G44}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.n44-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.n44-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.failed_dns_status}"
            }
          ]
        }
      }
    },
    {
      "comment": "Reads domain dc44; expects 200. Reads what the steps above created. Waits first for domainName.processes.create.failed_dns_period.",
      "wait": "domainName.processes.create.failed_dns_period",
      "request": {
        "method": "GET",
        "url": "/domainNames/dc44-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "status": [
            {
              "@type": "domainStatus",
              "label": "pendingDelete"
            }
          ]
        }
      }
    }
  ]
}
