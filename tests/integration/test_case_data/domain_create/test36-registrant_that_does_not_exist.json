{
  "test_id": "test36-registrant_that_does_not_exist",
  "description": "A registrant that does not exist is refused by the registry.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "domainName",
          "name": "gc36-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:N36}"
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domain_dns_required": true
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "any_of": [
          {
            "status": 404,
            "headers": {
              "RPP-Code": "02303"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 409,
            "headers": {
              "RPP-Code": "02305"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "headers": {
              "RPP-Code": "02306"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
