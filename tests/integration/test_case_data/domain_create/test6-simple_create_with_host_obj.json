{
  "when": {
    "profile.host_objects": true
  },
  "test_id": "test6-simple_create_with_host_obj",
  "steps": [
    {
      "when": {
        "profile.registrant_required": true
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:HC6}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.c6-{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.c6-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "hostName": "ns1.c6-{random_name}.net"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns2.c6-{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.c6-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "hostName": "ns2.c6-{random_name}.net"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": {
          "select": [
            {
              "when": {
                "profile.auth_info_readable": true
              },
              "then": "/domainNames?includeElements=authInfo"
            },
            {
              "then": "/domainNames"
            }
          ]
        },
        "body_json": {
          "@type": "domainName",
          "name": "test6-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "ns1.c6-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns2.c6-{random_name}.net"
            }
          ],
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.registrant_required": true
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HC6}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "TEST6-{random_name}.{tld}",
          "status": {
            "select": [
              {
                "when": {
                  "env.domain_active_at_create": true
                },
                "then": [
                  {
                    "@type": "domainStatus",
                    "label": "ok"
                  }
                ]
              },
              {
                "omit": true
              }
            ]
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.auth_info_readable": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "{upper:ns1.c6-{random_name}.net}"
            },
            {
              "@type": "host",
              "hostName": "{upper:ns2.c6-{random_name}.net}"
            }
          ]
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          },
          "provMetadata.crDate": {
            "select": [
              {
                "when": {
                  "profile.metadata": {
                    "contains": "domainName.crDate"
                  }
                },
                "then": {
                  "type": "datetime_format_utc_and_delta",
                  "reference": "{test_start}",
                  "min_delta": -1,
                  "max_delta": 60
                }
              },
              {
                "omit": true
              }
            ]
          },
          "provMetadata.crClientId": {
            "select": [
              {
                "when": {
                  "profile.metadata": {
                    "contains": "domainName.crClientId"
                  }
                },
                "then": {
                  "type": "not_null"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "expiryDate": {
            "select": [
              {
                "when": {
                  "profile.registration_periods": true
                },
                "then": {
                  "type": "datetime_format_utc_and_delta",
                  "reference": "{test_start}",
                  "min_delta": 31449600,
                  "max_delta": 31622400
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "RPP-Cltrid": {
            "type": "not_empty_string"
          },
          "RPP-Svtrid": {
            "type": "not_empty_string"
          }
        }
      }
    }
  ]
}
