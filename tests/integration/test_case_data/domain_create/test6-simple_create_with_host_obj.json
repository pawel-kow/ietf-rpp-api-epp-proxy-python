{
  "when": {
    "profile.objects": {
      "contains": "host"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain).",
  "test_id": "test6-simple_create_with_host_obj",
  "setup": [
    {
      "comment": "Creates contact HC6; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HC6}"
      }
    },
    {
      "comment": "Creates host ns1.c6 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns1.c6-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns2.c6 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns2.c6-{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Creates domain test6 with authInfo, 2 nameservers, registrant HC6 (by backend) (includeElements=authInfo); expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": {
          "select": [
            {
              "when": {
                "profile.domainName.authInfo.read_supported": true
              },
              "then": "/domainNames?includeElements=authInfo"
            },
            {
              "then": "/domainNames"
            }
          ]
        },
        "body_json": {
          "@type": "domainName",
          "name": "test6-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "ns1.c6-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns2.c6-{random_name}.net"
            }
          ],
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HC6}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "TEST6-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.success_status}"
            }
          ],
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.domainName.authInfo.read_supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "{upper:ns1.c6-{random_name}.net}"
            },
            {
              "@type": "host",
              "hostName": "{upper:ns2.c6-{random_name}.net}"
            }
          ]
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          },
          "provMetadata.crDate": {
            "select": [
              {
                "when": {
                  "profile.domainName.metadata": {
                    "contains": "crDate"
                  }
                },
                "then": {
                  "type": "datetime_format_utc_and_delta",
                  "reference": "{test_start}",
                  "min_delta": -1,
                  "max_delta": 60
                }
              },
              {
                "omit": true
              }
            ]
          },
          "provMetadata.crClientId": {
            "select": [
              {
                "when": {
                  "profile.domainName.metadata": {
                    "contains": "crClientId"
                  }
                },
                "then": {
                  "type": "not_null"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "expiryDate": {
            "select": [
              {
                "when": {
                  "profile.domainName.period.supported": true
                },
                "then": {
                  "type": "datetime_format_utc_and_delta",
                  "reference": "{test_start}",
                  "min_delta": 31449600,
                  "max_delta": 31622400
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "RPP-Cltrid": {
            "type": "not_empty_string"
          },
          "RPP-Svtrid": {
            "type": "not_empty_string"
          }
        }
      }
    }
  ]
}
