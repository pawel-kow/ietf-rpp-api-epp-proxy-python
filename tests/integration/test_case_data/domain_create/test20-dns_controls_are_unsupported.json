{
  "test_id": "test20-dns_controls_are_unsupported",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "t20-{random_name}.example",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          },
          "dns": {
            "@type": "dnsData",
            "controls": {
              "@type": "dnsControls",
              "ttl": {
                "ds": 3600
              }
            }
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02102"
        }
      }
    }
  ]
}
