{
  "test_id": "test13-no-Auth",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "test13-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "RPP-Cltrid": "test13-{random_name}-clTRID",
          "Accept": "application/rpp+json"
        }
      },
      "response": {
        "status": 401,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "test13-{random_name}-clTRID"
        }
      }
    }
  ]
}
