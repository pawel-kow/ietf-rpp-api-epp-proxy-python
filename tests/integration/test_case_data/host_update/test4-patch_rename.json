{
  "test_id": "test4-patch_rename",
  "setup": [
    {
      "comment": "Creates domain t4 with authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t4-{random_name}.{tld}"
      }
    },
    {
      "comment": "Creates host ns1.t4 with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "ns1.t4-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host ns1.t4: replace /hostName; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/ns1.t4-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/hostName",
            "value": "ns2.t4-{random_name}.{tld}"
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "host",
          "hostName": "ns2.t4-{random_name}.{tld}"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Reads host ns1.t4; expects 404 02303. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/hosts/ns1.t4-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "headers": {
          "RPP-Code": "02303"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    },
    {
      "comment": "Reads host ns2.t4; expects 200 01000. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/hosts/ns2.t4-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    }
  ]
}
