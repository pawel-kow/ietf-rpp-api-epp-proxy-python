{
  "test_id": "test40-put_adds_aaaa_record",
  "description": "A PUT adds an aaaa record.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "hu40.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hu40.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "/hosts/hu40.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "hu40.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hu40.{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "hu40.{random_name}.net.",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hu40.{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "hu40.{random_name}.net.",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ]
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/hosts/hu40.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hu40.{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "hu40.{random_name}.net.",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
