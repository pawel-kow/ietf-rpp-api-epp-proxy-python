{
  "test_id": "test40-put_adds_aaaa_record",
  "description": "A PUT adds an aaaa record.",
  "setup": [
    {
      "comment": "Creates host hu40.….net with dns records ns; expects 201. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "hu40.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces host hu40.….net by a full update with dns records ns, aaaa; expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/hosts/hu40.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "hu40.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hu40.{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "hu40.{random_name}.net.",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hu40.{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "hu40.{random_name}.net.",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ]
          }
        }
      }
    },
    {
      "comment": "Reads host hu40.….net; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/hosts/hu40.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hu40.{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "hu40.{random_name}.net.",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
