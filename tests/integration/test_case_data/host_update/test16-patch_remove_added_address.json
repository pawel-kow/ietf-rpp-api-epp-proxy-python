{
  "test_id": "test16-patch_remove_added_address",
  "setup": [
    {
      "comment": "Creates host t16.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t16.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t16.….net: add /dns/records; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t16.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "t16.{random_name}.net.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.1"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Patches host t16.….net: add /dns/records; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t16.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "t16.{random_name}.net.",
              "type": "a",
              "rdata": {
                "address": "198.51.100.1"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Patches host t16.….net: remove /dns/records with a match; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t16.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/dns/records",
            "match": {
              "type": "a",
              "rdata": {
                "address": "192.0.2.1"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "host",
          "hostName": "t16.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t16.{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "t16.{random_name}.net.",
                "type": "a",
                "rdata": {
                  "address": "198.51.100.1"
                }
              }
            ]
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
