{
  "test_id": "test27-patch_remove_dns",
  "setup": [
    {
      "comment": "Creates host t27.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t27.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t27.….net: add /dns/records; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t27.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "a",
              "rdata": {
                "address": "192.0.2.1"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Patches host t27.….net: remove /dns; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t27.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/dns"
          }
        ]
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
