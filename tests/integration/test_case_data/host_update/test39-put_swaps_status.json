{
  "test_id": "test39-put_swaps_status",
  "description": "A PUT replaces one client status by another.",
  "setup": [
    {
      "comment": "Creates host hu39.….net with dns records ns; expects 201. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "hu39.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host hu39.….net: add /status clientDeleteProhibited; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu39.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Replaces host hu39.….net by a full update with dns records ns, status clientUpdateProhibited; expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/hosts/hu39.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "hu39.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hu39.{random_name}.net."
                }
              }
            ]
          },
          "status": [
            {
              "@type": "hostStatus",
              "label": "clientUpdateProhibited"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "status": [
            {
              "@type": "hostStatus",
              "label": "clientUpdateProhibited"
            }
          ]
        }
      }
    },
    {
      "comment": "Patches host hu39.….net: replace /status with a match clientDeleteProhibited; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu39.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/status",
            "match": {
              "label": "clientDeleteProhibited"
            },
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
