{
  "test_id": "test7-update_prohibited",
  "setup": [
    {
      "comment": "Creates host t7.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t7.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t7.….net: add /status clientUpdateProhibited; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t7.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientUpdateProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Patches host t7.….net: add /dns/records; expects 409 02304. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t7.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "t7.{random_name}.net.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.1"
              }
            }
          }
        ]
      },
      "response": {
        "status": 409,
        "headers": {
          "RPP-Code": "02304"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
