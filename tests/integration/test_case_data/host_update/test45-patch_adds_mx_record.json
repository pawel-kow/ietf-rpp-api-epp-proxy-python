{
  "test_id": "test45-patch_adds_mx_record",
  "description": "A host holds addresses only: an MX record is refused before any command.",
  "setup": [
    {
      "comment": "Creates host hu45.….net with dns records ns; expects 201. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "hu45.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host hu45.….net: add /dns/records; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu45.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "hu45.{random_name}.net.",
              "type": "mx",
              "rdata": {
                "preference": "10",
                "exchange": "mail.example."
              }
            }
          }
        ]
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
