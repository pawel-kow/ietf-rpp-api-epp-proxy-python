{
  "test_id": "test35-patch_replace_records_without_own_ns_record",
  "setup": [
    {
      "comment": "Creates host t35.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t35.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t35.….net: replace /dns/records; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t35.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "value": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              }
            ]
          }
        ]
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
