{
  "test_id": "test20-put_new_reason_on_a_set_status",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t20.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t20.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "host"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/hosts/t20.{random_name}.net",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited",
              "reason": "Requested by the registrant"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "host"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "/hosts/t20.{random_name}.net",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t20.{random_name}.net",
          "status": [
            {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited",
              "reason": "Another reason"
            }
          ],
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t20.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": [
            {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          ]
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
