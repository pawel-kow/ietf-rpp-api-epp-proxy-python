{
  "test_id": "test19-put_status_with_reason",
  "setup": [
    {
      "comment": "Creates host t19.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t19.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces host t19.….net by a full update with status clientDeleteProhibited, dns records ns; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/hosts/t19.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t19.{random_name}.net",
          "status": [
            {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited",
              "reason": "Requested by the registrant"
            }
          ],
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t19.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": [
            {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          ]
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
