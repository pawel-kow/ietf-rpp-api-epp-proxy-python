{
  "test_id": "test19-put_status_with_reason",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t19.{random_name}.net"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "host"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "/hosts/t19.{random_name}.net",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t19.{random_name}.net",
          "status": [
            {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited",
              "reason": "Requested by the registrant"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": [
            {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          ]
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
