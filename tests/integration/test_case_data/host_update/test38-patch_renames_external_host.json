{
  "test_id": "test38-patch_renames_external_host",
  "description": "A PATCH renames an external host (RFC 5732 host:chg).",
  "setup": [
    {
      "comment": "Creates host hu38.….net with dns records ns; expects 201. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "hu38.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host hu38.….net: replace /hostName; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu38.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/hostName",
            "value": "hv38.{random_name}.net"
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "hostName": "hv38.{random_name}.net"
        }
      }
    },
    {
      "comment": "Reads host hu38.….net; expects 404 02303. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/hosts/hu38.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "headers": {
          "RPP-Code": "02303"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Reads host hv38.….net; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/hosts/hv38.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "hostName": "hv38.{random_name}.net"
        }
      }
    }
  ]
}
