{
  "test_id": "test5-patch_empty",
  "setup": [
    {
      "comment": "Creates host t5.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t5.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t5.….net: ; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t5.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": []
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
