{
  "test_id": "test30-patch_no_change",
  "setup": [
    {
      "comment": "Creates host t30.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t30.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t30.….net: replace /status []; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t30.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/status",
            "value": []
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host",
          "status": [
            {
              "@type": "hostStatus",
              "label": "ok"
            }
          ]
        }
      }
    }
  ]
}
