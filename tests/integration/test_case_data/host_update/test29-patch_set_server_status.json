{
  "test_id": "test29-patch_set_server_status",
  "setup": [
    {
      "comment": "Creates host t29.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t29.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t29.….net: replace /status linked; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t29.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/status",
            "value": [
              {
                "@type": "hostStatus",
                "label": "linked"
              }
            ]
          }
        ]
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
