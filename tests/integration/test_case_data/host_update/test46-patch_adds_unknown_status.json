{
  "test_id": "test46-patch_adds_unknown_status",
  "description": "A status label the data objects do not define is refused.",
  "setup": [
    {
      "comment": "Creates host hu46.….net with dns records ns; expects 201. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "hu46.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host hu46.….net: add /status clientFrozen; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu46.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientFrozen"
            }
          }
        ]
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
