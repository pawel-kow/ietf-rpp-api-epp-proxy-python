{
  "test_id": "test8-patch_unknown_path",
  "setup": [
    {
      "comment": "Creates host t8.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t8.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t8.….net: replace /provMetadata; expects 400. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t8.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/provMetadata",
            "value": {}
          }
        ]
      },
      "response": {
        "status": 400,
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
