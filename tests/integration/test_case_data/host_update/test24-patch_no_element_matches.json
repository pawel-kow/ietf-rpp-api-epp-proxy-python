{
  "test_id": "test24-patch_no_element_matches",
  "setup": [
    {
      "comment": "Creates host t24.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t24.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t24.….net: replace /status with a match clientDeleteProhibited; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t24.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/status",
            "match": {
              "label": "clientDeleteProhibited"
            },
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
