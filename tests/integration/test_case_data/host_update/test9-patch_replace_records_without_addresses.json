{
  "test_id": "test9-patch_replace_records_without_addresses",
  "setup": [
    {
      "comment": "Creates host t9.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t9.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t9.….net: replace /dns/records; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t9.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "value": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t9.{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.9"
                }
              }
            ]
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host",
          "dns": {
            "records": [
              {
                "type": "ns",
                "@type": "dnsRecord",
                "name": "@"
              },
              {
                "type": "a",
                "rdata": {
                  "address": "192.0.2.9"
                },
                "@type": "dnsRecord",
                "name": "t9.{random_name}.net."
              }
            ]
          }
        }
      }
    }
  ]
}
