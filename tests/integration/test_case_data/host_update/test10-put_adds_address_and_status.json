{
  "test_id": "test10-put_adds_address_and_status",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t10.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t10.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "/hosts/t10.{random_name}.net",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t10.{random_name}.net",
          "status": [
            {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          ],
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t10.{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "t10.{random_name}.net.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "host",
          "hostName": "t10.{random_name}.net",
          "status": [
            {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          ],
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t10.{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "t10.{random_name}.net.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              }
            ]
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
