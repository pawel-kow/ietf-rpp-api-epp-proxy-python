{
  "test_id": "test18-patch_status_with_reason",
  "setup": [
    {
      "comment": "Creates host t18.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t18.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t18.….net: add /status clientDeleteProhibited; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t18.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited",
              "reason": "Requested by the registrant"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "status": [
            {
              "@type": "hostStatus",
              "label": "clientDeleteProhibited"
            }
          ]
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
