{
  "test_id": "test28-patch_controls_ttl",
  "setup": [
    {
      "comment": "Creates host t28.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t28.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t28.….net: replace /dns/controls; expects 501 02103. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t28.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/controls",
            "value": {
              "@type": "dnsControls",
              "ttl": {
                "a": 3600
              }
            }
          }
        ]
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02103"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
