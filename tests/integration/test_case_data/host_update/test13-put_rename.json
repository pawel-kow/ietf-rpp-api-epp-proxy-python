{
  "test_id": "test13-put_rename",
  "setup": [
    {
      "comment": "Creates domain t13 with authInfo; expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t13-{random_name}.{tld}"
      }
    },
    {
      "comment": "Creates host ns1.t13 with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "ns1.t13-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces host ns1.t13 by a full update with dns records ns; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/hosts/ns1.t13-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns2.t13-{random_name}.{tld}",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.t13-{random_name}.{tld}."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "host",
          "hostName": "ns2.t13-{random_name}.{tld}"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Reads host ns1.t13; expects 404 02303. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/hosts/ns1.t13-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "headers": {
          "RPP-Code": "02303"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
