{
  "test_id": "test26-patch_remove_records_by_partial_match",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t26.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t26.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/hosts/t26.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "a",
              "rdata": {
                "address": "192.0.2.1"
              }
            }
          },
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "aaaa",
              "rdata": {
                "address": "2001:db8::1"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/hosts/t26.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/dns/records",
            "match": {
              "type": "a"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host",
          "dns": {
            "records": [
              {
                "type": "ns",
                "@type": "dnsRecord",
                "name": "@"
              },
              {
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::1"
                },
                "@type": "dnsRecord",
                "name": "t26.{random_name}.net."
              }
            ]
          }
        }
      }
    }
  ]
}
