{
  "test_id": "test44-patch_clears_addresses",
  "description": "A PATCH that keeps only the own ns record removes every address.",
  "setup": [
    {
      "comment": "Creates host hu44.….net with dns records ns; expects 201. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "hu44.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host hu44.….net: add /dns/records; add /dns/records; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu44.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "hu44.{random_name}.net.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.1"
              }
            }
          },
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "hu44.{random_name}.net.",
              "type": "aaaa",
              "rdata": {
                "address": "2001:db8::1"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Patches host hu44.….net: replace /dns/records; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu44.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "value": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hu44.{random_name}.net."
                }
              }
            ]
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Patches host hu44.….net: replace /dns/records with a match; expects 422 02308. An error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu44.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "match": {
              "type": "a"
            },
            "value": {
              "@type": "dnsRecord",
              "name": "hu44.{random_name}.net.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.99"
              }
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Patches host hu44.….net: replace /dns/records with a match; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu44.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "match": {
              "type": "aaaa"
            },
            "value": {
              "@type": "dnsRecord",
              "name": "hu44.{random_name}.net.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.99"
              }
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
