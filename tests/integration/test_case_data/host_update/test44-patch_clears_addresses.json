{
  "test_id": "test44-patch_clears_addresses",
  "description": "A PATCH that keeps only the own ns record removes every address.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "hu44.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hu44.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu44.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "hu44.{random_name}.net.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.1"
              }
            }
          },
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "hu44.{random_name}.net.",
              "type": "aaaa",
              "rdata": {
                "address": "2001:db8::1"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu44.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "value": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "hu44.{random_name}.net."
                }
              }
            ]
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu44.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "match": {
              "type": "a"
            },
            "value": {
              "@type": "dnsRecord",
              "name": "hu44.{random_name}.net.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.99"
              }
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/hosts/hu44.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "match": {
              "type": "aaaa"
            },
            "value": {
              "@type": "dnsRecord",
              "name": "hu44.{random_name}.net.",
              "type": "a",
              "rdata": {
                "address": "192.0.2.99"
              }
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
