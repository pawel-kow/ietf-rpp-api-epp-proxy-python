{
  "test_id": "test15-put_no_change",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t15.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t15.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "/hosts/t15.{random_name}.net",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t15.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t15.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "hostName": "t15.{random_name}.net"
        }
      }
    }
  ],
  "description": "A full update that repeats the stored host sends no EPP update and answers 200 with the host (core §16.8), see spec-issues.md (Full update without a change)."
}
