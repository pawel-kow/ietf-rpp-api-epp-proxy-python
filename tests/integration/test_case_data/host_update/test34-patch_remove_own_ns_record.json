{
  "test_id": "test34-patch_remove_own_ns_record",
  "setup": [
    {
      "comment": "Creates host t34.….net with dns records ns; expects 201 01000. The host the steps below work on.",
      "include": "create_host",
      "with": {
        "name": "t34.{random_name}.net"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches host t34.….net: remove /dns/records with a match; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t34.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/dns/records",
            "match": {
              "type": "ns"
            }
          }
        ]
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
