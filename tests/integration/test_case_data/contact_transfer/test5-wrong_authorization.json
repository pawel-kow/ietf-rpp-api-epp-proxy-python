{
  "test_id": "test5-wrong_authorization",
  "setup": [
    {
      "comment": "Creates contact C5 with authInfo; expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:C5}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of contact C5 with transferDir as registrar b; expects 401 02202. An error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts/{handle:a:C5}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=d3Jvbmc="
        },
        "body_json": {
          "@type": "transferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 401,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02202"
        }
      }
    },
    {
      "comment": "Requests a transfer of contact C5 with transferDir as registrar b; expects 401 02202. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts/{handle:a:C5}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "transferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 401,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02202"
        }
      }
    }
  ]
}
