{
  "test_id": "test6-sponsor_requests",
  "setup": [
    {
      "comment": "Creates contact C6 with authInfo; expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:C6}",
        "authInfo": {
          "@type": "authInfo",
          "method": "authinfo",
          "authdata": "Password1!@"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of contact C6 with transferDir; expects 409 02106. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts/{handle:a:C6}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=UGFzc3dvcmQxIUA="
        },
        "body_json": {
          "@type": "transferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02106"
        }
      }
    }
  ]
}
