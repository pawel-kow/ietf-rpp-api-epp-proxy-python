{
  "when": {
    "wait.contact.processes.transfer.pending_period": true
  },
  "comment": "Skipped on rri-mtest: it waits for contact.processes.transfer.pending_period, and the server has no such transition.",
  "test_id": "test18-pending_transfer_approved_by_the_server",
  "description": "A contact transfer nobody approves or rejects is approved by the server when its pending period ends.",
  "exclusive": [
    "message_queue"
  ],
  "setup": [
    {
      "comment": "Creates contact C18 with authInfo; expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:C18}",
        "authInfo": {
          "@type": "authInfo",
          "method": "authinfo",
          "authdata": "Password1!@"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of contact C18 with transferDir as registrar b; expects 201 01001. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts/{handle:a:C18}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=UGFzc3dvcmQxIUA="
        },
        "body_json": {
          "@type": "transferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "transferProcess",
          "trStatus": "pending",
          "transferDir": "pull",
          "reqClientId": "{regacc:b}",
          "actClientId": "{regacc:a}"
        },
        "headers": {
          "RPP-Code": "01001"
        }
      }
    },
    {
      "comment": "Reads contact C18 as registrar b; expects 200. Reads back to prove the change above. Waits first for contact.processes.transfer.pending_period.",
      "wait": "contact.processes.transfer.pending_period",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:C18}",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "provMetadata": {
            "spClientId": "{regacc:b}"
          }
        }
      }
    }
  ]
}
