{
  "test_id": "test12-period_not_allowed",
  "setup": [
    {
      "comment": "Creates contact C12 with authInfo; expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:C12}",
        "authInfo": {
          "@type": "authInfo",
          "method": "authinfo",
          "authdata": "Password1!@"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a transfer of contact C12 with transferDir, transferPeriod as registrar b; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts/{handle:a:C12}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=UGFzc3dvcmQxIUA="
        },
        "body_json": {
          "@type": "transferProcess",
          "transferDir": "pull",
          "transferPeriod": {
            "@type": "period",
            "value": 1,
            "unit": "y"
          }
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02001"
        }
      }
    }
  ]
}
