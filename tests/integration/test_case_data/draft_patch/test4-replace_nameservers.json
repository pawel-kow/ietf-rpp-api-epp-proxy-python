{
  "test_id": "test4-replace_nameservers",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "domainName",
          "name": "ex4-{random_name}.example",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "2fooBAR"
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {}
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/ex4-{random_name}.example",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/nameservers",
            "value": [
              {
                "@type": "host",
                "hostName": "ns1.bar.example"
              },
              {
                "@type": "host",
                "hostName": "ns3.bar.example"
              }
            ]
          }
        ]
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error",
          "status": 501,
          "errors": [
            {
              "result": "02102"
            }
          ]
        },
        "headers": {
          "RPP-Code": "02102"
        }
      }
    }
  ]
}
