{
  "when": {
    "profile.objects": {
      "contains": "host"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain).",
  "test_id": "test4-replace_nameservers",
  "setup": [
    {
      "comment": "Creates contact HP4; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HP4}"
      }
    },
    {
      "comment": "Creates host ns1.p4 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns1.p4-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns2.p4 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns2.p4-{random_name}.net"
      }
    },
    {
      "comment": "Creates domain ex4 with authInfo, registrant HP4 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ex4-{random_name}.{tld}",
        "registrant_id": "{handle:a:HP4}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain ex4: add /nameservers; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/ex4-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns1.p4-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {}
      }
    },
    {
      "comment": "Patches domain ex4: replace /nameservers; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/ex4-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/nameservers",
            "value": [
              {
                "@type": "host",
                "hostName": "ns2.p4-{random_name}.net"
              }
            ]
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "ex4-{random_name}.{tld}",
          "nameservers": [
            {
              "@type": "host",
              "hostName": "{upper:ns2.p4-{random_name}.net}"
            }
          ]
        }
      }
    }
  ]
}
