{
  "when": {
    "profile.domainName.status.client_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no client statuses of a domain.",
  "test_id": "test2-replace_status",
  "setup": [
    {
      "comment": "Creates contact HP2; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HP2}"
      }
    },
    {
      "comment": "Creates domain ex2 with authInfo, registrant HP2 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ex2-{random_name}.{tld}",
        "registrant_id": "{handle:a:HP2}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain ex2: replace /status with a match clientUpdateProhibited; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/ex2-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/status",
            "match": {
              "label": "ok"
            },
            "value": {
              "@type": "domainStatus",
              "label": "clientUpdateProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "ex2-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "clientUpdateProhibited"
            }
          ]
        }
      }
    }
  ]
}
