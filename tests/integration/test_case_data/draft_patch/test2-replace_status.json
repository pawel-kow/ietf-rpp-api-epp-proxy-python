{
  "test_id": "test2-replace_status",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "domainName",
          "name": "ex2-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {}
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/ex2-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/status",
            "match": {
              "label": "ok"
            },
            "value": {
              "@type": "domainStatus",
              "label": "clientUpdateProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "ex2-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "clientUpdateProhibited"
            }
          ]
        }
      }
    }
  ]
}
