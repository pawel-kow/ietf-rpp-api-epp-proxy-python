{
  "test_id": "test46-patch_clears_nameservers",
  "when": {
    "profile.objects": {
      "contains": "host"
    },
    "profile.domainName.registrant.min_count": 0
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain); RRI requires a holder, so a domain cannot be without a registrant.",
  "description": "replace /nameservers [] removes every nameserver.",
  "setup": [
    {
      "comment": "Creates host ns1.gu46 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns1.gu46-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns2.gu46 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns2.gu46-{random_name}.net"
      }
    },
    {
      "comment": "Creates domain gu46 with authInfo, dns records a (by backend), 2 nameservers; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu46-{random_name}.{tld}",
        "nameservers": [
          {
            "@type": "host",
            "hostName": "ns1.gu46-{random_name}.net"
          },
          {
            "@type": "host",
            "hostName": "ns2.gu46-{random_name}.net"
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu46: replace /nameservers with a match; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu46-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/nameservers",
            "match": {
              "hostName": "{upper:ns1.gu46-{random_name}.net}"
            },
            "value": {
              "@type": "host",
              "hostName": "ns1.gu46-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Patches domain gu46: replace /nameservers []; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu46-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/nameservers",
            "value": []
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Patches domain gu46: replace /nameservers with a match; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu46-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/nameservers",
            "match": {
              "hostName": "{upper:ns1.gu46-{random_name}.net}"
            },
            "value": {
              "@type": "host",
              "hostName": "ns2.gu46-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu46; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu46-{random_name}.{tld}"
      }
    }
  ]
}
