{
  "test_id": "test41-put_swaps_status",
  "when": {
    "profile.domainName.status.client_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no client statuses of a domain.",
  "description": "A PUT replaces one client status by another.",
  "setup": [
    {
      "comment": "Creates contact R41 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R41}"
      }
    },
    {
      "comment": "Creates domain gu41 with authInfo, registrant R41 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu41-{random_name}.{tld}",
        "registrant_id": "{handle:a:R41}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu41: add /status clientHold; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu41-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "domainStatus",
              "label": "clientHold"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Replaces domain gu41 by a full update with status clientRenewProhibited; expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/gu41-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "status": [
            {
              "@type": "domainStatus",
              "label": "clientRenewProhibited"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "status": [
            {
              "@type": "domainStatus",
              "label": "clientRenewProhibited"
            }
          ]
        }
      }
    },
    {
      "comment": "Patches domain gu41: remove /status with a match; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu41-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/status",
            "match": {
              "label": "clientHold"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu41; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu41-{random_name}.{tld}"
      }
    }
  ]
}
