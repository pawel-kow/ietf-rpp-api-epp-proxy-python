{
  "when": {
    "profile.objects": {
      "contains": "host"
    },
    "profile.domainName.contacts.labels": {
      "contains": "admin"
    },
    "profile.contact.authInfo.supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain); RRI has no admin, tech or billing contacts; an RRI contact has no authInfo.",
  "test_id": "test1-simple_update",
  "setup": [
    {
      "comment": "Creates contact HU1; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU1}"
      }
    },
    {
      "comment": "Creates contact ud1 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:ud1}"
      }
    },
    {
      "comment": "Creates contact ud2 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:ud2}"
      }
    },
    {
      "comment": "Creates contact ud3 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:ud3}"
      }
    },
    {
      "comment": "Creates host ns1.u1 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns1.u1-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns2.u1 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns2.u1-{random_name}.net"
      }
    },
    {
      "comment": "Creates domain up-test1 with authInfo, registrant HU1 (by backend), dns records a (by backend); expects 201. A nameserver of the domain below.",
      "include": "create_domain",
      "with": {
        "name": "up-test1-{random_name}.{tld}",
        "registrant_id": "{handle:a:HU1}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain up-test1: replace /authInfo; add /nameservers; add /nameservers; replace /registrant; 4 more (includeElements=authInfo) (the request differs by backend); expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": {
          "select": [
            {
              "when": {
                "profile.domainName.authInfo.read_supported": true
              },
              "then": "/domainNames/up-test1-{random_name}.{tld}?includeElements=authInfo"
            },
            {
              "then": "/domainNames/up-test1-{random_name}.{tld}"
            }
          ]
        },
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/authInfo",
            "value": {
              "@type": "authInfo",
              "method": "authinfo",
              "authdata": "NewAbc2345678"
            }
          },
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns1.u1-{random_name}.net"
            }
          },
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns2.u1-{random_name}.net"
            }
          },
          {
            "op": "replace",
            "path": "/registrant",
            "value": {
              "@type": "contact",
              "id": "{handle:a:ud2}"
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:ud2}"
              }
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "admin",
              "object": {
                "@type": "contact",
                "id": "{handle:a:ud2}"
              }
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "admin",
              "object": {
                "@type": "contact",
                "id": "{handle:a:ud1}"
              }
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "billing",
              "object": {
                "@type": "contact",
                "id": "{handle:a:ud1}"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test1-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.success_status}"
            }
          ],
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.domainName.authInfo.read_supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "NewAbc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "{upper:ns1.u1-{random_name}.net}"
            },
            {
              "@type": "host",
              "hostName": "{upper:ns2.u1-{random_name}.net}"
            }
          ],
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:ud2}"
          },
          "contacts": {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "admin"
                  }
                },
                "then": [
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ud2}"
                    }
                  },
                  {
                    "label": "admin",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ud2}"
                    }
                  },
                  {
                    "label": "admin",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ud1}"
                    }
                  },
                  {
                    "label": "billing",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ud1}"
                    }
                  }
                ]
              },
              {
                "omit": true
              }
            ]
          }
        }
      }
    },
    {
      "comment": "Patches domain up-test1: replace /authInfo; remove /nameservers with a match; remove /contacts with a match; remove /contacts with a match; 5 more (includeElements=authInfo) (the request differs by backend); expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": {
          "select": [
            {
              "when": {
                "profile.domainName.authInfo.read_supported": true
              },
              "then": "/domainNames/up-test1-{random_name}.{tld}?includeElements=authInfo"
            },
            {
              "then": "/domainNames/up-test1-{random_name}.{tld}"
            }
          ]
        },
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/authInfo",
            "value": {
              "@type": "authInfo",
              "method": "authinfo",
              "authdata": "NewPass6789+"
            }
          },
          {
            "op": "remove",
            "path": "/nameservers",
            "match": {
              "hostName": "ns1.u1-{random_name}.net"
            }
          },
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:ud2}"
              }
            }
          },
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "admin",
              "object": {
                "@type": "contact",
                "id": "{handle:a:ud2}"
              }
            }
          },
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "billing",
              "object": {
                "@type": "contact",
                "id": "{handle:a:ud1}"
              }
            }
          },
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns1.up-test1-{random_name}.{tld}"
            }
          },
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns2.up-test1-{random_name}.{tld}"
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:ud3}"
              }
            }
          },
          {
            "op": "replace",
            "path": "/registrant",
            "value": {
              "@type": "contact",
              "id": "{handle:a:ud3}"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "UP-TEST1-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.success_status}"
            }
          ],
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.domainName.authInfo.read_supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "NewPass6789+"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "{upper:ns2.u1-{random_name}.net}"
            },
            {
              "@type": "host",
              "hostName": "ns1.up-test1-{random_name}.{tld}"
            },
            {
              "@type": "host",
              "hostName": "ns2.up-test1-{random_name}.{tld}"
            }
          ],
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:ud3}"
          },
          "contacts": {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "admin"
                  }
                },
                "then": [
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ud3}"
                    }
                  },
                  {
                    "label": "admin",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:ud1}"
                    }
                  }
                ]
              },
              {
                "omit": true
              }
            ]
          }
        }
      }
    }
  ]
}
