{
  "test_id": "test1-simple_update",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "up-test1-{random_name}.example",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test1-{random_name}.example",
          "status": [
            {
              "@type": "domainStatus",
              "label": "ok"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test1-{random_name}.example?includeElements=authInfo",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/authInfo",
            "value": {
              "@type": "authInfo",
              "method": "authinfo",
              "authdata": "NewPassword1!@"
            }
          },
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns1.bar.example"
            }
          },
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns2.bar.example"
            }
          },
          {
            "op": "replace",
            "path": "/registrant",
            "value": {
              "@type": "contact",
              "id": "FO-TEST2"
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "FO-TEST2"
              }
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "admin",
              "object": {
                "@type": "contact",
                "id": "FO-TEST2"
              }
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "admin",
              "object": {
                "@type": "contact",
                "id": "FO-TEST1"
              }
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "billing",
              "object": {
                "@type": "contact",
                "id": "FO-TEST1"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test1-{random_name}.example",
          "status": [
            {
              "@type": "domainStatus",
              "label": "ok"
            }
          ],
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "NewPassword1!@"
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "NS1.BAR.EXAMPLE"
            },
            {
              "@type": "host",
              "hostName": "NS2.BAR.EXAMPLE"
            }
          ],
          "registrant": {
            "@type": "contact",
            "id": "FO-TEST2"
          },
          "contacts": [
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "FO-TEST2"
              }
            },
            {
              "label": "admin",
              "object": {
                "@type": "contact",
                "id": "FO-TEST2"
              }
            },
            {
              "label": "admin",
              "object": {
                "@type": "contact",
                "id": "FO-TEST1"
              }
            },
            {
              "label": "billing",
              "object": {
                "@type": "contact",
                "id": "FO-TEST1"
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test1-{random_name}.example?includeElements=authInfo",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/authInfo",
            "value": {
              "@type": "authInfo",
              "method": "authinfo",
              "authdata": "NewPassword2!@"
            }
          },
          {
            "op": "remove",
            "path": "/nameservers",
            "match": {
              "hostName": "ns1.bar.example"
            }
          },
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "FO-TEST2"
              }
            }
          },
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "admin",
              "object": {
                "@type": "contact",
                "id": "FO-TEST2"
              }
            }
          },
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "billing",
              "object": {
                "@type": "contact",
                "id": "FO-TEST1"
              }
            }
          },
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns1.up-test1-{random_name}.example"
            }
          },
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns2.up-test1-{random_name}.example"
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "FO-TEST3"
              }
            }
          },
          {
            "op": "replace",
            "path": "/registrant",
            "value": {
              "@type": "contact",
              "id": "FO-TEST3"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "UP-TEST1-{random_name}.EXAMPLE",
          "status": [
            {
              "@type": "domainStatus",
              "label": "ok"
            }
          ],
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "NewPassword2!@"
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "NS2.BAR.EXAMPLE"
            },
            {
              "@type": "host",
              "hostName": "ns1.up-test1-{random_name}.example"
            },
            {
              "@type": "host",
              "hostName": "ns2.up-test1-{random_name}.example"
            }
          ],
          "registrant": {
            "@type": "contact",
            "id": "FO-TEST3"
          },
          "contacts": [
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "FO-TEST3"
              }
            },
            {
