{
  "test_id": "test47-patch_adds_ns_record",
  "when": {
    "profile.objects": {
      "contains": "host"
    },
    "profile.domainName.registrant.min_count": 0
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain); RRI requires a holder, so a domain cannot be without a registrant.",
  "skip": "pawel-kow/epp#33",
  "description": "ns records added by PATCH to a domain without delegation; the registry keeps them as host objects.",
  "setup": [
    {
      "comment": "Creates host ns1.gu47 with dns records ns; expects 201. The host the steps below name.",
      "include": "create_host",
      "with": {
        "name": "ns1.gu47-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns2.gu47 with dns records ns; expects 201. The host the steps below name.",
      "include": "create_host",
      "with": {
        "name": "ns2.gu47-{random_name}.net"
      }
    },
    {
      "comment": "Creates domain gu47 with authInfo, dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu47-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu47: add /dns/records; add /dns/records; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu47-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ns",
              "rdata": {
                "nsdname": "ns1.gu47-{random_name}.net."
              }
            }
          },
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ns",
              "rdata": {
                "nsdname": "ns2.gu47-{random_name}.net."
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Reads domain gu47; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/gu47-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "nameservers": [
            {
              "hostName": "ns1.gu47-{random_name}.net"
            },
            {
              "hostName": "ns2.gu47-{random_name}.net"
            }
          ]
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu47; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu47-{random_name}.{tld}"
      }
    }
  ]
}
