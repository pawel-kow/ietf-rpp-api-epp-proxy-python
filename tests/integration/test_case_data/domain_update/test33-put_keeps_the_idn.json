{
  "markers": [
    "smoke"
  ],
  "when": {
    "profile.lgrs": {
      "contains": "latn-1.0"
    }
  },
  "test_id": "test33-put_keeps_the_idn",
  "setup": [
    {
      "comment": "Creates contact HU33; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU33}"
      }
    },
    {
      "comment": "Creates domain IDN bücher-u33 with authInfo, uName, lgr, registrant HU33 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "{alabel:bücher-u33}.{tld}",
        "uName": "{ulabel:bücher-u33}.{tld}",
        "lgr": "latn-1.0",
        "registrant_id": "{handle:a:HU33}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain IDN bücher-u33 by a full update with registrant HU33 (by backend), dns records a (by backend); expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/{alabel:bücher-u33}.{tld}",
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU33}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "{alabel:bücher-u33}.{tld}",
          "uName": "{ulabel:bücher-u33}.{tld}",
          "lgr": "latn-1.0"
        }
      }
    }
  ]
}
