    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test11-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contacts",
            "match": {
              "label": "tech"
            },
            "value": {
              "label": "billing",
              "object": {
                "@type": "contact",
                "id": "{handle:a:uj1}"
              }
            }
          }
        ]
      },
