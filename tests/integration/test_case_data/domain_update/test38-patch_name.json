{
  "test_id": "test38-patch_name",
  "description": "The name is create-only: a PATCH of it is refused.",
  "setup": [
    {
      "comment": "Creates contact R38 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R38}"
      }
    },
    {
      "comment": "Creates domain gu38 with authInfo, registrant R38 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu38-{random_name}.{tld}",
        "registrant_id": "{handle:a:R38}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu38: replace /name; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu38-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/name",
            "value": "gx38-{random_name}.{tld}"
          }
        ]
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Reads domain gu38; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/gu38-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "gu38-{random_name}.{tld}"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu38; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu38-{random_name}.{tld}"
      }
    }
  ]
}
