{
  "test_id": "test50-put_swaps_a_for_aaaa",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "aaaa"
    }
  },
  "comment": "Skipped on epp-docker: EPP has no address records of the domain itself, only ns, ds and dnskey.",
  "description": "A PUT replaces the a record by an aaaa record.",
  "setup": [
    {
      "comment": "Creates contact R51 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R51}"
      }
    },
    {
      "comment": "Creates domain gu51 with authInfo, registrant R51 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu51-{random_name}.{tld}",
        "registrant_id": "{handle:a:R51}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain gu51 by a full update with registrant R51, dns records aaaa; expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/gu51-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:R51}"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::10"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::10"
                }
              }
            ]
          }
        }
      }
    },
    {
      "comment": "Patches domain gu51: remove /dns/records with a match; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu51-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/dns/records",
            "match": {
              "type": "a"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu51; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu51-{random_name}.{tld}"
      }
    }
  ]
}
