{
  "test_id": "test64-patch_max_sig_lifetime",
  "description": "The proxy does not map maxSigLifetime of secDNS (dns.controls).",
  "setup": [
    {
      "comment": "Creates contact R65 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R65}"
      }
    },
    {
      "comment": "Creates domain gu65 with authInfo, registrant R65 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu65-{random_name}.{tld}",
        "registrant_id": "{handle:a:R65}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu65: add /dns/controls; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu65-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/controls",
            "value": {
              "@type": "dnsControls",
              "maxSigLifetime": {
                "ds": 604800
              }
            }
          }
        ]
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu65; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu65-{random_name}.{tld}"
      }
    }
  ]
}
