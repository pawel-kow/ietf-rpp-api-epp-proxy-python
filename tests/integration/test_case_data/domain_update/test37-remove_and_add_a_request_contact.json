{
  "when": {
    "profile.domainName.generalRequest.max_count": {
      "min": 1
    },
    "profile.domainName.abuse.max_count": {
      "min": 1
    }
  },
  "comment": "Skipped on epp-docker: EPP has no General Request or Abuse contact of a domain.",
  "test_id": "test37-remove_and_add_a_request_contact",
  "description": "A request contact of a domain is removed and added again: the counterpart of the admin and tech cases (test4, test9) for the members of RRI. A second removal answers 422, which proves the first.",
  "setup": [
    {
      "comment": "Creates request contact RG19 with uriTemplate; expects 201 01000. The General Request contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RG19}"
      }
    },
    {
      "comment": "Creates request contact RA19 with uriTemplate; expects 201 01000. The Abuse contact of the domain below.",
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:RA19}"
      }
    },
    {
      "comment": "Creates contact U37 with authInfo (the request differs by backend); expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:U37}"
      }
    },
    {
      "comment": "Creates domain t37 with registrant U37, generalRequest, abuse, dns records a, authInfo (the request differs by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t37-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:U37}"
        },
        "abuse": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "requestContact",
                "id": "{handle:a:RA19}"
              }
            },
            {
              "omit": true
            }
          ]
        },
        "generalRequest": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "requestContact",
                "id": "{handle:a:RG19}"
              }
            },
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t37: remove /abuse; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t37-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/abuse"
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "generalRequest": {
            "@type": "requestContact",
            "id": "{handle:a:RG19}"
          }
        }
      }
    },
    {
      "comment": "Patches domain t37: remove /abuse; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t37-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/abuse"
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Patches domain t37: add /abuse; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t37-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/abuse",
            "value": {
              "@type": "requestContact",
              "id": "{handle:a:RA19}"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "generalRequest": {
            "@type": "requestContact",
            "id": "{handle:a:RG19}"
          },
          "abuse": {
            "@type": "requestContact",
            "id": "{handle:a:RA19}"
          }
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t37; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t37-{random_name}.{tld}"
      }
    }
  ]
}
