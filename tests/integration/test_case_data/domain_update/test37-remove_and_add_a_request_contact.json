{
  "when": {
    "profile.domainName.contacts.labels": {
      "contains": "abuse"
    }
  },
  "test_id": "test37-remove_and_add_a_request_contact",
  "description": "A contact role is removed by match and added again: the counterpart of the admin and tech cases (test4, test9) for the roles of RRI.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "Content-Type": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "contact",
                "id": "{handle:a:U37}",
                "contactInfo": {
                  "@type": "Card",
                  "version": "2.0",
                  "kind": "individual",
                  "name": {
                    "full": "Erika Mustermann"
                  },
                  "addresses": {
                    "addr": {
                      "components": [
                        {
                          "kind": "name",
                          "value": "Musterweg 12"
                        },
                        {
                          "kind": "locality",
                          "value": "Frankfurt am Main"
                        },
                        {
                          "kind": "postcode",
                          "value": "60596"
                        }
                      ],
                      "countryCode": "DE"
                    }
                  },
                  "emails": {
                    "email": {
                      "address": "erika@example.com"
                    }
                  },
                  "phones": {
                    "voice": {
                      "number": "tel:+49.6912345678",
                      "features": {
                        "voice": true
                      }
                    }
                  }
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            },
            {
              "then": {
                "@type": "contact",
                "id": "{handle:a:U37}",
                "contactInfo": {
                  "@type": "Card",
                  "version": "2.0",
                  "kind": "individual",
                  "name": {
                    "full": "Erika Mustermann"
                  },
                  "addresses": {
                    "addr": {
                      "components": [
                        {
                          "kind": "name",
                          "value": "Musterweg 12"
                        },
                        {
                          "kind": "locality",
                          "value": "Frankfurt am Main"
                        },
                        {
                          "kind": "postcode",
                          "value": "60596"
                        }
                      ],
                      "countryCode": "DE"
                    }
                  },
                  "emails": {
                    "email": {
                      "address": "erika@example.com"
                    }
                  },
                  "phones": {
                    "voice": {
                      "number": "tel:+49.6912345678",
                      "features": {
                        "voice": true
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "contact",
          "id": "{handle:a:U37}"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "Content-Type": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "domainName",
                "name": "t37-{random_name}.{tld}",
                "registrant": {
                  "@type": "contact",
                  "id": "{handle:a:U37}"
                },
                "contacts": [
                  {
                    "label": "generalRequest",
                    "object": {
                      "@type": "contact",
                      "id": "{gen_req:a}"
                    }
                  },
                  {
                    "label": "abuse",
                    "object": {
                      "@type": "contact",
                      "id": "{abuse:a}"
                    }
                  }
                ],
                "dns": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            },
            {
              "then": {
                "@type": "domainName",
                "name": "t37-{random_name}.{tld}",
                "registrant": {
                  "@type": "contact",
                  "id": "{handle:a:U37}"
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "domainName",
          "name": "t37-{random_name}.{tld}",
          "registrant": {
            "id": "{handle:a:U37}"
          }
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          }
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t37-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "abuse"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "contacts": [
            {
              "label": "generalRequest",
              "object": {
                "@type": "contact",
                "id": "{gen_req:a}"
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t37-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "abuse",
              "object": {
                "@type": "contact",
                "id": "{abuse:a}"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "contacts": [
            {
              "label": "generalRequest",
              "object": {
                "@type": "contact",
                "id": "{gen_req:a}"
              }
            },
            {
              "label": "abuse",
              "object": {
                "@type": "contact",
                "id": "{abuse:a}"
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "url": "/domainNames/t37-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    }
  ]
}
