{
  "test_id": "test44-put_adds_contacts",
  "when": {
    "profile.domainName.contacts.labels": {
      "contains": "tech"
    },
    "profile.domainName.registrant.min_count": 0
  },
  "comment": "Skipped on rri-mtest: RRI has no admin, tech or billing contacts; RRI requires a holder, so a domain cannot be without a registrant.",
  "description": "A PUT adds contacts to a domain without any.",
  "setup": [
    {
      "comment": "Creates contact R44 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R44}"
      }
    },
    {
      "comment": "Creates domain gu44 with authInfo, registrant R44 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu44-{random_name}.{tld}",
        "registrant_id": "{handle:a:R44}"
      }
    },
    {
      "comment": "Creates contact T44 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:T44}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain gu44 by a full update with contacts tech; expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/gu44-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "contacts": [
            {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:T44}"
              }
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "contacts": [
            {
              "label": "tech",
              "object": {
                "id": "{handle:a:T44}"
              }
            }
          ]
        }
      }
    },
    {
      "comment": "Reads domain gu44; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/gu44-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "contacts": [
            {
              "label": "tech",
              "object": {
                "id": "{handle:a:T44}"
              }
            }
          ]
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu44; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu44-{random_name}.{tld}"
      }
    }
  ]
}
