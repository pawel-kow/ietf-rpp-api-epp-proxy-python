{
  "test_id": "test3-add_remove_hostobj",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "up-test3-{random_name}.example",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test3-{random_name}.example",
          "status": [
            {
              "@type": "domainStatus",
              "label": "ok"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test3-{random_name}.example",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns1.bar.example"
            }
          },
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns2.bar.example"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test3-{random_name}.example",
          "status": [
            {
              "@type": "domainStatus",
              "label": "ok"
            }
          ],
          "nameservers": [
            {
              "@type": "host",
              "hostName": "NS1.BAR.EXAMPLE"
            },
            {
              "@type": "host",
              "hostName": "NS2.BAR.EXAMPLE"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test3-{random_name}.example",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/nameservers",
            "match": {
              "hostName": "ns1.bar.example"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test3-{random_name}.example",
          "status": [
            {
              "@type": "domainStatus",
              "label": "ok"
            }
          ],
          "nameservers": [
            {
              "@type": "host",
              "hostName": "NS2.BAR.EXAMPLE"
            }
          ]
        }
      }
    }
  ]
}
