{
  "test_id": "test2-authinfo_only-clTRID",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "up-test2-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test2-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "ok"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test2-{random_name}.{tld}?includeElements=authInfo",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "up-test2-{random_name}-clTRID",
          "Accept": "application/rpp+json",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/authInfo",
            "value": {
              "@type": "authInfo",
              "method": "authinfo",
              "authdata": "NewPassword1!@"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test2-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "ok"
            }
          ],
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "NewPassword1!@"
          }
        },
        "headers": {
          "RPP-Cltrid": "up-test2-{random_name}-clTRID",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          }
        }
      }
    }
  ]
}
