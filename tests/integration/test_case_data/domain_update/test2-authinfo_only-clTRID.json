{
  "markers": [
    "smoke"
  ],
  "test_id": "test2-authinfo_only-clTRID",
  "setup": [
    {
      "comment": "Creates contact HU2; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU2}"
      }
    },
    {
      "comment": "Creates domain up-test2 with authInfo, registrant HU2 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "up-test2-{random_name}.{tld}",
        "registrant_id": "{handle:a:HU2}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain up-test2: replace /authInfo (includeElements=authInfo), with a fixed RPP-Cltrid (the request differs by backend); expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": {
          "select": [
            {
              "when": {
                "profile.domainName.authInfo.read_supported": true
              },
              "then": "/domainNames/up-test2-{random_name}.{tld}?includeElements=authInfo"
            },
            {
              "then": "/domainNames/up-test2-{random_name}.{tld}"
            }
          ]
        },
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "up-test2-{random_name}-clTRID",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/authInfo",
            "value": {
              "@type": "authInfo",
              "method": "authinfo",
              "authdata": "NewAbc2345678"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test2-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.success_status}"
            }
          ],
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.domainName.authInfo.read_supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "NewAbc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "RPP-Cltrid": "up-test2-{random_name}-clTRID",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          }
        }
      }
    }
  ]
}
