{
  "when": {
    "profile.domainName.contacts.labels": {
      "contains": "admin"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no admin, tech or billing contacts. Test37 is the counterpart for RRI's request contacts.",
  "test_id": "test9-remove_contacts_by_partial_match",
  "setup": [
    {
      "comment": "Creates contact uh1 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:uh1}"
      }
    },
    {
      "comment": "Creates contact uh2 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:uh2}"
      }
    },
    {
      "comment": "Creates domain up-test9 with authInfo, registrant uh1, contacts admin, tech, tech (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "up-test9-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:uh1}"
        },
        "contacts": {
          "select": [
            {
              "when": {
                "profile.domainName.contacts.labels": {
                  "contains": "admin"
                }
              },
              "then": [
                {
                  "label": "admin",
                  "object": {
                    "@type": "contact",
                    "id": "{handle:a:uh1}"
                  }
                },
                {
                  "label": "tech",
                  "object": {
                    "@type": "contact",
                    "id": "{handle:a:uh1}"
                  }
                },
                {
                  "label": "tech",
                  "object": {
                    "@type": "contact",
                    "id": "{handle:a:uh2}"
                  }
                }
              ]
            },
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain up-test9: remove /contacts with a match; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test9-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "tech"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test9-{random_name}.{tld}",
          "contacts": {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "admin"
                  }
                },
                "then": [
                  {
                    "label": "admin",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:uh1}"
                    }
                  }
                ]
              },
              {
                "omit": true
              }
            ]
          }
        }
      }
    }
  ]
}
