{
  "test_id": "test43-patch_adds_registrant",
  "when": {
    "profile.domainName.registrant.min_count": 0
  },
  "comment": "Skipped on rri-mtest: RRI requires a holder, so a domain cannot be without a registrant.",
  "description": "A domain without a registrant gets one by PATCH.",
  "setup": [
    {
      "comment": "Creates contact R43 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R43}"
      }
    },
    {
      "comment": "Creates domain gu43 with authInfo, dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu43-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu43: add /registrant; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu43-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/registrant",
            "value": {
              "@type": "contact",
              "id": "{handle:a:R43}"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "registrant": {
            "id": "{handle:a:R43}"
          }
        }
      }
    },
    {
      "comment": "Reads domain gu43; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/gu43-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "registrant": {
            "id": "{handle:a:R43}"
          }
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu43; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu43-{random_name}.{tld}"
      }
    }
  ]
}
