{
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "ds"
    }
  },
  "comment": "Skipped on rri-mtest: RRI takes no DS records (DENIC computes the DS from the DNSKEY).",
  "test_id": "test16-replace_dns_ds",
  "setup": [
    {
      "comment": "Creates contact HU16; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU16}"
      }
    },
    {
      "comment": "Creates domain t16 with authInfo, dns records ds, registrant HU16 (by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t16-{random_name}.{tld}",
        "dns": {
          "@type": "dnsData",
          "records": [
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ds",
              "rdata": {
                "keyTag": "12345",
                "algorithm": "8",
                "digestType": "2",
                "digest": "49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
              }
            }
          ]
        },
        "registrant_id": "{handle:a:HU16}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t16: replace /dns; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t16-{random_name}.{tld}",
        "body_json": [
          {
            "op": "replace",
            "path": "/dns",
            "value": {
              "@type": "dnsData",
              "records": [
                {
                  "@type": "dnsRecord",
                  "name": "@",
                  "type": "ds",
                  "rdata": {
                    "keyTag": "222",
                    "algorithm": "8",
                    "digestType": "2",
                    "digest": "AAAA46E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
                  }
                }
              ]
            }
          }
        ],
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ds",
                "rdata": {
                  "keyTag": "222",
                  "algorithm": "8",
                  "digestType": "2",
                  "digest": "AAAA46E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
                }
              }
            ]
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Reads domain t16; expects 200 01000. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/t16-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ds",
                "rdata": {
                  "keyTag": "222",
                  "algorithm": "8",
                  "digestType": "2",
                  "digest": "AAAA46E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
                }
              }
            ]
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
