{
  "test_id": "test67-patch_removes_holder",
  "when": {
    "profile.domainName.registrant.max_count": {
      "min": 2
    }
  },
  "comment": "Skipped on epp-docker: EPP holds one registrant; several holders are RRI's.",
  "description": "A PATCH removes the second of two holders.",
  "setup": [
    {
      "comment": "Creates contact R68 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R68}"
      }
    },
    {
      "comment": "Creates contact S68 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:S68}"
      }
    },
    {
      "comment": "Creates domain gu68 with authInfo, registrant R68 (by backend), dns records a (by backend), contacts registrant; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu68-{random_name}.{tld}",
        "contacts": [
          {
            "label": "registrant",
            "object": {
              "@type": "contact",
              "id": "{handle:a:S68}"
            }
          }
        ],
        "registrant_id": "{handle:a:R68}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu68: remove /contacts with a match; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu68-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "registrant",
              "object": {
                "id": "{upper:{handle:a:S68}}"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Patches domain gu68: remove /contacts with a match; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu68-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "registrant",
              "object": {
                "id": "{upper:{handle:a:S68}}"
              }
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu68; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu68-{random_name}.{tld}"
      }
    }
  ]
}
