{
  "when": {
    "profile.domainName.contacts.labels": {
      "contains": "admin"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no admin, tech or billing contacts. Test37 is the counterpart for RRI's request contacts.",
  "test_id": "test4-contacts_and_registrant",
  "setup": [
    {
      "comment": "Creates contact uf1 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:uf1}"
      }
    },
    {
      "comment": "Creates contact uf2 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:uf2}"
      }
    },
    {
      "comment": "Creates domain up-test4 with authInfo, registrant uf1, contacts admin, tech, billing (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "up-test4-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:uf1}"
        },
        "contacts": {
          "select": [
            {
              "when": {
                "profile.domainName.contacts.labels": {
                  "contains": "admin"
                }
              },
              "then": [
                {
                  "label": "admin",
                  "object": {
                    "@type": "contact",
                    "id": "{handle:a:uf1}"
                  }
                },
                {
                  "label": "tech",
                  "object": {
                    "@type": "contact",
                    "id": "{handle:a:uf1}"
                  }
                },
                {
                  "label": "billing",
                  "object": {
                    "@type": "contact",
                    "id": "{handle:a:uf1}"
                  }
                }
              ]
            },
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain up-test4: remove /contacts with a match; add /contacts tech; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test4-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "billing",
              "object": {
                "@type": "contact",
                "id": "{handle:a:uf1}"
              }
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:uf2}"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test4-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.success_status}"
            }
          ],
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:uf1}"
          },
          "contacts": {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "admin"
                  }
                },
                "then": [
                  {
                    "label": "admin",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:uf1}"
                    }
                  },
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:uf1}"
                    }
                  },
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:uf2}"
                    }
                  }
                ]
              },
              {
                "omit": true
              }
            ]
          }
        }
      }
    },
    {
      "comment": "Patches domain up-test4: replace /registrant; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test4-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/registrant",
            "value": {
              "@type": "contact",
              "id": "{handle:a:uf2}"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "up-test4-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.success_status}"
            }
          ],
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:uf2}"
          },
          "contacts": {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "admin"
                  }
                },
                "then": [
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:uf2}"
                    }
                  },
                  {
                    "label": "admin",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:uf1}"
                    }
                  },
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:uf1}"
                    }
                  }
                ]
              },
              {
                "omit": true
              }
            ]
          }
        }
      }
    }
  ]
}
