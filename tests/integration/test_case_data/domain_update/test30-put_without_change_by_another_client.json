{
  "test_id": "test30-put_without_change_by_another_client",
  "description": "A full update by a client that is not the sponsor is refused, also when it changes nothing (core §16.8): a domain with an a record or ns records, on every backend.",
  "setup": [
    {
      "comment": "Creates contact U35 with authInfo (the request differs by backend); expects 201 01000. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:U35}"
      }
    },
    {
      "comment": "Creates domain t35 with registrant U35, dns records a, authInfo (the request differs by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t35-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:U35}"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain t35 by a full update with registrant U35, dns records a as registrar b (the request differs by backend); expects 403 02201. An error answer this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/t35-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "domainName",
                "registrant": {
                  "@type": "contact",
                  "id": "{handle:a:U35}"
                },
                "dns": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              }
            },
            {
              "then": {
                "@type": "domainName",
                "registrant": {
                  "@type": "contact",
                  "id": "{handle:a:U35}"
                }
              }
            }
          ]
        }
      },
      "response": {
        "status": 403,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02201"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t35; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t35-{random_name}.{tld}"
      }
    }
  ]
}
