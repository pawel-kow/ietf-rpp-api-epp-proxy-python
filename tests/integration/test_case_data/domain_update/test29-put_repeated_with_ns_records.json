                "rdata": {
                  "nsdname": "ns1.u29-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.u29-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "nameservers": [
            {
              "@type": "host",
              "hostName": "{upper:ns1.u29-{random_name}.net}"
            },
            {
              "@type": "host",
              "hostName": "{upper:ns2.u29-{random_name}.net}"
            }
          ]
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
