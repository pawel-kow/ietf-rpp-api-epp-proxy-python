{
  "test_id": "test63-patch_adds_contact_that_does_not_exist",
  "description": "A contact that does not exist is refused by the registry.",
  "setup": [
    {
      "comment": "Creates contact R64 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R64}"
      }
    },
    {
      "comment": "Creates domain gu64 with authInfo, registrant R64 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu64-{random_name}.{tld}",
        "registrant_id": "{handle:a:R64}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu64: add /contacts tech (the request differs by backend); expects one of 404 02303 or 409 02305 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu64-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "tech"
                  }
                },
                "then": {
                  "op": "add",
                  "path": "/contacts",
                  "value": {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:N64}"
                    }
                  }
                }
              },
              {
                "then": {
                  "op": "add",
                  "path": "/abuse",
                  "value": {
                    "@type": "requestContact",
                    "id": "{handle:a:N64}"
                  }
                }
              }
            ]
          }
        ]
      },
      "response": {
        "any_of": [
          {
            "status": 404,
            "headers": {
              "RPP-Code": "02303"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 409,
            "headers": {
              "RPP-Code": "02305"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "headers": {
              "RPP-Code": "02306"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu64; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu64-{random_name}.{tld}"
      }
    }
  ]
}
