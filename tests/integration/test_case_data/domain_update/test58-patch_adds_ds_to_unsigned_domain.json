{
  "test_id": "test58-patch_adds_ds_to_unsigned_domain",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "ds"
    }
  },
  "comment": "Skipped on rri-mtest: RRI takes no DS records (DENIC computes the DS from the DNSKEY).",
  "description": "A PATCH adds a DS record to a domain without any.",
  "setup": [
    {
      "comment": "Creates contact R59 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R59}"
      }
    },
    {
      "comment": "Creates domain gu59 with authInfo, registrant R59 (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu59-{random_name}.{tld}",
        "registrant_id": "{handle:a:R59}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu59: add /dns/records; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu59-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ds",
              "rdata": {
                "keyTag": "59",
                "algorithm": "8",
                "digestType": "2",
                "digest": "595946E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ds",
                "rdata": {
                  "keyTag": "59",
                  "algorithm": "8",
                  "digestType": "2",
                  "digest": "595946E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
                }
              }
            ]
          }
        }
      }
    },
    {
      "comment": "Reads domain gu59; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/gu59-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ds",
                "rdata": {
                  "keyTag": "59",
                  "algorithm": "8",
                  "digestType": "2",
                  "digest": "595946E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
                }
              }
            ]
          }
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu59; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu59-{random_name}.{tld}"
      }
    }
  ]
}
