{
  "when": {
    "profile.objects": {
      "contains": "host"
    },
    "profile.domainName.dns.record_types": {
      "contains": "ds"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain); RRI takes no DS records (DENIC computes the DS from the DNSKEY).",
  "test_id": "test24-put_nameservers_and_ds",
  "setup": [
    {
      "comment": "Creates contact HU24; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU24}"
      }
    },
    {
      "comment": "Creates host ns1.u24 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns1.u24-{random_name}.net"
      }
    },
    {
      "comment": "Creates domain put24 with authInfo, dns records ds, registrant HU24 (by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "put24-{random_name}.{tld}",
        "dns": {
          "@type": "dnsData",
          "records": [
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ds",
              "rdata": {
                "keyTag": "12345",
                "algorithm": "8",
                "digestType": "2",
                "digest": "49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
              }
            }
          ]
        },
        "registrant_id": "{handle:a:HU24}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain put24 by a full update with 1 nameserver, dns records ds, registrant HU24 (by backend); expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/put24-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "nameservers": [
            {
              "@type": "host",
              "hostName": "ns1.u24-{random_name}.net"
            }
          ],
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ds",
                "rdata": {
                  "keyTag": "12345",
                  "algorithm": "8",
                  "digestType": "2",
                  "digest": "49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
                }
              }
            ]
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU24}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "nameservers": [
            {
              "@type": "host",
              "hostName": "{upper:ns1.u24-{random_name}.net}"
            }
          ],
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ds",
                "rdata": {
                  "keyTag": "12345",
                  "algorithm": "8",
                  "digestType": "2",
                  "digest": "49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
                }
              }
            ]
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
