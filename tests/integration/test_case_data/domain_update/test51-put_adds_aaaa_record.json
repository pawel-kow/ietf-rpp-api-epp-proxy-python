{
  "test_id": "test51-put_adds_aaaa_record",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "aaaa"
    }
  },
  "comment": "Skipped on epp-docker: EPP has no address records of the domain itself, only ns, ds and dnskey.",
  "description": "A PUT adds an aaaa record next to the a record.",
  "setup": [
    {
      "comment": "Creates contact R52 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R52}"
      }
    },
    {
      "comment": "Creates domain gu52 with authInfo, registrant R52 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu52-{random_name}.{tld}",
        "registrant_id": "{handle:a:R52}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain gu52 by a full update with registrant R52, dns records a, aaaa; expects 200. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/gu52-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:R52}"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::10"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::10"
                }
              }
            ]
          }
        }
      }
    },
    {
      "comment": "Reads domain gu52; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/gu52-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "aaaa",
                "rdata": {
                  "address": "2001:db8::10"
                }
              }
            ]
          }
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu52; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu52-{random_name}.{tld}"
      }
    }
  ]
}
