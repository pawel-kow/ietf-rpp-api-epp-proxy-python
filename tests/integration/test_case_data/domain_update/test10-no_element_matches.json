{
  "test_id": "test10-no_element_matches",
  "setup": [
    {
      "comment": "Creates contact HU10; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU10}"
      }
    },
    {
      "comment": "Creates host ns1.u10 with dns records ns; expects 201. A nameserver of the domain below. Only where the backend has host objects.",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "include": "create_host",
      "with": {
        "name": "ns1.u10-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns2.u10 with dns records ns; expects 201. A nameserver of the domain below. Only where the backend has host objects.",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "include": "create_host",
      "with": {
        "name": "ns2.u10-{random_name}.net"
      }
    },
    {
      "comment": "Creates domain up-test10 with authInfo, registrant HU10 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "up-test10-{random_name}.{tld}",
        "registrant_id": "{handle:a:HU10}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain up-test10: add /nameservers; expects 200. The operation this case checks. Only where the backend has host objects.",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test10-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns1.u10-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {}
      }
    },
    {
      "comment": "Patches domain up-test10: replace /nameservers with a match no name server has; expects 422 02308. The error answer this case checks. Only where the backend has host objects.",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test10-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/nameservers",
            "match": {
              "hostName": "ns9.u10-{random_name}.net"
            },
            "value": {
              "@type": "host",
              "hostName": "ns2.u10-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error",
          "status": 422,
          "errors": [
            {
              "result": "02308"
            }
          ]
        },
        "headers": {
          "RPP-Code": "02308"
        }
      }
    },
    {
      "comment": "Patches domain up-test10: replace /dns/records with a match no record has; expects 422 02308. The error answer this case checks. Only where name servers are dns records, not host objects.",
      "when": {
        "profile.objects": {
          "not": {
            "contains": "host"
          }
        }
      },
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test10-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "match": {
              "type": "a",
              "rdata": {
                "address": "192.0.2.99"
              }
            },
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "a",
              "rdata": {
                "address": "192.0.2.11"
              }
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error",
          "status": 422,
          "errors": [
            {
              "result": "02308"
            }
          ]
        },
        "headers": {
          "RPP-Code": "02308"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain up-test10; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "up-test10-{random_name}.{tld}"
      }
    }
  ]
}
