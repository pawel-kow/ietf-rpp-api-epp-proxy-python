{
  "when": {
    "env.domainName.processes.update.dns_checked": true
  },
  "comment": "Skipped on epp-docker: the EPP test server does not check the name servers of an update, so the refusal the case expects never comes.",
  "test_id": "test48-put_replaces_a_by_ns_records",
  "skip": "#139",
  "description": "A PUT replaces the a record by two ns records. MTEST checks the delegation of an update: name servers that do not serve the zone are refused.",
  "setup": [
    {
      "comment": "Creates contact R49 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R49}"
      }
    },
    {
      "comment": "Creates domain gu49 with authInfo, registrant R49 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu49-{random_name}.{tld}",
        "registrant_id": "{handle:a:R49}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain gu49 by a full update with registrant R49, dns records 2 ns; expects one of 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/gu49-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:R49}"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.gn49-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.gn49-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "headers": {
              "RPP-Code": "02005"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "headers": {
              "RPP-Code": "02306"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu49; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu49-{random_name}.{tld}"
      }
    }
  ]
}
