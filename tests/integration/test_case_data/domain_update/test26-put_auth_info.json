{
  "when": {
    "profile.domainName.authInfo.read_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI does not show a domain's authInfo (it holds only its hash), so the case cannot read it back.",
  "test_id": "test26-put_auth_info",
  "setup": [
    {
      "comment": "Creates contact HU26; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU26}"
      }
    },
    {
      "comment": "Creates domain put26 with authInfo, registrant HU26 (by backend), dns records a (by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "put26-{random_name}.{tld}",
        "registrant_id": "{handle:a:HU26}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain put26 by a full update with authInfo, registrant HU26 (by backend), dns records a (by backend) (includeElements=authInfo); expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": {
          "select": [
            {
              "when": {
                "profile.domainName.authInfo.read_supported": true
              },
              "then": "/domainNames/put26-{random_name}.{tld}?includeElements=authInfo"
            },
            {
              "then": "/domainNames/put26-{random_name}.{tld}"
            }
          ]
        },
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "NewAbc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU26}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.domainName.authInfo.read_supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "NewAbc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Replaces domain put26 by a full update with registrant HU26 (by backend), dns records a (by backend); expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/put26-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU26}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Reads domain put26 (includeElements=authInfo) (the request differs by backend); expects 200 01000. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": {
          "select": [
            {
              "when": {
                "profile.domainName.authInfo.read_supported": true
              },
              "then": "/domainNames/put26-{random_name}.{tld}?includeElements=authInfo"
            },
            {
              "then": "/domainNames/put26-{random_name}.{tld}"
            }
          ]
        },
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "NewAbc2345678"
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
