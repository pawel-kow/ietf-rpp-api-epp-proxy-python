{
  "test_id": "test45-patch_clears_contacts",
  "when": {
    "profile.domainName.contacts.labels": {
      "contains": "tech"
    },
    "profile.domainName.registrant.min_count": 0
  },
  "comment": "Skipped on rri-mtest: RRI has no admin, tech or billing contacts; RRI requires a holder, so a domain cannot be without a registrant.",
  "description": "replace /contacts [] removes every contact.",
  "setup": [
    {
      "comment": "Creates contact T45 with authInfo (by backend); expects 201. A contact of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:T45}"
      }
    },
    {
      "comment": "Creates domain gu45 with authInfo, dns records a (by backend), contacts tech, admin; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu45-{random_name}.{tld}",
        "contacts": [
          {
            "label": "tech",
            "object": {
              "@type": "contact",
              "id": "{handle:a:T45}"
            }
          },
          {
            "label": "admin",
            "object": {
              "@type": "contact",
              "id": "{handle:a:T45}"
            }
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu45: remove /contacts with a match; add /contacts tech; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu45-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "tech"
            }
          },
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:T45}"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Patches domain gu45: replace /contacts []; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu45-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contacts",
            "value": []
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Patches domain gu45: remove /contacts with a match; expects 422 02308. An error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu45-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "tech"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Patches domain gu45: remove /contacts with a match; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu45-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/contacts",
            "match": {
              "label": "admin"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu45; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu45-{random_name}.{tld}"
      }
    }
  ]
}
