{
  "test_id": "test68-patch_replaces_mx_record",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "mx"
    }
  },
  "comment": "Skipped on epp-docker: EPP has no MX records of the domain.",
  "description": "A PATCH replaces the MX record by one of another preference.",
  "setup": [
    {
      "comment": "Creates contact R69 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R69}"
      }
    },
    {
      "comment": "Creates domain gu69 with authInfo, registrant R69 (by backend), dns records a, mx; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu69-{random_name}.{tld}",
        "dns": {
          "@type": "dnsData",
          "records": [
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "a",
              "rdata": {
                "address": "192.0.2.10"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "mx",
              "rdata": {
                "preference": "10",
                "exchange": "mx1.denic.de."
              }
            }
          ]
        },
        "registrant_id": "{handle:a:R69}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu69: replace /dns/records with a match; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu69-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "match": {
              "type": "mx"
            },
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "mx",
              "rdata": {
                "preference": "20",
                "exchange": "mx1.denic.de."
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "mx",
                "rdata": {
                  "preference": "20",
                  "exchange": "mx1.denic.de."
                }
              }
            ]
          }
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu69; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu69-{random_name}.{tld}"
      }
    }
  ]
}
