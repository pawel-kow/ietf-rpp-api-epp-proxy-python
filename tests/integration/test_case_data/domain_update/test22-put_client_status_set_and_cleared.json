{
  "when": {
    "profile.domainName.status.client_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no client statuses of a domain.",
  "test_id": "test22-put_client_status_set_and_cleared",
  "setup": [
    {
      "comment": "Creates contact HU22; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU22}"
      }
    },
    {
      "comment": "Creates domain put22 with authInfo, registrant HU22 (by backend), dns records a (by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "put22-{random_name}.{tld}",
        "registrant_id": "{handle:a:HU22}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain put22 by a full update with status clientUpdateProhibited, registrant HU22 (by backend), dns records a (by backend); expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/put22-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "status": [
            {
              "@type": "domainStatus",
              "label": "clientUpdateProhibited",
              "reason": "Hold"
            }
          ],
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU22}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "status": [
            {
              "@type": "domainStatus",
              "label": "clientUpdateProhibited"
            }
          ]
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Patches domain put22: replace /status with a match clientUpdateProhibited; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/put22-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/status",
            "match": {
              "label": "clientUpdateProhibited"
            },
            "value": {
              "@type": "domainStatus",
              "label": "clientUpdateProhibited",
              "reason": "Hold"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Replaces domain put22 by a full update with registrant HU22 (by backend), dns records a (by backend); expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/put22-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU22}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "status": [
            {
              "@type": "domainStatus",
              "label": "{env:domainName.processes.create.success_status}"
            }
          ]
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Patches domain put22: replace /status with a match clientUpdateProhibited; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/put22-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/status",
            "match": {
              "label": "clientUpdateProhibited"
            },
            "value": {
              "@type": "domainStatus",
              "label": "clientUpdateProhibited",
              "reason": "Hold"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02308"
        }
      }
    }
  ]
}
