{
  "test_id": "test59-patch_removes_one_ds_of_two",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "ds"
    }
  },
  "comment": "Skipped on rri-mtest: RRI takes no DS records (DENIC computes the DS from the DNSKEY).",
  "description": "A PATCH removes one of two DS records.",
  "setup": [
    {
      "comment": "Creates contact R60 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R60}"
      }
    },
    {
      "comment": "Creates domain gu60 with authInfo, registrant R60 (by backend), dns records 2 ds; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu60-{random_name}.{tld}",
        "dns": {
          "@type": "dnsData",
          "records": [
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ds",
              "rdata": {
                "keyTag": "601",
                "algorithm": "8",
                "digestType": "2",
                "digest": "600146E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
              }
            },
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ds",
              "rdata": {
                "keyTag": "602",
                "algorithm": "8",
                "digestType": "2",
                "digest": "600246E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
              }
            }
          ]
        },
        "registrant_id": "{handle:a:R60}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu60: remove /dns/records with a match; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu60-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/dns/records",
            "match": {
              "rdata": {
                "keyTag": "602"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "dns": {
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ds",
                "rdata": {
                  "keyTag": "601",
                  "algorithm": "8",
                  "digestType": "2",
                  "digest": "600146E6C4B45C55D4AC49FD46E6C4B45C55D4AC49FD46E6C4B45C55D4AC1234"
                }
              }
            ]
          }
        }
      }
    },
    {
      "comment": "Patches domain gu60: remove /dns/records with a match; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu60-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/dns/records",
            "match": {
              "rdata": {
                "keyTag": "602"
              }
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "headers": {
          "RPP-Code": "02308"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu60; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu60-{random_name}.{tld}"
      }
    }
  ]
}
