{
  "when": {
    "profile.lgrs": {
      "contains": "latn-1.0"
    }
  },
  "test_id": "test34-patch_on_the_read_path_keeps_the_idn",
  "setup": [
    {
      "comment": "Creates contact HU34; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU34}"
      }
    },
    {
      "comment": "Creates domain IDN bücher-u34 with authInfo, uName, lgr, registrant HU34 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "{alabel:bücher-u34}.{tld}",
        "uName": "{ulabel:bücher-u34}.{tld}",
        "lgr": "latn-1.0",
        "registrant_id": "{handle:a:HU34}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain IDN bücher-u34: replace /status clientHold, which takes the read path; expects 200 with the name, uName and lgr kept. The operation this case checks. Only where a domain has client statuses.",
      "when": {
        "profile.domainName.status.client_supported": true
      },
      "request": {
        "method": "PATCH",
        "url": "/domainNames/{alabel:bücher-u34}.{tld}",
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/status",
            "value": [
              {
                "@type": "domainStatus",
                "label": "clientHold"
              }
            ]
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "{alabel:bücher-u34}.{tld}",
          "uName": "{ulabel:bücher-u34}.{tld}",
          "lgr": "latn-1.0",
          "status": [
            {
              "@type": "domainStatus",
              "label": "clientHold"
            }
          ]
        }
      }
    },
    {
      "comment": "Patches domain IDN bücher-u34: replace /dns/records, which takes the read path; expects 200 with the name, uName and lgr kept. The operation this case checks. Only where a domain has no client statuses.",
      "when": {
        "profile.domainName.status.client_supported": false
      },
      "request": {
        "method": "PATCH",
        "url": "/domainNames/{alabel:bücher-u34}.{tld}",
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "value": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.11"
                }
              }
            ]
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "{alabel:bücher-u34}.{tld}",
          "uName": "{ulabel:bücher-u34}.{tld}",
          "lgr": "latn-1.0"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain IDN bücher-u34; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "{alabel:bücher-u34}.{tld}"
      }
    }
  ]
}
