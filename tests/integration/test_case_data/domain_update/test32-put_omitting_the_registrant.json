{
  "when": {
    "profile.domainName.registrant.min_count": 0,
    "profile.domainName.status.client_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI requires a registrant, so the PUT that omits it is refused there; the PATCH also removes /status to take the read path, and RRI has no client statuses.",
  "test_id": "test32-put_omitting_the_registrant",
  "setup": [
    {
      "comment": "Creates contact HU32; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU32}"
      }
    },
    {
      "comment": "Creates contact uq1 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:uq1}"
      }
    },
    {
      "comment": "Creates domain put32 with authInfo, registrant uq1, dns records a (by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "put32-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:uq1}"
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain put32 by a full update with registrant HU32 (by backend), dns records a (by backend); expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/put32-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU32}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Patches domain put32: remove /registrant; remove /status; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/put32-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/registrant"
          },
          {
            "op": "remove",
            "path": "/status"
          }
        ]
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02308"
        }
      }
    }
  ]
}
