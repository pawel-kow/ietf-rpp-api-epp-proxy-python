{
  "test_id": "test31-patch_without_change_by_another_client",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "domainName",
          "name": "put31-{random_name}.example",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "ns1.bar.example"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/put31-{random_name}.example",
        "headers": {
          "Authorization": "Basic YmF6OnF1eA==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/nameservers",
            "match": {
              "hostName": "NS1.BAR.EXAMPLE"
            },
            "value": {
              "@type": "host",
              "hostName": "ns1.bar.example"
            }
          }
        ]
      },
      "response": {
        "status": 403,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02201"
        }
      }
    }
  ]
}
