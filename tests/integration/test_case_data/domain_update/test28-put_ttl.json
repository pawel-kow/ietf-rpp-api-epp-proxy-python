{
  "test_id": "test28-put_ttl",
  "setup": [
    {
      "comment": "Creates contact HU28; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU28}"
      }
    },
    {
      "comment": "Creates domain put28 with authInfo, registrant HU28 (by backend), dns records a (by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "put28-{random_name}.{tld}",
        "registrant_id": "{handle:a:HU28}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain put28 by a full update with dns records dns controls, registrant HU28 (by backend); expects 501 02103. The error answer this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/put28-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "dns": {
            "@type": "dnsData",
            "controls": {
              "@type": "dnsControls",
              "ttl": {
                "a": 3600
              }
            }
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU28}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02103"
        }
      }
    }
  ]
}
