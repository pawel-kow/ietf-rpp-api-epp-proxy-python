{
  "test_id": "test56-patch_adds_dnskey",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "dnskey"
    },
    "profile.objects": {
      "not": {
        "contains": "host"
      }
    }
  },
  "comment": "Skipped on epp-docker: the case needs name servers as ns records of the domain, which a backend with host objects turns into hostAttr; the EPP test server refuses a hostAttr without addresses (pawel-kow/epp#33).",
  "skip": "#143",
  "description": "A PATCH adds a DNSKEY to a delegated domain. MTEST checks the delegation of an update: name servers that do not serve the zone are refused.",
  "setup": [
    {
      "comment": "Creates contact R57 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R57}"
      }
    },
    {
      "comment": "Creates domain gu57 with authInfo, registrant R57 (by backend), dns records 2 ns; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu57-{random_name}.{tld}",
        "dns": {
          "@type": "dnsData",
          "records": [
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ns",
              "rdata": {
                "nsdname": "ns1.gn57-{random_name}.net."
              }
            },
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ns",
              "rdata": {
                "nsdname": "ns2.gn57-{random_name}.net."
              }
            }
          ]
        },
        "registrant_id": "{handle:a:R57}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain gu57: add /dns/records; expects one of 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/gu57-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "dnskey",
              "rdata": {
                "flags": "257",
                "protocol": "3",
                "algorithm": "8",
                "publicKey": ""
              }
            }
          }
        ]
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "headers": {
              "RPP-Code": "02005"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "headers": {
              "RPP-Code": "02306"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu57; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu57-{random_name}.{tld}"
      }
    }
  ]
}
