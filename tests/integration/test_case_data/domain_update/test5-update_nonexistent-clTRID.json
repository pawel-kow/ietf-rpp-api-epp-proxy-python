{
  "test_id": "test5-update_nonexistent-clTRID",
  "steps": [
    {
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test5-{random_name}.example",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "RPP-Cltrid": "up-test5-{random_name}-clTRID",
          "Accept": "application/rpp+json",
          "Content-Type": "application/rpp+json"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/authInfo",
            "value": {
              "@type": "authInfo",
              "method": "authinfo",
              "authdata": "NewPassword1!@"
            }
          }
        ]
      },
      "response": {
        "status": 404,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "up-test5-{random_name}-clTRID",
          "RPP-Code": "02303"
        }
      }
    }
  ]
}
