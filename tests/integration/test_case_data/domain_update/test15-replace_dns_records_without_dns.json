{
  "test_id": "test15-replace_dns_records_without_dns",
  "setup": [
    {
      "comment": "Creates contact HU15; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HU15}"
      }
    },
    {
      "comment": "Creates domain t15 with authInfo, registrant HU15 (by backend), dns records a (by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "t15-{random_name}.{tld}",
        "registrant_id": "{handle:a:HU15}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches domain t15: replace /dns/records []; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t15-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "value": []
          }
        ]
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.domainName.dns.min_count": {
                "min": 1
              }
            },
            "then": {
              "status": 501,
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              },
              "headers": {
                "RPP-Code": "02102"
              }
            }
          },
          {
            "then": {
              "status": 200,
              "headers": {
                "RPP-Code": "01000"
              },
              "body": {
                "@type": "domainName"
              }
            }
          }
        ]
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain t15; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "t15-{random_name}.{tld}"
      }
    }
  ]
}
