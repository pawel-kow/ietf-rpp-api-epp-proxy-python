{
  "when": {
    "profile.objects": {
      "contains": "host"
    },
    "profile.domainName.contacts.labels": {
      "contains": "admin"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain); RRI has no admin, tech or billing contacts.",
  "test_id": "test17-put_replaces_nameservers_and_contacts",
  "setup": [
    {
      "comment": "Creates contact uk1 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:uk1}"
      }
    },
    {
      "comment": "Creates contact uk2 with authInfo (by backend); expects 201. The registrant of the domain below.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:uk2}"
      }
    },
    {
      "comment": "Creates host ns1.u17 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns1.u17-{random_name}.net"
      }
    },
    {
      "comment": "Creates host ns2.u17 with dns records ns; expects 201. A nameserver of the domain below.",
      "include": "create_host",
      "with": {
        "name": "ns2.u17-{random_name}.net"
      }
    },
    {
      "comment": "Creates domain put17 with authInfo, registrant uk1, contacts tech (by backend), dns records a (by backend); expects 201 01000. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "put17-{random_name}.{tld}",
        "registrant": {
          "@type": "contact",
          "id": "{handle:a:uk1}"
        },
        "contacts": {
          "select": [
            {
              "when": {
                "profile.domainName.contacts.labels": {
                  "contains": "admin"
                }
              },
              "then": [
                {
                  "label": "tech",
                  "object": {
                    "@type": "contact",
                    "id": "{handle:a:uk1}"
                  }
                }
              ]
            },
            {
              "omit": true
            }
          ]
        }
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain put17 by a full update with registrant uk1, contacts tech (by backend), 2 nameservers; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/put17-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:uk1}"
          },
          "contacts": {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "admin"
                  }
                },
                "then": [
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:uk2}"
                    }
                  }
                ]
              },
              {
                "omit": true
              }
            ]
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "ns1.u17-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns2.u17-{random_name}.net"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:uk1}"
          },
          "contacts": {
            "select": [
              {
                "when": {
                  "profile.domainName.contacts.labels": {
                    "contains": "admin"
                  }
                },
                "then": [
                  {
                    "label": "tech",
                    "object": {
                      "@type": "contact",
                      "id": "{handle:a:uk2}"
                    }
                  }
                ]
              },
              {
                "omit": true
              }
            ]
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "{upper:ns1.u17-{random_name}.net}"
            },
            {
              "@type": "host",
              "hostName": "{upper:ns2.u17-{random_name}.net}"
            }
          ]
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Patches domain put17: replace /nameservers with a match; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/put17-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/nameservers",
            "match": {
              "hostName": "{upper:ns1.u17-{random_name}.net}"
            },
            "value": {
              "@type": "host",
              "hostName": "ns1.u17-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Patches domain put17: replace /contacts with a match tech; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/put17-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contacts",
            "match": {
              "label": "tech"
            },
            "value": {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:uk2}"
              }
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Replaces domain put17 by a full update with registrant uk2, 1 nameserver; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/put17-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:uk2}"
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "ns2.u17-{random_name}.net"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:uk2}"
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "{upper:ns2.u17-{random_name}.net}"
            }
          ]
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Patches domain put17: replace /nameservers with a match; expects 422 02308. An error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/put17-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/nameservers",
            "match": {
              "hostName": "{upper:ns1.u17-{random_name}.net}"
            },
            "value": {
              "@type": "host",
              "hostName": "ns1.u17-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02308"
        }
      }
    },
    {
      "comment": "Patches domain put17: replace /contacts with a match tech; expects 422 02308. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/put17-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/contacts",
            "match": {
              "label": "tech"
            },
            "value": {
              "label": "tech",
              "object": {
                "@type": "contact",
                "id": "{handle:a:uk2}"
              }
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02308"
        }
      }
    }
  ]
}
