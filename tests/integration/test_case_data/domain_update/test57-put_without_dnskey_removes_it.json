{
  "test_id": "test57-put_without_dnskey_removes_it",
  "when": {
    "profile.domainName.dns.record_types": {
      "contains": "dnskey"
    },
    "profile.objects": {
      "not": {
        "contains": "host"
      }
    }
  },
  "comment": "Skipped on epp-docker: the case needs name servers as ns records of the domain, which a backend with host objects turns into hostAttr; the EPP test server refuses a hostAttr without addresses (pawel-kow/epp#33).",
  "skip": "#139",
  "description": "A PUT without the DNSKEY removes it. MTEST checks the delegation of an update: name servers that do not serve the zone are refused.",
  "setup": [
    {
      "comment": "Creates contact R58 with authInfo (by backend); expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:R58}"
      }
    },
    {
      "comment": "Creates domain gu58 with authInfo, registrant R58 (by backend), dns records 2 ns, dnskey; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "gu58-{random_name}.{tld}",
        "dns": {
          "@type": "dnsData",
          "records": [
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ns",
              "rdata": {
                "nsdname": "ns1.gn58-{random_name}.net."
              }
            },
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ns",
              "rdata": {
                "nsdname": "ns2.gn58-{random_name}.net."
              }
            },
            {
              "@type": "dnsRecord",
              "name": "@",
              "type": "dnskey",
              "rdata": {
                "flags": "257",
                "protocol": "3",
                "algorithm": "8",
                "publicKey": ""
              }
            }
          ]
        },
        "registrant_id": "{handle:a:R58}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Replaces domain gu58 by a full update with registrant R58, dns records 2 ns; expects one of 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/gu58-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:R58}"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.gn58-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.gn58-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "headers": {
              "RPP-Code": "02005"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "headers": {
              "RPP-Code": "02306"
            },
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ],
  "teardown": [
    {
      "comment": "Deletes domain gu58; expects 200. MTEST keeps what a case creates, so the case deletes it.",
      "include": "delete_domain",
      "with": {
        "name": "gu58-{random_name}.{tld}"
      }
    }
  ]
}
