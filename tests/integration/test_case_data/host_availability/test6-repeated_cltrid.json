{
  "test_id": "test6-repeated_cltrid",
  "steps": [
    {
      "request": {
        "method": "GET",
        "url": "/hosts/t6.{random_name}.net/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "repeated-{random_id_10}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "hostAvailability",
          "available": true
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/hosts/t6.{random_name}.net/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "repeated-{random_id_10}"
        }
      },
      "response": {
        "status": 500,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02400"
        }
      }
    }
  ]
}
