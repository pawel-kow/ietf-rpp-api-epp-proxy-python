{
  "when": {"env.failed_logins_lock": false},
  "test_id": "test5-unknown_user",
  "steps": [
    {
      "request": {
        "method": "GET",
        "url": "/hosts/t5.{random_name}.net/availability",
        "headers": {
          "Authorization": "{auth:unknown_user}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 401,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02200"
        }
      }
    }
  ]
}
