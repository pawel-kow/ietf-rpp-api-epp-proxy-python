{
  "test_id": "test8-name_at_minimum",
  "description": "A name of the fewest characters the server takes (EPP test server 5, RRI 3).",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:Z8}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": {
                "select": [
                  {
                    "when": {
                      "env.limit_contact_name_min_length": 3
                    },
                    "then": "Max"
                  },
                  {
                    "then": "Max M"
                  }
                ]
              }
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact_auth_info": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    }
  ]
}
