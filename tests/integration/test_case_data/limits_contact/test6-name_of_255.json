{
  "test_id": "test6-name_of_255",
  "description": "A name of 255 characters, the most RFC 5733 and RRI hold, is stored whole.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:c6}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann vonx"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact_auth_info": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:c6}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "contactInfo": {
            "name": {
              "full": "Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann vonx"
            }
          }
        }
      }
    }
  ]
}
