{
  "test_id": "test5-all_client_statuses",
  "when": {
    "profile.contact.status.client_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no client statuses of a contact.",
  "description": "A contact holds every client status at once (data-objects §9.5).",
  "setup": [
    {
      "comment": "Creates contact Z5 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:Z5}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact Z5: add /status clientDeleteProhibited; add /status clientTransferProhibited; add /status clientUpdateProhibited; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:Z5}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "contactStatus",
              "label": "clientDeleteProhibited"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "contactStatus",
              "label": "clientTransferProhibited"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "contactStatus",
              "label": "clientUpdateProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {}
      }
    },
    {
      "comment": "Reads contact Z5; expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:Z5}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": [
            {
              "label": "clientDeleteProhibited"
            },
            {
              "label": "clientTransferProhibited"
            },
            {
              "label": "clientUpdateProhibited"
            }
          ]
        }
      }
    }
  ]
}
