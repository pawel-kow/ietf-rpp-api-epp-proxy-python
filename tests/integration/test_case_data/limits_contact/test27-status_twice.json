{
  "test_id": "test27-status_twice",
  "when": {
    "profile.contact.status.client_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI has no client statuses of a contact.",
  "description": "The same client status added twice in one PATCH: the proxy sends the end state, one status.",
  "setup": [
    {
      "comment": "Creates contact M27 with authInfo (by backend); expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:M27}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Patches contact M27: add /status clientDeleteProhibited; add /status clientDeleteProhibited; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/contacts/{handle:a:M27}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "contactStatus",
              "label": "clientDeleteProhibited"
            }
          },
          {
            "op": "add",
            "path": "/status",
            "value": {
              "@type": "contactStatus",
              "label": "clientDeleteProhibited"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:M27}",
          "status": [
            {
              "@type": "contactStatus",
              "label": "clientDeleteProhibited"
            }
          ]
        }
      }
    }
  ]
}
