{
  "test_id": "test2-delete-linked",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:D02}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  }
                ],
                "countryCode": "US"
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            }
          },
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:D02}",
          "status": [
            {
              "@type": "contactStatus",
              "label": "ok"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "test2-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          },
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:D02}"
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "name": "test2-{random_name}.{tld}",
          "status": [
            {
              "@type": "domainStatus",
              "label": "ok"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "url": "/contacts/{handle:a:D02}",
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02305"
        }
      }
    }
  ]
}
