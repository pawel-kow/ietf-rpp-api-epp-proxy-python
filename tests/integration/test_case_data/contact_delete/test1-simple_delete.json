{
  "test_id": "test1-simple_delete",
  "setup": [
    {
      "comment": "Creates contact D01 with authInfo; expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:D01}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes contact D01; expects 200. The operation this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/contacts/{handle:a:D01}",
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    }
  ]
}
