{
  "test_id": "test6-simple_delete_invalid_auth",
  "setup": [
    {
      "comment": "Creates contact D06 with authInfo; expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:D06}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes contact D06 as a user the server does not know, with a fixed RPP-Cltrid; expects 401. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/contacts/{handle:a:D06}",
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "test6-{random_name}-clTRID",
          "Authorization": "{auth:unknown_user}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}"
        }
      },
      "response": {
        "status": 401,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "test6-{random_name}-clTRID"
        }
      }
    }
  ]
}
