{
  "test_id": "test4-request_with_body",
  "setup": [
    {
      "comment": "Creates contact D04 with authInfo; expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:D04}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes contact D04, with a fixed RPP-Cltrid, a raw body that is no valid JSON; expects 400. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/contacts/{handle:a:D04}",
        "body_raw": "test",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "test4-{random_name}-clTRID",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}"
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "test4-{random_name}-clTRID"
        }
      }
    }
  ]
}
