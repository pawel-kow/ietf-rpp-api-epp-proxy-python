{
  "test_id": "test7-simple_delete_no_auth",
  "setup": [
    {
      "comment": "Creates contact D05 with authInfo; expects 201. The contact the steps below work on.",
      "include": "create_contact",
      "with": {
        "id": "{handle:a:D05}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes contact D05 without credentials; expects [401]. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/contacts/{handle:a:D05}",
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": [
          401
        ],
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
