{
  "test_id": "test7-simple_delete_no_auth",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "FO-{random_id_10}D05",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "John Doe"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "locality",
                    "value": "Anytown"
                  }
                ],
                "countryCode": "US"
              }
            },
            "emails": {
              "email": {
                "address": "foo@example.com"
              }
            }
          },
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "headers": {
          "Content-Type": "application/rpp+json",
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "FO-{random_id_10}D05",
          "status": [
            {
              "@type": "contactStatus",
              "label": "ok"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "url": "/contacts/FO-{random_id_10}D05",
        "headers": {
          "Content-Type": "application/rpp+json",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": [
          401
        ],
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
