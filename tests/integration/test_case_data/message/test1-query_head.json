{
  "markers": [
    "smoke"
  ],
  "test_id": "test1-query_head",
  "exclusive": [
    "message_queue"
  ],
  "setup": [
    {
      "comment": "Drains the message queue of registrar a. The queue the first step reads starts empty.",
      "include": "drain_queue",
      "with": {
        "registrar": "a"
      }
    },
    {
      "comment": "Drains the message queue of registrar b. The queue the second step reads starts empty.",
      "include": "drain_queue",
      "with": {
        "registrar": "b"
      }
    }
  ],
  "steps": [
    {
      "comment": "Polls the message queue; expects 200 01300, empty with RPP-Queue-Size 0, where the server queues nothing of its own (message.queue.server_notices), else one of 200 01300 or 200 01301. The operation this case checks.",
      "request": {
        "method": "GET",
        "url": "/messages",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "env.message.queue.server_notices": false
            },
            "then": {
              "status": 200,
              "content_type": "application/rpp+json",
              "body": [],
              "headers": {
                "RPP-Code": "01300",
                "RPP-Queue-Size": "0"
              }
            }
          },
          {
            "then": {
              "any_of": [
                {
                  "status": 200,
                  "content_type": "application/rpp+json",
                  "body": [],
                  "headers": {
                    "RPP-Code": "01300",
                    "RPP-Queue-Size": "0"
                  }
                },
                {
                  "status": 200,
                  "content_type": "application/rpp+json",
                  "body": [
                    {
                      "@type": "message",
                      "status": "queued"
                    }
                  ],
                  "headers": {
                    "RPP-Code": "01301",
                    "RPP-Queue-Size": {
                      "type": "not_null"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "comment": "Polls the message queue (type=transferRequestMessage) as registrar b; expects 200 01300, empty, where the server queues nothing of its own, else one of 200 01300 or 200 01301. The operation this case checks.",
      "request": {
        "method": "GET",
        "url": "/messages?type=transferRequestMessage",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "env.message.queue.server_notices": false
            },
            "then": {
              "status": 200,
              "content_type": "application/rpp+json",
              "body": [],
              "headers": {
                "RPP-Code": "01300",
                "RPP-Queue-Size": "0"
              }
            }
          },
          {
            "then": {
              "any_of": [
                {
                  "status": 200,
                  "content_type": "application/rpp+json",
                  "body": [],
                  "headers": {
                    "RPP-Code": "01300",
                    "RPP-Queue-Size": "0"
                  }
                },
                {
                  "status": 200,
                  "content_type": "application/rpp+json",
                  "body": [
                    {
                      "@type": "message",
                      "status": "queued"
                    }
                  ],
                  "headers": {
                    "RPP-Code": "01301",
                    "RPP-Queue-Size": {
                      "type": "not_null"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
