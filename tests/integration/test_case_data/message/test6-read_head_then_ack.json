{
  "when": {
    "profile.domainName.processes.transfer.operations": {
      "contains": "request"
    }
  },
  "comment": "Skipped where a domain cannot be transferred. On RRI the transfer is CHPROV with the de.denic.rpp.rri extension (#190): its steps say where they run.",
  "test_id": "test6-read_head_then_ack",
  "exclusive": [
    "message_queue"
  ],
  "setup": [
    {
      "comment": "Drains the message queue of registrar a. The queue the steps below read holds only what the case and the server cause.",
      "include": "drain_queue",
      "with": {
        "registrar": "a"
      }
    },
    {
      "comment": "Creates contact HM6; expects 201. The registrant of the domain below. Only where a domain needs a registrant.",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:HM6}"
      }
    },
    {
      "comment": "Creates request contact GM6 with uriTemplate; expects 201 01000. The General Request contact of the domain below. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:GM6}"
      }
    },
    {
      "comment": "Creates request contact AM6 with uriTemplate; expects 201 01000. The Abuse contact of the domain below. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "include": "create_request_contact",
      "with": {
        "id": "{handle:a:AM6}"
      }
    },
    {
      "comment": "Creates domain ms6 with authInfo, registrant HM6, dns records a, and on RRI its request contacts GM6 and AM6 (all by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "ms6-{random_name}.{tld}",
        "abuse": {
          "select": [
            {
              "when": {
                "profile.extensions": {
                  "contains": "de.denic.rpp.rri"
                }
              },
              "then": {
                "@type": "requestContact",
                "id": "{handle:a:AM6}"
              }
            },
            {
              "omit": true
            }
          ]
        },
        "generalRequest": {
          "select": [
            {
              "when": {
                "profile.extensions": {
                  "contains": "de.denic.rpp.rri"
                }
              },
              "then": {
                "@type": "requestContact",
                "id": "{handle:a:GM6}"
              }
            },
            {
              "omit": true
            }
          ]
        },
        "registrant_id": "{handle:a:HM6}"
      }
    },
    {
      "comment": "Creates contact HM6 of registrar b as registrar b; expects 201 01000. The registrant the transfer below gives the domain. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "include": "create_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:HM6}"
      }
    },
    {
      "comment": "Creates request contact GM6 of registrar b as registrar b; expects 201 01000. The General Request contact the transfer below gives the domain. Only on RRI, whose transfer carries the domain data.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "include": "create_request_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:GM6}"
      }
    },
    {
      "comment": "Creates request contact AM6 of registrar b as registrar b; expects 201 01000. The Abuse contact the transfer below gives the domain. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "include": "create_request_contact",
      "with": {
        "registrar": "b",
        "id": "{handle:b:AM6}"
      }
    },
    {
      "comment": "Requests a transfer of domain ms6 as registrar b; expects 201 01001, a pending transfer, which queues a message for registrar a. The message the steps below read and acknowledge. Only where the transfer is EPP's.",
      "when": {
        "profile.extensions": {
          "not": {
            "contains": "de.denic.rpp.rri"
          }
        }
      },
      "request": {
        "method": "POST",
        "url": "/domainNames/ms6-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=QWJjMjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "pull"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainTransferProcess",
          "trStatus": "pending"
        },
        "headers": {
          "RPP-Code": "01001"
        }
      },
      "with": {}
    },
    {
      "comment": "Transfers domain ms6 by CHPROV with registrant, generalRequest, abuse, dns as registrar b; expects 200 01000, serverApproved at once. A message for registrar a, the losing registrar, for the steps below; the shared MTEST queue holds older ones too. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "request": {
        "method": "POST",
        "url": "/domainNames/ms6-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Authorization": "authinfo value=QWJjMjM0NTY3OA=="
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "transferDir": "pull",
          "registrant": {
            "@type": "contact",
            "id": "{handle:b:HM6}"
          },
          "generalRequest": {
            "@type": "requestContact",
            "id": "{handle:b:GM6}"
          },
          "abuse": {
            "@type": "requestContact",
            "id": "{handle:b:AM6}"
          },
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.10"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "domainTransferProcess",
          "transferDir": "pull",
          "trStatus": "serverApproved",
          "reqClientId": "{regacc:b}",
          "actClientId": "{regacc:b}"
        },
        "fields": {
          "requestDate": {
            "type": "not_null"
          },
          "actionDate": {
            "type": "not_null"
          }
        }
      },
      "with": {}
    }
  ],
  "steps": [
    {
      "comment": "Acknowledges every message at the head of the queue of registrar a that is not the one of the transfer above, until that one is the head. Where the server queues messages of its own (DENIC's notices), they come first.",
      "loop": [
        {
          "comment": "Polls the message queue; expects 200 01301 with a message at the head, which ends the loop when it is the message of the transfer above.",
          "request": {
            "method": "GET",
            "url": "/messages",
            "headers": {
              "Authorization": "{auth:a}",
              "Accept": "{rpp:accept}",
              "RPP-Preset": "{rpp:preset}",
              "Content-Type": "{rpp:content-type}",
              "RPP-Cltrid": "{unique_cltrid}"
            }
          },
          "response": {
            "status": 200,
            "content_type": "application/rpp+json",
            "body": [
              {
                "@type": "message"
              }
            ],
            "headers": {
              "RPP-Code": "01301"
            }
          },
          "until": {
            "body": {
              "select": [
                {
                  "when": {
                    "profile.extensions": {
                      "contains": "de.denic.rpp.rri"
                    }
                  },
                  "then": [
                    {
                      "@type": "message",
                      "data": {
                        "@type": "transferOutcomeMessage",
                        "objectId": "ms6-{random_name}.{tld}",
                        "trStatus": "serverApproved"
                      }
                    }
                  ]
                },
                {
                  "then": [
                    {
                      "@type": "message",
                      "data": {
                        "@type": "transferRequestMessage",
                        "objectId": "ms6-{random_name}.{tld}"
                      }
                    }
                  ]
                }
              ]
            }
          },
          "capture": {
            "foreign": "0.id"
          }
        },
        {
          "comment": "Acknowledges the message at the head, one the case did not cause; expects 200 01000.",
          "request": {
            "method": "DELETE",
            "url": "/messages/{capture:foreign}",
            "headers": {
              "Authorization": "{auth:a}",
              "Accept": "{rpp:accept}",
              "RPP-Preset": "{rpp:preset}",
              "Content-Type": "{rpp:content-type}",
              "RPP-Cltrid": "{unique_cltrid}"
            }
          },
          "response": {
            "status": 200,
            "headers": {
              "RPP-Code": "01000"
            }
          }
        }
      ]
    },
    {
      "comment": "Polls the message queue; expects 200 01301 with the message of the transfer above at the head: on RRI the chprovAuthInfo notice of the domain, a transferOutcomeMessage, else the transfer request; RPP-Queue-Size 1 where the server queues nothing of its own (message.queue.server_notices). The operation this case checks. Keeps head for later steps.",
      "request": {
        "method": "GET",
        "url": "/messages",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "select": [
            {
              "when": {
                "profile.extensions": {
                  "contains": "de.denic.rpp.rri"
                }
              },
              "then": [
                {
                  "@type": "message",
                  "status": "queued",
                  "data": {
                    "@type": "transferOutcomeMessage",
                    "objectType": "domainName",
                    "objectId": "ms6-{random_name}.{tld}",
                    "trStatus": "serverApproved",
                    "process": {
                      "@type": "domainTransferProcess",
                      "trStatus": "serverApproved",
                      "reqClientId": "{regacc:b}",
                      "actClientId": "{regacc:b}"
                    }
                  }
                }
              ]
            },
            {
              "then": [
                {
                  "@type": "message",
                  "status": "queued",
                  "data": {
                    "@type": "transferRequestMessage",
                    "objectType": "domainName",
                    "objectId": "ms6-{random_name}.{tld}",
                    "status": "pending",
                    "process": {
                      "@type": "domainTransferProcess",
                      "trStatus": "pending",
                      "transferDir": "pull",
                      "reqClientId": "{regacc:b}",
                      "actClientId": "{regacc:a}"
                    }
                  }
                }
              ]
            }
          ]
        },
        "fields": {
          "0.id": {
            "type": "not_empty_string"
          }
        },
        "headers": {
          "RPP-Code": "01301",
          "RPP-Queue-Size": {
            "select": [
              {
                "when": {
                  "env.message.queue.server_notices": false
                },
                "then": "1"
              },
              {
                "then": {
                  "type": "not_null"
                }
              }
            ]
          }
        }
      },
      "capture": {
        "head": "0.id"
      }
    },
    {
      "comment": "Polls the message queue (type=transferOutcomeMessage); expects 200 01301 with the transfer outcome of the domain above, RPP-Queue-Size 1 where the server queues nothing of its own (message.queue.server_notices): the type selects it by its RRI msgType. Only on RRI, the other backends ignore the type.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "request": {
        "method": "GET",
        "url": "/messages?type=transferOutcomeMessage",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": [
          {
            "@type": "message",
            "status": "queued",
            "data": {
              "@type": "transferOutcomeMessage",
              "objectType": "domainName",
              "objectId": "ms6-{random_name}.{tld}",
              "trStatus": "serverApproved"
            }
          }
        ],
        "fields": {
          "0.id": {
            "type": "not_empty_string"
          }
        },
        "headers": {
          "RPP-Code": "01301",
          "RPP-Queue-Size": {
            "select": [
              {
                "when": {
                  "env.message.queue.server_notices": false
                },
                "then": "1"
              },
              {
                "then": {
                  "type": "not_null"
                }
              }
            ]
          }
        }
      }
    },
    {
      "comment": "Acknowledges message the captured head; expects 200 01000, with RPP-Queue-Size, except where the proxy does not state it (bugs.queue_del_no_msgcnt, #172). The operation this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/messages/{capture:head}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Queue-Size": {
            "select": [
              {
                "when": {
                  "env.bugs.queue_del_no_msgcnt": false
                },
                "then": {
                  "type": "not_null"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "Content-Type": null
        }
      }
    },
    {
      "comment": "Acknowledges message the captured head; expects 404 02303. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/messages/{capture:head}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02303"
        }
      }
    }
  ],
  "teardown": [
    {
      "comment": "Cancels the transfer of domain ms6 as registrar b, the requester; expects 200 01000. A transfer left pending is approved by the server minutes later, which queues messages after the case released the queue mutex. Only where the transfer is EPP's.",
      "when": {
        "profile.extensions": {
          "not": {
            "contains": "de.denic.rpp.rri"
          }
        }
      },
      "include": "cancel_transfer",
      "with": {
        "collection": "domainNames",
        "id": "ms6-{random_name}.{tld}"
      }
    },
    {
      "comment": "Deletes domain ms6 as registrar b, its sponsor after the transfer; expects 200. MTEST keeps what a case creates, so the case deletes it. Only on RRI.",
      "when": {
        "profile.extensions": {
          "contains": "de.denic.rpp.rri"
        }
      },
      "include": "delete_domain",
      "with": {
        "name": "ms6-{random_name}.{tld}",
        "registrar": "b"
      }
    }
  ]
}
