{
  "test_id": "test5-read_active_domain_has_no_restore",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "domainName",
          "name": "rs5-{random_name}.example",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/domainNames/rs5-{random_name}.example/processes/restoreProcesses/latest",
        "headers": {
          "Authorization": "Basic Zm9vOmJhcg==",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02303",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
