{
  "when": {
    "wait.domainName.processes.create.add_grace_period": true,
    "wait.domainName.processes.restore.pending_period": true,
    "profile.domainName.processes.restore.report_supported": true
  },
  "comment": "Skipped on rri-mtest: it waits for domainName.processes.restore.pending_period, and the server has no such transition; RRI's RESTORE is one step, without a restore report.",
  "test_id": "test13-pending_restore_without_report_ends",
  "description": "A restore request without a report holds the domain in pendingRestore; while it lasts a second request is refused, after it the domain is back in its redemption period and can be requested again (RFC 3915 §3.2).",
  "setup": [
    {
      "comment": "Creates contact RS13; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:RS13}"
      }
    },
    {
      "comment": "Creates domain rs13 with authInfo, registrant RS13 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "rs13-{random_name}.{tld}",
        "registrant_id": "{handle:a:RS13}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes domain rs13; expects 200. The operation this case checks. Waits first for domainName.processes.create.add_grace_period.",
      "wait": "domainName.processes.create.add_grace_period",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/rs13-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    },
    {
      "comment": "Requests a restore of domain rs13; expects 200. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/rs13-{random_name}.{tld}/processes/restoreProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "restoreProcess",
          "restoreStatus": "pendingRestore"
        }
      }
    },
    {
      "comment": "Requests a restore of domain rs13; expects 409 02304. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/rs13-{random_name}.{tld}/processes/restoreProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02304"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Requests a restore of domain rs13; expects 200. The operation this case checks. Waits first for domainName.processes.restore.pending_period.",
      "wait": "domainName.processes.restore.pending_period",
      "request": {
        "method": "POST",
        "url": "/domainNames/rs13-{random_name}.{tld}/processes/restoreProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "restoreProcess",
          "restoreStatus": "pendingRestore"
        }
      }
    }
  ]
}
