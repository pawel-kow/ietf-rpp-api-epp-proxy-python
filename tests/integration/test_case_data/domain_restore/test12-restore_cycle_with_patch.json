{
  "when": {
    "wait.domainName.processes.create.add_grace_period": true,
    "profile.domainName.processes.restore.report_supported": true
  },
  "comment": "Skipped on rri-mtest: RRI's RESTORE is one step, without a restore report.",
  "test_id": "test12-restore_cycle_with_patch",
  "setup": [
    {
      "comment": "Creates domain rs12 with authInfo; expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "rs12-{random_name}.{tld}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Deletes domain rs12; expects 200. The operation this case checks. Waits first for domainName.processes.create.add_grace_period.",
      "wait": "domainName.processes.create.add_grace_period",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/rs12-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    },
    {
      "comment": "Reads the restore process of domain rs12; expects 404 02303. An error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/domainNames/rs12-{random_name}.{tld}/processes/restoreProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02303"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Sends a restore report for domain rs12; expects 409 02304. An error answer this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/rs12-{random_name}.{tld}/processes/restoreProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess",
          "restoreReport": {
            "@type": "restoreReport",
            "preData": "Pre-delete registration data.",
            "postData": "Post-restore registration data.",
            "deleteTime": "2026-01-10T12:00:00.0Z",
            "restoreTime": "2026-01-20T15:30:00.0Z",
            "restoreReason": "Domain deleted in error by client operator.",
            "statements": [
              "The information in this report is true to the best of my knowledge.",
              "I have a valid reason for restoring this domain name."
            ]
          }
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02304"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Requests a restore of domain rs12; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/rs12-{random_name}.{tld}/processes/restoreProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "restoreProcess",
          "restoreStatus": "pendingRestore"
        }
      }
    },
    {
      "comment": "Requests a restore of domain rs12; expects 409 02304. An error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/rs12-{random_name}.{tld}/processes/restoreProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02304"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Reads the restore process of domain rs12; expects 200 01000. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/rs12-{random_name}.{tld}/processes/restoreProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "restoreProcess",
          "restoreStatus": "pendingRestore"
        }
      }
    },
    {
      "comment": "Sends a restore report for domain rs12 by PATCH; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/rs12-{random_name}.{tld}/processes/restoreProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/restoreReport",
            "value": {
              "@type": "restoreReport",
              "preData": "Pre-delete registration data.",
              "postData": "Post-restore registration data.",
              "deleteTime": "2026-01-10T12:00:00.0Z",
              "restoreTime": "2026-01-20T15:30:00.0Z",
              "restoreReason": "Domain deleted in error by client operator.",
              "statements": [
                "The information in this report is true to the best of my knowledge.",
                "I have a valid reason for restoring this domain name."
              ]
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "restoreProcess",
          "restoreStatus": "restored"
        }
      }
    },
    {
      "comment": "Reads the restore process of domain rs12; expects 404 02303. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/domainNames/rs12-{random_name}.{tld}/processes/restoreProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02303"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Reads domain rs12; expects 200 01000. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/rs12-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "domainName",
          "status": [
            {
              "@type": "domainStatus",
              "label": "ok"
            }
          ]
        }
      }
    }
  ]
}
