{
  "test_id": "test1-restore_on_active_domain",
  "description": "A restore of a domain that is not deleted is refused (RFC 3915 §3.2): the request on every backend, the report by PUT and by PATCH where the restore takes one (RRI's RESTORE is one step, without a report).",
  "setup": [
    {
      "comment": "Creates contact RS1; expects 201. The registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "include": "create_contact",
      "with": {
        "id": "{handle:a:RS1}"
      }
    },
    {
      "comment": "Creates domain rs1 with authInfo, registrant RS1 (by backend), dns records a (by backend); expects 201. The domain the steps below work on.",
      "include": "create_domain",
      "with": {
        "name": "rs1-{random_name}.{tld}",
        "registrant_id": "{handle:a:RS1}"
      }
    }
  ],
  "steps": [
    {
      "comment": "Requests a restore of domain rs1; expects 409 02304. An error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/rs1-{random_name}.{tld}/processes/restoreProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess"
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02304",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Sends a restore report for domain rs1; expects 409 02304. An error answer this case checks. Only where a restore takes a report (epp-docker).",
      "when": {
        "profile.domainName.processes.restore.report_supported": true
      },
      "request": {
        "method": "PUT",
        "url": "/domainNames/rs1-{random_name}.{tld}/processes/restoreProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess",
          "restoreReport": {
            "@type": "restoreReport",
            "preData": "Pre-delete registration data.",
            "postData": "Post-restore registration data.",
            "deleteTime": "2026-01-10T12:00:00.0Z",
            "restoreTime": "2026-01-20T15:30:00.0Z",
            "restoreReason": "Domain deleted in error by client operator.",
            "statements": [
              "The information in this report is true to the best of my knowledge.",
              "I have a valid reason for restoring this domain name."
            ]
          }
        }
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02304",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Sends a restore report for domain rs1 by PATCH; expects 409 02304. The error answer this case checks. Only where a restore takes a report (epp-docker).",
      "when": {
        "profile.domainName.processes.restore.report_supported": true
      },
      "request": {
        "method": "PATCH",
        "url": "/domainNames/rs1-{random_name}.{tld}/processes/restoreProcesses/latest",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/restoreReport",
            "value": {
              "@type": "restoreReport",
              "preData": "Pre-delete registration data.",
              "postData": "Post-restore registration data.",
              "deleteTime": "2026-01-10T12:00:00.0Z",
              "restoreTime": "2026-01-20T15:30:00.0Z",
              "restoreReason": "Domain deleted in error by client operator.",
              "statements": [
                "The information in this report is true to the best of my knowledge.",
                "I have a valid reason for restoring this domain name."
              ]
            }
          }
        ]
      },
      "response": {
        "status": 409,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02304",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
