{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pawel-kow/ietf-rpp-api-epp-proxy-python/blob/main/.spec/authinfo-extension.schema.json",
  "title": "RPP Authorisation Information extension",
  "description": "Process Objects that set authorisation information with an expiry date and ask the server to issue authorisation information to the registrants, and the message types about them. See docs/extensions/authinfo-extension.md.",
  "rpp:extension": {
    "name": "RPP Authorisation Information",
    "id": "io.github.pawel-kow.rpp.authinfo",
    "version": "0.1.0",
    "objects": []
  },
  "rpp:extends": {
    "#/$defs/processes.read": "#/$defs/ext.authinfo.processes.read"
  },
  "rpp:messages": {
    "authInfoExpiryMessage": "#/$defs/ext.authinfo.authInfoExpiryMessage.read",
    "authInfoIssueMessage": "#/$defs/ext.authinfo.authInfoIssueMessage.read",
    "authInfoWithdrawalMessage": "#/$defs/ext.authinfo.authInfoWithdrawalMessage.read"
  },
  "$defs": {
    "ext.authinfo.processes.read": {
      "type": "object",
      "properties": {
        "authInfoProcess": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ext.authinfo.authInfoProcess.reference"
          },
          "readOnly": true
        },
        "authInfoIssueProcess": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ext.authinfo.authInfoIssueProcess.reference"
          },
          "readOnly": true
        }
      }
    },
    "ext.authinfo.authInfoProcess.create": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "authInfoProcess"
        },
        "authInfo": {
          "$ref": "#/$defs/authInfo.create",
          "writeOnly": true
        },
        "expiryDate": {
          "type": "string",
          "format": "date",
          "writeOnly": true
        }
      },
      "required": [
        "@type",
        "authInfo"
      ]
    },
    "ext.authinfo.authInfoProcess.read": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "authInfoProcess",
          "readOnly": true
        },
        "processId": {
          "type": "string",
          "readOnly": true
        },
        "expiryDate": {
          "type": "string",
          "format": "date",
          "readOnly": true
        }
      },
      "required": [
        "@type"
      ]
    },
    "ext.authinfo.authInfoProcess.reference": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "authInfoProcess"
        },
        "processId": {
          "type": "string",
          "readOnly": true
        }
      },
      "required": [
        "@type",
        "processId"
      ]
    },
    "ext.authinfo.authInfoIssueProcess.create": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "authInfoIssueProcess"
        }
      },
      "required": [
        "@type"
      ]
    },
    "ext.authinfo.authInfoIssueProcess.read": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "authInfoIssueProcess",
          "readOnly": true
        },
        "processId": {
          "type": "string",
          "readOnly": true
        }
      },
      "required": [
        "@type"
      ]
    },
    "ext.authinfo.authInfoIssueProcess.reference": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "authInfoIssueProcess"
        },
        "processId": {
          "type": "string",
          "readOnly": true
        }
      },
      "required": [
        "@type",
        "processId"
      ]
    },
    "ext.authinfo.authInfoExpiryMessage.read": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "authInfoExpiryMessage",
          "readOnly": true
        },
        "objectType": {
          "type": "string",
          "const": "domainName",
          "readOnly": true
        },
        "objectId": {
          "type": "string",
          "readOnly": true
        },
        "expiryDate": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        }
      },
      "required": [
        "@type",
        "objectType",
        "objectId",
        "expiryDate"
      ]
    },
    "ext.authinfo.authInfoIssueMessage.read": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "authInfoIssueMessage",
          "readOnly": true
        },
        "objectType": {
          "type": "string",
          "const": "domainName",
          "readOnly": true
        },
        "objectId": {
          "type": "string",
          "readOnly": true
        }
      },
      "required": [
        "@type",
        "objectType",
        "objectId"
      ]
    },
    "ext.authinfo.authInfoWithdrawalMessage.read": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "authInfoWithdrawalMessage",
          "readOnly": true
        },
        "objectType": {
          "type": "string",
          "const": "domainName",
          "readOnly": true
        },
        "objectId": {
          "type": "string",
          "readOnly": true
        },
        "notices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ext.messages.registryNotice.read"
          },
          "readOnly": true
        }
      },
      "required": [
        "@type",
        "objectType",
        "objectId",
        "notices"
      ]
    }
  }
}
