{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pawel-kow/ietf-rpp-api-epp-proxy-python/blob/main/.spec/messages-extension.schema.json",
  "title": "RPP Message Components extension",
  "description": "Component Objects for the message types of other extensions. See docs/extensions/messages-extension.md.",
  "rpp:extension": {
    "name": "RPP Message Components",
    "id": "io.github.pawel-kow.rpp.messages",
    "version": "0.1.0",
    "objects": []
  },
  "rpp:extends": {},
  "$defs": {
    "ext.messages.objectReference.read": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "objectReference",
          "readOnly": true
        },
        "objectType": {
          "type": "string",
          "readOnly": true
        },
        "objectId": {
          "type": "string",
          "readOnly": true
        }
      },
      "required": [
        "@type",
        "objectType",
        "objectId"
      ]
    },
    "ext.messages.datedObjectReference.read": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "datedObjectReference",
          "readOnly": true
        },
        "objectType": {
          "type": "string",
          "readOnly": true
        },
        "objectId": {
          "type": "string",
          "readOnly": true
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        }
      },
      "required": [
        "@type",
        "objectType",
        "objectId",
        "date"
      ]
    },
    "ext.messages.registryNotice.read": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "registryNotice",
          "readOnly": true
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "readOnly": true
        },
        "text": {
          "type": "string",
          "readOnly": true
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true
        }
      },
      "required": [
        "@type",
        "code",
        "text"
      ]
    },
    "ext.messages.bulkBaseMessage.read": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "bulkBaseMessage",
          "readOnly": true
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ext.messages.objectReference.read"
          },
          "readOnly": true
        }
      },
      "required": [
        "@type",
        "objects"
      ]
    }
  }
}
