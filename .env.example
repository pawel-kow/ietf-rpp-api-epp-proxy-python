# Credentials of the test environments (tests/integration/environments/*.yaml), read by the integration runner only.
# Copy to .env and fill in. Never commit .env.

# epp-docker: the two registrars of the EPP test server, and the prefix each requires of its contact ids
TEST_EPP_REGACC1=
TEST_EPP_REGACC1_PREFIX=
TEST_EPP_REGACC1_PASSWORD=
TEST_EPP_REGACC2=
TEST_EPP_REGACC2_PREFIX=
TEST_EPP_REGACC2_PASSWORD=

# rri-mtest: the RRI logins of two RegAccs on DENIC MTEST, the prefix of the handles the cases create (it starts
# with the RegAccId), and a pre-created REQUEST contact of each RegAcc for the General Request and Abuse roles
TEST_RRI_REGACC1=
TEST_RRI_REGACC1_PREFIX=
TEST_RRI_REGACC1_PASSWORD=
TEST_RRI_REGACC1_GEN_REQ=
TEST_RRI_REGACC1_ABUSE=
TEST_RRI_REGACC2=
TEST_RRI_REGACC2_PREFIX=
TEST_RRI_REGACC2_PASSWORD=
TEST_RRI_REGACC2_GEN_REQ=
TEST_RRI_REGACC2_ABUSE=
