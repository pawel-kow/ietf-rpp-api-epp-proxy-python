{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "DomainUpdateModel.json",
    "type": "object",
    "properties": {},
    "allOf": [
        {
            "$ref": "#/$defs/UpdateModelDomainUpdateAddDomainUpdateRemoveDomainUpdateChange"
        }
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "$defs": {
        "UpdateModelDomainUpdateAddDomainUpdateRemoveDomainUpdateChange": {
            "type": "object",
            "properties": {
                "add": {
                    "$ref": "#/$defs/DomainUpdateAdd"
                },
                "remove": {
                    "$ref": "#/$defs/DomainUpdateRemove"
                },
                "update": {
                    "$ref": "#/$defs/DomainUpdateChange"
                }
            }
        },
        "DomainUpdateAdd": {
            "type": "object",
            "properties": {
                "ns": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/DomainEPPHostAttr"
                        },
                        {
                            "$ref": "#/$defs/DomainHostObj"
                        }
                    ]
                },
                "contacts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ContactReference"
                    },
                    "description": "An array of contacts to be added to the domain."
                },
                "dnsSEC": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/DnsSec"
                    },
                    "description": "An array of DNSSEC data to be added to the domain."
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "DomainUpdateRemove": {
            "type": "object",
            "properties": {
                "ns": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/DomainEPPHostAttr"
                        },
                        {
                            "$ref": "#/$defs/DomainHostObj"
                        }
                    ]
                },
                "contacts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ContactReference"
                    },
                    "description": "An array of contacts to be removed from the domain."
                },
                "dnsSEC": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/DnsSec"
                    },
                    "description": "An array of DNSSEC data to be removed from the domain."
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "DomainUpdateChange": {
            "type": "object",
            "properties": {
                "authInfo": {
                    "$ref": "#/$defs/AuthInfo"
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "DomainEPPHostAttr": {
            "type": "object",
            "properties": {
                "hostAttr": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/EPPHost"
                    }
                }
            },
            "required": [
                "hostAttr"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "EPP-stype hostAttr"
        },
        "DomainHostObj": {
            "type": "object",
            "properties": {
                "hostObj": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/HostName"
                    },
                    "description": "Host object described in EPP-style (rpp.host.EPPHost)."
                }
            },
            "required": [
                "hostObj"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ContactReference": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "string",
                    "description": "The unique identifier for the contact, typically a handle or ID."
                },
                "type": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ContactType"
                    },
                    "description": "An array of roles that the contact fulfills for the domain."
                }
            },
            "required": [
                "value",
                "type"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Represents a reference to a contact, specifying its identifier and roles."
        },
        "DnsSec": {
            "type": "object",
            "properties": {
                "keyTag": {
                    "type": "string",
                    "description": "The key tag value of the DS record, as specified in RFC 4034."
                },
                "algorithm": {
                    "type": "string",
                    "description": "The algorithm used to create the DS record, as specified in RFC 4034."
                },
                "digestType": {
                    "type": "string",
                    "description": "The digest type of the DS record, as specified in RFC 4034."
                },
                "digest": {
                    "type": "string",
                    "description": "The digest value of the DS record in hexadecimal format."
                }
            },
            "required": [
                "keyTag",
                "algorithm",
                "digestType",
                "digest"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Represents the DNSSEC data for a domain, used to secure DNS lookups."
        },
        "AuthInfo": {
            "type": "object",
            "properties": {
                "pw": {
                    "type": "string"
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "EPPHost": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "addr": {
                    "type": "object",
                    "properties": {
                        "ipv4": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "ipv6": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "unevaluatedProperties": {
                        "not": {}
                    }
                }
            },
            "required": [
                "name"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Host object described either EPP-style (rpp.host.EPPHost)."
        },
        "HostName": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "name"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ContactType": {
            "type": "string",
            "enum": [
                "registrant",
                "admin",
                "tech",
                "billing"
            ],
            "description": "Enumeration of contact types for a domain registration."
        }
    }
}