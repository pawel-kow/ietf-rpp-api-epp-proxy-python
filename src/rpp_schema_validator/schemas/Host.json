{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Host.json",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "addr": {
            "type": "object",
            "properties": {
                "ipv4": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "ipv6": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "status": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "upDate": {
            "type": "string"
        },
        "trDate": {
            "type": "string"
        },
        "clID": {
            "type": "string"
        },
        "crID": {
            "type": "string"
        },
        "crDate": {
            "type": "string"
        },
        "exDate": {
            "type": "string"
        }
    },
    "required": [
        "name"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Host object described either EPP-style (rpp.host.EPPHost)."
}