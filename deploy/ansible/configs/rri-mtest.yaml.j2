# {{ ansible_managed }}
# The configuration of instance {{ instance.name }}, made from config/environments/rri-mtest.yaml of the repository.
# The proxy in front of DENIC's RRI test environment (MTEST). The credentials are the clients' own: HTTP Basic is passed
# through as the RRI LOGIN, so the deployment holds none. MTEST admits the host's address only once DENIC has it on the
# allowlist of the RegAcc.
rpp_backend: rri
rpp_rri_host: rri.test.denic.de
rpp_rri_port: 51131
rpp_rri_use_tls: true
rpp_rri_tls_insecure_skip_verify: false
# How a client names the preset of a request (core, Preset Signalling): `header` is the RPP-Preset header field,
# `media-type` the preset and preset-version parameters of Accept and Content-Type. Without the key it is `header`. A
# request that names none gets default_preset below.
rpp_preset_signalling: media-type

# The RRI extension (docs/rri/rri-extension.md): request contacts, and the transfer with the gainer's data. It adds itself,
# its leaves and its preset to the profile.
rpp_extensions:
  - extensions.rri

# The profile of this server (see config/backends/epp.yaml): DENIC's, src/settings/profiles/rri.yaml.
rpp_backend_profile:
  extends: rri
  # The RPP presets offered (src/rpp/schema/schemas/presets, and the extension's), and the one a request gets when it names none.
  presets:
    - base
    - rri
  default_preset: rri
rpp_rri_lgr: latn-1.0   # the one LGR name a client may give for DENIC's IDN repertoire (gap Q11)

# What the discovery document states.
rpp_base_url: {{ instance.base_url }}
rpp_tlds: {{ instance.tlds | default(['de']) | to_json }}
rpp_environment_name: {{ instance.environment_name | default(instance.base_url | urlsplit('hostname')) }}
rpp_environment_status: {{ instance.environment_status | default('test') }}
